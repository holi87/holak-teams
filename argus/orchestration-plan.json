{
  "$schema": "argus/orchestration-plan@2",
  "schemaVersion": 2,
  "capabilityMatrix": "capabilities/capability-matrix.json",
  "raci": "references/raci.json",
  "dependencyPolicy": "selected-dispatchable-predecessors",
  "modeCounts": {
    "A": 27,
    "B": 16,
    "C": 15,
    "D": 15
  },
  "deepHunt": {
    "modes": ["A", "B"],
    "tier": "frontier",
    "maxPasses": 3,
    "continueWhen": "new-confirmed-defects",
    "roles": ["antigone", "ariadne", "atalanta", "charon", "hermes", "lynceus", "orion", "perseus", "proteus", "tiresias", "tyche"],
    "brief": [
      "conformance RED rows without a disposition",
      "open contract-drift rows",
      "open risk-register rows",
      "the hottest defect clusters from the first triage pass",
      "every technique-catalog row still marked gap after the first pass, invariant classes before contract rows",
      "every documented business rule whose consumer edge is reachable but whose producer was called unreachable",
      "every suspected defect routed to its filing lane, with the exact missing proof items Minos recorded",
      "every bounced candidate still unresolved after the proof-repair rounds, with its repair.missing list",
      "every open WHITEBOX-LEADS row owned by this lane and every Tiresias TIR lead routed to this lane surface",
      "every quarantined defect whose evidence must be re-collected under a fresh arranged state",
      "sibling variants of every defect confirmed in the previous pass: the same root-cause pattern on neighbouring operations, screens, roles, states, and data shapes",
      "every technique-catalog row reported executed without a described arranged precondition in the previous pass"
    ]
  },
  "huntingBrief": [
    "every Tiresias TIR lead and source candidate whose owning lane or surface route is this lane",
    "every Metis RISK row and ORC oracle mapped to this lane surface, highest priority first",
    "every Kalchas contract-drift row on this lane surface",
    "Penelope, Theseus, and Pistis baseline paths and Atlas helpers are consumed when present and are never a precondition for starting"
  ],
  "proofLoop": {
    "validator": "minos",
    "oracleDesk": "metis",
    "maxRepairRounds": 2,
    "validatorPasses": {
      "order": "clusters-then-consolidator",
      "clusters": [
        { "id": "api-data", "lanes": ["atalanta", "charon", "pistis", "proteus", "talos", "theseus"] },
        { "id": "security-source", "lanes": ["perseus", "tiresias"] },
        { "id": "ui-journey", "lanes": ["antigone", "ariadne", "daidalos", "lynceus", "orion", "penelope"] },
        { "id": "nonfunctional-suite", "lanes": ["asklepios", "hermes", "tyche"] }
      ]
    },
    "routes": [
      { "status": "bounced", "to": "filing-lane", "carries": "repair.missing" },
      { "status": "needs-oracle", "to": "oracle-desk", "carries": "behaviour, evidence, candidate readings" },
      { "status": "quarantined", "to": "filing-lane", "carries": "quarantine.reasons" },
      { "status": "suspected", "to": "independent-reproducer", "carries": "steps and oracle" },
      { "status": "confirmed", "to": "independent-reproducer", "carries": "steps and oracle", "when": "severity Blocker or Critical, or disputedOracle" }
    ],
    "independentReproduction": {
      "candidates": "raci.surfaceRoutes[].reproduce",
      "selection": "first selected dispatchable candidate for the manifestation surface that is not the finder, an origin lane, or the collector of original reproduction evidence",
      "freshState": "new synthetic accounts and data under the reproducer namespace and a new browser context; the initial state is recorded before the first step",
      "unavailable": "no eligible candidate means independent.status=unavailable with its reason, never a claim of independent verification"
    },
    "acceptedOracleKinds": ["requirement", "contract", "justified-invariant"],
    "justifiedInvariantClasses": ["server-error", "crash", "data-loss", "authz-breach", "layer-disagreement"],
    "exhaustion": "After maxRepairRounds a finding keeps its non-confirmed status and is a named residual in the ledger header and final report; it is never dropped."
  },
  "mandatoryLanes": {
    "policy": "gates-satisfied-means-dispatched",
    "modes": ["A", "B"],
    "roles": ["antigone", "ariadne", "atalanta", "charon", "hermes", "lynceus", "orion", "perseus", "proteus", "tiresias", "tyche"],
    "rule": [
      "A hunter whose capability gates are satisfied is dispatched and returns its technique-coverage table. Time pressure is not a disposition.",
      "A lane may be omitted only when a gate is unmet, and the unmet gate is recorded in coverage-result.json as the reason.",
      "A dispatched lane that produced no artifact is a coverage failure, not an empty result: Kleio reports it and the run verdict cannot be PARTIAL-WITH-NAMED-GAPS on that basis alone.",
      "A brief given to a lane is additive. It may set order and add targets; it may never remove a catalog row from that lane's obligation."
    ]
  },
  "waves": [
    { "id": "W0", "barrierAfter": true },
    { "id": "W1", "barrierAfter": true },
    { "id": "W2", "barrierAfter": true },
    { "id": "W3", "barrierAfter": true },
