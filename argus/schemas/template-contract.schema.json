{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holi87/holak-teams/argus/schemas/template-contract.schema.json",
  "title": "Argus shared template contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "runner", "tags", "retryPolicy", "quarantine", "lanePlan", "environment", "counterfactual", "templates"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "contractId": { "const": "argus/template-contract@2" },
    "runner": { "type": "object" },
    "tags": { "type": "object" },
    "retryPolicy": { "type": "object" },
    "quarantine": { "type": "object" },
    "lanePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "columns", "states", "undecided"],
      "properties": {
        "file": { "$ref": "#/$defs/path" },
        "columns": { "$ref": "#/$defs/tokens" },
        "states": { "$ref": "#/$defs/tokens" },
        "undecided": { "$ref": "#/$defs/token" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "columns", "kinds", "resetOptIn", "resetAuthorizationAction", "undecided"],
      "properties": {
        "file": { "$ref": "#/$defs/path" },
        "columns": { "$ref": "#/$defs/tokens" },
        "kinds": { "$ref": "#/$defs/tokens" },
        "resetOptIn": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*=[a-z][a-z0-9-]*$" },
        "resetAuthorizationAction": { "$ref": "#/$defs/token" },
        "undecided": { "$ref": "#/$defs/token" }
      }
    },
    "counterfactual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "fixtureSchema", "requiredTamper", "exemptions"],
      "properties": {
        "directory": { "$ref": "#/$defs/path" },
        "fixtureSchema": { "type": "string", "pattern": "^argus/[a-z0-9-]+@[1-9][0-9]*$" },
        "requiredTamper": { "$ref": "#/$defs/token" },
        "exemptions": { "$ref": "#/$defs/tokens" }
      }
    },
    "templates": {
      "type": "object",
      "required": ["typescript", "java", "python"],
      "additionalProperties": false,
      "properties": {
        "typescript": { "$ref": "#/$defs/template" },
        "java": { "$ref": "#/$defs/template" },
        "python": { "$ref": "#/$defs/template" }
      }
    }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "tokens": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/token" } },
    "path": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*(/[a-z0-9][a-z0-9_.-]*)+$" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framework", "runner", "packageManagers", "extensionPoints", "adapter", "provenanceMarker", "laneMarker"],
      "properties": {
        "framework": { "type": "string", "minLength": 1 },
        "runner": { "type": "string", "minLength": 1 },
        "packageManagers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "extensionPoints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "adapter": { "type": "string", "minLength": 1 },
        "provenanceMarker": { "type": "string", "minLength": 1 },
        "laneMarker": { "type": "string", "minLength": 1 }
      }
    }
  }
}
