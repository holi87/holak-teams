{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holi87/holak-teams/argus/schemas/preflight-report.schema.json",
  "title": "Argus runtime preflight report v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "generatedAt", "mode", "modelRuntime", "status", "target", "artifactRoot", "authorization", "engagement", "orchestration", "browserRuntime", "checks", "capabilities", "agents", "summary", "residualRisks"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/holi87/holak-teams/master/argus/schemas/preflight-report.schema.json" },
    "schemaVersion": { "const": 3 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "mode": { "enum": ["A", "B", "C", "D"] },
    "modelRuntime": { "enum": ["claude", "codex"] },
    "status": { "enum": ["ready", "degraded", "blocked"] },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "kind", "reachable", "evidence"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["path", "url"] },
        "reachable": { "type": "boolean" },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "artifactRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "writable", "safePaths"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "writable": { "type": "boolean" },
        "safePaths": { "type": "boolean" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestPath", "auditPath", "sha256", "created", "environment", "productionLike", "productionSignals", "defaultReadOnly"],
      "properties": {
        "manifestPath": { "type": "string", "minLength": 1 },
        "auditPath": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "created": { "type": "boolean" },
        "environment": { "enum": ["unknown", "development", "test", "staging", "production"] },
        "productionLike": { "type": "boolean" },
        "productionSignals": { "$ref": "#/$defs/stringList" },
        "defaultReadOnly": { "type": "boolean" }
      }
    },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestPath", "statePath", "immutabilityAuditPath", "sha256", "created", "stateCreated", "phase", "selectedAgents", "accessibilityTarget", "browserCoverageEntries", "browserCoverageSource", "hookPath", "hookPackaged"],
      "properties": {
        "manifestPath": { "type": "string", "minLength": 1 },
        "statePath": { "type": "string", "minLength": 1 },
        "immutabilityAuditPath": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "created": { "type": "boolean" },
        "stateCreated": { "type": "boolean" },
        "phase": { "type": ["string", "null"] },
        "selectedAgents": { "type": "integer", "minimum": 0 },
        "accessibilityTarget": { "type": ["string", "null"] },
        "browserCoverageEntries": { "type": "integer", "minimum": 0 },
        "browserCoverageSource": { "type": ["string", "null"] },
        "hookPath": { "type": "string", "minLength": 1 },
        "hookPackaged": { "type": "boolean" }
      }
    },
    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "specialists"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "specialists": { "type": "integer", "minimum": 0, "maximum": 26 }
      }
    },
    "browserRuntime": { "$ref": "#/$defs/browserRuntime" },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "available", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "available": { "type": "boolean" },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "lane", "selected", "status", "dispatchAllowed", "stopsEngagement", "pendingGates", "model", "missingTools", "missingCapabilities", "actions", "artifactPaths", "authorization"],
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "lane": { "type": "string", "minLength": 1 },
          "selected": { "type": "boolean" },
          "status": { "enum": ["not-selected", "ready", "degraded", "deferred", "skipped", "conditional", "blocked"] },
          "dispatchAllowed": { "type": "boolean" },
          "stopsEngagement": { "type": "boolean" },
          "pendingGates": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
          "downgradedFrom": { "enum": ["blocked"] },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema", "policyId", "agent", "runtime", "status", "baselineConfig", "requiredOverrides", "requiredEnforcements", "adapterId", "adapterSnapshotSha256", "missingCapabilities", "reason"],
            "properties": {
              "schema": { "const": "argus/model-routing-preview@1" },
              "policyId": { "const": "argus/model-policy@2" },
              "agent": { "type": "string" },
              "runtime": { "enum": ["claude", "codex"] },
              "status": { "enum": ["ready", "blocked"] },
              "baselineConfig": {
                "type": "object",
                "additionalProperties": false,
                "required": ["tier", "model", "effort", "maxTurns"],
                "properties": {
                  "tier": { "enum": ["frontier", "standard"] },
                  "model": { "enum": ["opus", "sonnet", "sol", "terra"] },
                  "effort": { "enum": ["medium", "max", "xhigh"] },
                  "maxTurns": { "type": "integer", "minimum": 1 }
                }
              },
              "requiredOverrides": { "type": "array", "items": { "enum": ["model", "effort"] }, "uniqueItems": true },
              "requiredEnforcements": { "type": "array", "minItems": 3, "items": { "enum": ["model", "effort", "maxTurns"] }, "uniqueItems": true },
              "adapterId": { "enum": ["claude-plugin-agent@1", "codex-custom-agent@1"] },
              "adapterSnapshotSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "missingCapabilities": { "type": "array", "items": { "enum": ["model", "effort", "maxTurns"] }, "uniqueItems": true },
              "reason": { "type": "string" }
            }
          },
          "missingTools": { "$ref": "#/$defs/stringList" },
          "missingCapabilities": { "$ref": "#/$defs/stringList" },
          "actions": { "$ref": "#/$defs/stringList" },
          "artifactPaths": { "$ref": "#/$defs/stringList" },
          "authorization": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action", "decision", "ruleId", "reason"],
              "properties": {
                "action": { "type": "string", "minLength": 1 },
                "decision": { "enum": ["allow", "deny"] },
                "ruleId": { "type": "string", "pattern": "^AUTH-[A-Z0-9-]+$" },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "required": ["stopsEngagement"], "properties": { "stopsEngagement": { "const": true } } },
            "then": { "properties": { "status": { "const": "blocked" } } }
          },
          {
            "if": { "required": ["downgradedFrom"] },
            "then": { "properties": { "status": { "const": "deferred" }, "dispatchAllowed": { "const": false }, "stopsEngagement": { "const": false } } }
          },
          {
            "if": { "required": ["status"], "properties": { "status": { "const": "conditional" } } },
            "then": { "properties": { "pendingGates": { "minItems": 1 }, "dispatchAllowed": { "const": true }, "stopsEngagement": { "const": false } } }
          },
          {
            "if": { "required": ["status"], "properties": { "status": { "enum": ["not-selected", "ready", "degraded", "deferred", "skipped", "blocked"] } } },
            "then": { "properties": { "pendingGates": { "maxItems": 0 } } }
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected", "ready", "degraded", "deferred", "skipped", "conditional", "blocked", "downgraded", "dispatchable"],
      "properties": {
        "selected": { "type": "integer", "minimum": 0 },
        "ready": { "type": "integer", "minimum": 0 },
        "degraded": { "type": "integer", "minimum": 0 },
        "deferred": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "conditional": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "downgraded": { "type": "integer", "minimum": 0 },
        "dispatchable": { "type": "integer", "minimum": 0 }
      }
    },
    "residualRisks": {
      "type": "array",
      "maxItems": 27,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "status", "missingTools", "missingCapabilities", "reason"],
        "properties": {
          "slug": { "type": "string", "minLength": 1 },
          "status": { "enum": ["deferred", "skipped", "conditional", "blocked"] },
          "downgradedFrom": { "enum": ["blocked"] },
          "missingTools": { "$ref": "#/$defs/stringList" },
          "missingCapabilities": { "$ref": "#/$defs/stringList" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "required": ["downgradedFrom"] },
            "then": { "properties": { "status": { "const": "deferred" } } }
          }
        ]
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": { "type": "string" }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mandatory", "status", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "mandatory": { "type": "boolean" },
        "status": { "enum": ["pass", "fail", "degraded"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "browserRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source", "modulePath", "moduleVersion", "packageJsonSha256", "moduleTreeSha256", "moduleTreeRoots", "executablePath", "probedAt", "evidence", "candidates"],
      "properties": {
        "status": { "enum": ["available", "unavailable", "not-probed"] },
        "source": { "enum": ["profile", "host-provisioned", "target", "workspace", "npm-global", "system-global", "npx-cache", null] },
        "modulePath": { "type": ["string", "null"], "pattern": "^/" },
        "moduleVersion": { "type": ["string", "null"], "minLength": 1 },
        "packageJsonSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "moduleTreeSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "moduleTreeRoots": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "pattern": "^/" } },
        "executablePath": { "type": ["string", "null"], "minLength": 1 },
        "probedAt": { "type": ["string", "null"], "format": "date-time" },
        "evidence": { "type": "string", "minLength": 1 },
        "candidates": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/browserRuntimeCandidate" } }
      },
      "allOf": [
        {
          "if": { "required": ["status"], "properties": { "status": { "const": "available" } } },
          "then": {
            "properties": {
              "source": { "type": "string" },
              "modulePath": { "type": "string" },
              "moduleVersion": { "type": "string" },
              "packageJsonSha256": { "type": "string" },
              "moduleTreeSha256": { "type": "string" },
              "moduleTreeRoots": { "minItems": 1 },
              "executablePath": { "type": "string" },
              "probedAt": { "type": "string" },
              "candidates": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "required": ["status"], "properties": { "status": { "enum": ["unavailable", "not-probed"] } } },
          "then": {
            "properties": {
              "source": { "const": null },
              "modulePath": { "const": null },
              "moduleVersion": { "const": null },
              "packageJsonSha256": { "const": null },
              "moduleTreeSha256": { "const": null },
              "moduleTreeRoots": { "maxItems": 0 },
              "executablePath": { "const": null }
            }
          }
        },
        {
          "if": { "required": ["status"], "properties": { "status": { "const": "unavailable" } } },
          "then": { "properties": { "probedAt": { "type": "string" } } }
        },
        {
          "if": { "required": ["status"], "properties": { "status": { "const": "not-probed" } } },
          "then": { "properties": { "probedAt": { "const": null }, "candidates": { "maxItems": 0 } } }
        }
      ]
    },
    "browserRuntimeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "modulePath", "result", "evidence"],
      "properties": {
        "source": { "enum": ["profile", "host-provisioned", "target", "workspace", "npm-global", "system-global", "npx-cache"] },
        "modulePath": { "type": "string", "pattern": "^/" },
        "result": { "enum": ["launched", "failed", "invalid", "not-attempted"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
