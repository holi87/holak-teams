{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holi87/holak-teams/argus/schemas/orchestration-plan.schema.json",
  "title": "Argus orchestration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "capabilityMatrix",
    "raci",
    "dependencyPolicy",
    "modeCounts",
    "waves",
    "phases",
    "roles",
    "mandatoryLanes",
    "deepHunt",
    "proofLoop",
    "huntingBrief"
  ],
  "properties": {
    "$schema": {
      "const": "argus/orchestration-plan@2"
    },
    "schemaVersion": {
      "const": 2
    },
    "capabilityMatrix": {
      "const": "capabilities/capability-matrix.json"
    },
    "raci": {
      "const": "references/raci.json"
    },
    "dependencyPolicy": {
      "const": "selected-dispatchable-predecessors"
    },
    "modeCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B",
        "C",
        "D"
      ],
      "properties": {
        "A": {
          "type": "integer",
          "minimum": 0,
          "maximum": 27
        },
        "B": {
          "type": "integer",
          "minimum": 0,
          "maximum": 27
        },
        "C": {
          "type": "integer",
          "minimum": 0,
          "maximum": 27
        },
        "D": {
          "type": "integer",
          "minimum": 0,
          "maximum": 27
        }
      }
    },
    "waves": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "barrierAfter"
        ],
        "properties": {
          "id": {
            "enum": [
              "W0",
              "W1",
              "W2",
              "W3",
              "W4"
            ]
          },
          "barrierAfter": {
            "type": "boolean"
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "roles": {
      "type": "array",
      "minItems": 27,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/role"
      }
    },
    "deepHunt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes",
        "tier",
        "maxPasses",
        "continueWhen",
        "roles",
        "brief"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          }
        },
        "tier": {
          "const": "frontier"
        },
        "maxPasses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "continueWhen": {
          "const": "new-confirmed-defects"
        },
        "roles": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "brief": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "huntingBrief": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "proofLoop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validator",
        "oracleDesk",
        "maxRepairRounds",
        "validatorPasses",
        "routes",
        "independentReproduction",
        "acceptedOracleKinds",
        "justifiedInvariantClasses",
        "exhaustion"
      ],
      "properties": {
        "validator": {
          "const": "minos"
        },
        "oracleDesk": {
          "const": "metis"
        },
        "maxRepairRounds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "validatorPasses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "order",
            "clusters"
          ],
          "properties": {
            "order": {
              "const": "clusters-then-consolidator"
            },
            "clusters": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/cluster"
              }
            }
          }
        },
        "routes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "independentReproduction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "candidates",
            "selection",
            "freshState",
            "unavailable"
          ],
          "properties": {
            "candidates": {
              "const": "raci.surfaceRoutes[].reproduce"
            },
            "selection": {
              "type": "string",
              "minLength": 20
            },
            "freshState": {
              "type": "string",
              "minLength": 20
            },
            "unavailable": {
              "type": "string",
              "minLength": 20
            }
          }
        },
        "acceptedOracleKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "requirement",
              "contract",
              "justified-invariant"
            ]
          }
        },
        "justifiedInvariantClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "server-error",
              "crash",
              "data-loss",
              "authz-breach",
              "layer-disagreement"
            ]
          }
        },
        "exhaustion": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "mandatoryLanes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "modes",
        "roles",
        "rule"
      ],
      "properties": {
        "policy": {
          "const": "gates-satisfied-means-dispatched"
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          }
        },
        "roles": {
          "$ref": "#/$defs/stringList"
        },
        "rule": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slug",
        "kind",
        "dispatch",
        "wave",
        "modes",
        "gates",
        "dependsOn"
      ],
      "properties": {
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "controller",
            "specialist"
          ]
        },
        "dispatch": {
          "type": "boolean"
        },
        "wave": {
          "enum": [
            "controller",
            "W0",
            "W1",
            "W2",
            "W3",
            "W4"
          ]
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          }
        },
        "gates": {
          "$ref": "#/$defs/stringList"
        },
        "dependsOn": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "wave",
        "kind",
        "modes",
        "skippable",
        "participants",
        "standby"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "wave": {
          "enum": [
            "W0",
            "W1",
            "W2",
            "W3",
            "W4"
          ]
        },
        "kind": {
          "enum": [
            "work",
            "proof",
            "deep-hunt"
          ]
        },
        "pass": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          }
        },
        "skippable": {
          "type": "boolean"
        },
        "participants": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "standby": {
          "$ref": "#/$defs/stringList"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "proof"
              }
            }
          },
          "then": {
            "required": [
              "pass"
            ]
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "deep-hunt"
              }
            }
          },
          "then": {
            "required": [
              "pass"
            ]
          }
        }
      ]
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "lanes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "lanes": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "to",
        "carries"
      ],
      "properties": {
        "status": {
          "enum": [
            "bounced",
            "needs-oracle",
            "quarantined",
            "suspected",
            "confirmed"
          ]
        },
        "to": {
          "enum": [
            "filing-lane",
            "oracle-desk",
            "independent-reproducer"
          ]
        },
        "carries": {
          "type": "string",
          "minLength": 3
        },
        "when": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
