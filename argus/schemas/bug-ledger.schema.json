{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holi87/holak-teams/argus/schemas/bug-ledger.schema.json",
  "title": "Argus defect candidate ledger v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "engagementId",
    "bugs"
  ],
  "properties": {
    "$schema": {
      "const": "argus/bug-ledger@2"
    },
    "schemaVersion": {
      "const": 2
    },
    "engagementId": {
      "type": "string",
      "minLength": 1
    },
    "bugs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bug"
      }
    }
  },
  "$defs": {
    "bug": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "title",
        "severity",
        "priority",
        "lane",
        "oracleId",
        "status",
        "wired",
        "testId",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BUG-[0-9]{4}$"
        },
        "origin": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}-[0-9]{3,4}$"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "Blocker",
            "Critical",
            "Major",
            "Minor",
            "Trivial"
          ]
        },
        "priority": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ]
        },
        "lane": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "oracleId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "status": {
          "enum": [
            "confirmed",
            "suspected",
            "needs-oracle",
            "bounced",
            "quarantined",
            "duplicate",
            "rejected"
          ]
        },
        "wired": {
          "type": "boolean"
        },
        "testId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:TST|REG)-[0-9]{4}$"
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVD-[0-9]{4}$"
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build",
            "disputedOracle",
            "oracle",
            "reproduction",
            "independent"
          ],
          "properties": {
            "build": {
              "type": "string",
              "minLength": 1
            },
            "disputedOracle": {
              "type": "boolean"
            },
            "oracle": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "sourceRef",
                "evidenceId",
                "applicability",
                "exceptions"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "requirement",
                    "contract",
                    "justified-invariant"
                  ]
                },
                "sourceRef": {
                  "type": "string",
                  "minLength": 1
                },
                "evidenceId": {
                  "type": "string",
                  "pattern": "^EVD-[0-9]{4}$"
                },
                "applicability": {
                  "type": "string",
                  "minLength": 1
                },
                "exceptions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "invariantClass": {
                  "enum": [
                    "server-error",
                    "crash",
                    "data-loss",
                    "authz-breach",
                    "layer-disagreement"
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "justified-invariant"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "then": {
                    "required": [
                      "invariantClass"
                    ]
                  }
                }
              ]
            },
            "reproduction": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "initialState",
                "steps",
                "attempts",
                "occurrences",
                "evidenceIds"
              ],
              "properties": {
                "initialState": {
                  "type": "string",
                  "minLength": 1
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "attempts": {
                  "type": "integer",
                  "minimum": 1
                },
                "occurrences": {
                  "type": "integer",
                  "minimum": 1
                },
                "evidenceIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^EVD-[0-9]{4}$"
                  },
                  "minItems": 1
                }
              }
            },
            "independent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "executor",
                "evidenceIds",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "reproduced",
                    "unavailable",
                    "not-required"
                  ]
                },
                "executor": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidenceIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^EVD-[0-9]{4}$"
                  }
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "reproduced"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "executor": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidenceIds": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^EVD-[0-9]{4}$"
                        },
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "duplicateOf": {
          "type": "string",
          "pattern": "^BUG-[0-9]{4}$"
        },
        "merge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rationale",
            "causalEvidence"
          ],
          "properties": {
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "causalEvidence": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "ref",
                  "evidenceIds"
                ],
                "properties": {
                  "ref": {
                    "type": "string",
                    "pattern": "^(?:BUG-[0-9]{4}|[A-Z]{3}-[0-9]{3,4})$"
                  },
                  "evidenceIds": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^EVD-[0-9]{4}$"
                    },
                    "minItems": 1
                  }
                }
              }
            }
          }
        },
        "missingProof": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "elements",
            "detail",
            "owner"
          ],
          "properties": {
            "elements": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "oracle",
                  "reproduction",
                  "independent-reproduction",
                  "evidence",
                  "environment-access",
                  "authorization"
                ]
              }
            },
            "detail": {
              "type": "string",
              "minLength": 1
            },
            "owner": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          }
        },
        "rejection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "rationale",
            "evidenceIds"
          ],
          "properties": {
            "reason": {
              "enum": [
                "not-reproducible",
                "oracle-contradicts",
                "expected-behavior",
                "out-of-scope",
                "test-artifact",
                "environment-fault",
                "insufficient-evidence"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1
            },
            "evidenceIds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^EVD-[0-9]{4}$"
              }
            }
          }
        },
        "repair": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "round",
            "missing"
          ],
          "properties": {
            "round": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            },
            "missing": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "oracle-citation",
                  "reproduction",
                  "evidence",
                  "honest-status",
                  "independent-reproduction",
                  "arranged-precondition",
                  "layer-attribution",
                  "evidence-integrity"
                ]
              }
            },
            "assignedTo": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "quarantine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasons"
          ],
          "properties": {
            "reasons": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "wired": {
                "const": true
              }
            },
            "required": [
              "wired"
            ]
          },
          "then": {
            "properties": {
              "testId": {
                "type": "string",
                "pattern": "^(?:TST|REG)-[0-9]{4}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "verification"
            ],
            "properties": {
              "evidenceIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^EVD-[0-9]{4}$"
                },
                "minItems": 1
              },
              "oracleId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "suspected"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "missingProof"
            ],
            "properties": {
              "oracleId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "needs-oracle"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "missingProof"
            ],
            "properties": {
              "oracleId": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "bounced"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "repair"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "quarantined"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "quarantine"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "duplicate"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "duplicateOf",
              "merge"
            ],
            "properties": {
              "oracleId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "rejected"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "rejection"
            ]
          }
        }
      ]
    }
  }
}
