{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holi87/holak-teams/argus/schemas/bug-ledger.schema.json",
  "title": "Argus confirmed defect ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "engagementId",
    "bugs"
  ],
  "properties": {
    "$schema": {
      "const": "argus/bug-ledger@1"
    },
    "schemaVersion": {
      "const": 1
    },
    "engagementId": {
      "type": "string",
      "minLength": 1
    },
    "bugs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bug"
      }
    }
  },
  "$defs": {
    "bug": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "title",
        "severity",
        "priority",
        "lane",
        "oracleId",
        "status",
        "wired",
        "testId",
        "evidenceIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BUG-[0-9]{4}$"
        },
        "origin": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{3}-[0-9]{3,4}$"
          }
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "Blocker",
            "Critical",
            "Major",
            "Minor",
            "Trivial"
          ]
        },
        "priority": {
          "enum": [
            "P1",
            "P2",
            "P3",
            "P4"
          ]
        },
        "lane": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "oracleId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "confirmed",
            "suspected",
            "needs-oracle"
          ]
        },
        "wired": {
          "type": "boolean"
        },
        "testId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:TST|REG)-[0-9]{4}$"
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVD-[0-9]{4}$"
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "build",
            "disputedOracle",
            "oracle",
            "reproduction",
            "independent"
          ],
          "properties": {
            "build": {
              "type": "string",
              "minLength": 1
            },
            "disputedOracle": {
              "type": "boolean"
            },
            "oracle": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "sourceRef",
                "evidenceId",
                "applicability",
                "exceptions"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "requirement",
                    "contract",
                    "justified-invariant"
                  ]
                },
                "sourceRef": {
                  "type": "string",
                  "minLength": 1
                },
                "evidenceId": {
                  "type": "string",
                  "pattern": "^EVD-[0-9]{4}$"
                },
                "applicability": {
                  "type": "string",
                  "minLength": 1
                },
                "exceptions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "reproduction": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "initialState",
                "steps",
                "attempts",
                "occurrences",
                "evidenceIds"
              ],
              "properties": {
                "initialState": {
                  "type": "string",
                  "minLength": 1
                },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "attempts": {
                  "type": "integer",
                  "minimum": 1
                },
                "occurrences": {
                  "type": "integer",
                  "minimum": 1
                },
                "evidenceIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^EVD-[0-9]{4}$"
                  },
                  "minItems": 1
                }
              }
            },
            "independent": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "executor",
                "evidenceIds",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "reproduced",
                    "unavailable",
                    "not-required"
                  ]
                },
                "executor": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidenceIds": {
                  "type": "array",
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^EVD-[0-9]{4}$"
                  }
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "reproduced"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "executor": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidenceIds": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "type": "string",
                          "pattern": "^EVD-[0-9]{4}$"
                        },
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            "mergeRationale": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "wired": {
                "const": true
              }
            },
            "required": [
              "wired"
            ]
          },
          "then": {
            "properties": {
              "testId": {
                "type": "string",
                "pattern": "^(?:TST|REG)-[0-9]{4}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "required": [
              "verification"
            ],
            "properties": {
              "evidenceIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^EVD-[0-9]{4}$"
                },
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
