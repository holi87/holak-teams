{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://holak-teams.local/argus/prompt-budgets.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "approvedCorpus",
    "nonRegression",
    "budgets",
    "requiredPreloadedProfiles",
    "optionalProfiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 2
    },
    "approvedCorpus": {
      "type": "object",
      "required": [
        "sha256",
        "words",
        "effectiveWords",
        "codexEstimatedTokens",
        "agents",
        "profiles",
        "releaseVersion",
        "approvedFor",
        "benchmark"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "words": {
          "type": "integer",
          "minimum": 1
        },
        "effectiveWords": {
          "type": "integer",
          "minimum": 1
        },
        "codexEstimatedTokens": {
          "type": "integer",
          "minimum": 1
        },
        "agents": {
          "$ref": "#/$defs/wordCounts"
        },
        "profiles": {
          "$ref": "#/$defs/wordCounts"
        },
        "releaseVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "approvedFor": {
          "type": "string",
          "minLength": 1
        },
        "benchmark": {
          "oneOf": [
            {
              "$ref": "#/$defs/pendingBenchmark"
            },
            {
              "$ref": "#/$defs/nonRegressedBenchmark"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "nonRegression": {
      "type": "object",
      "required": [
        "minRepeats",
        "recallTolerance",
        "criticalRecallTolerance",
        "precisionTolerance"
      ],
      "properties": {
        "minRepeats": {
          "type": "integer",
          "minimum": 1
        },
        "recallTolerance": {
          "$ref": "#/$defs/unitInterval"
        },
        "criticalRecallTolerance": {
          "$ref": "#/$defs/unitInterval"
        },
        "precisionTolerance": {
          "$ref": "#/$defs/unitInterval"
        }
      },
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "required": [
        "maxClaudeAgentWords",
        "maxEffectiveClaudeWords",
        "maxAgentWords",
        "maxEffectiveAgentWords",
        "maxCodexEstimatedTokens",
        "minRunSkillWords",
        "maxRunSkillWords",
        "maxOdysseusAgentWords",
        "maxCodexCapabilityDeltaWords",
        "maxFrontmatterToolEntries",
        "maxToolNameBytesPerAgent",
        "maxToolNameBytesCorpus",
        "maxPlaywrightMcpEntries",
        "maxDescriptionWords",
        "duplicateParagraphMinWords",
        "maxDuplicatedDoctrineInstances"
      ],
      "properties": {
        "maxClaudeAgentWords": {
          "type": "integer",
          "minimum": 1
        },
        "maxEffectiveClaudeWords": {
          "type": "integer",
          "minimum": 1
        },
        "maxAgentWords": {
          "type": "integer",
          "minimum": 1
        },
        "maxEffectiveAgentWords": {
          "type": "integer",
          "minimum": 1
        },
        "maxCodexEstimatedTokens": {
          "type": "integer",
          "minimum": 1
        },
        "minRunSkillWords": {
          "type": "integer",
          "minimum": 1
        },
        "maxRunSkillWords": {
          "type": "integer",
          "minimum": 1
        },
        "maxOdysseusAgentWords": {
          "type": "integer",
          "minimum": 1
        },
        "maxCodexCapabilityDeltaWords": {
          "type": "integer",
          "minimum": 1
        },
        "maxFrontmatterToolEntries": {
          "type": "integer",
          "minimum": 1
        },
        "maxToolNameBytesPerAgent": {
          "type": "integer",
          "minimum": 1
        },
        "maxToolNameBytesCorpus": {
          "type": "integer",
          "minimum": 1
        },
        "maxPlaywrightMcpEntries": {
          "description": "Exact count, not a ceiling: the only Playwright MCP tools are Kalchas's read-only public recon pair. A security invariant, never raised for prompt growth.",
          "const": 2
        },
        "maxDescriptionWords": {
          "type": "integer",
          "minimum": 1
        },
        "duplicateParagraphMinWords": {
          "type": "integer",
          "minimum": 1
        },
        "maxDuplicatedDoctrineInstances": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "requiredPreloadedProfiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "contains": {
        "const": "qa-core"
      },
      "uniqueItems": true
    },
    "optionalProfiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "contains": {
        "const": "competition-profile"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "wordCounts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "pendingBenchmark": {
      "type": "object",
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "const": "pending"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "nonRegressedBenchmark": {
      "type": "object",
      "required": [
        "status",
        "comparisonSha256",
        "adjudicatedAt",
        "baseline",
        "candidate"
      ],
      "properties": {
        "status": {
          "const": "non-regressed"
        },
        "comparisonSha256": {
          "$ref": "#/$defs/sha256"
        },
        "adjudicatedAt": {
          "type": "string",
          "format": "date"
        },
        "baseline": {
          "$ref": "#/$defs/benchmarkRun"
        },
        "candidate": {
          "$ref": "#/$defs/benchmarkRun"
        }
      },
      "additionalProperties": false
    },
    "benchmarkRun": {
      "type": "object",
      "required": [
        "revision",
        "corpusSha256",
        "runs",
        "meanRecall",
        "meanCriticalRecall",
        "meanPrecision"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "corpusSha256": {
          "$ref": "#/$defs/sha256"
        },
        "runs": {
          "type": "integer",
          "minimum": 1
        },
        "meanRecall": {
          "$ref": "#/$defs/unitInterval"
        },
        "meanCriticalRecall": {
          "oneOf": [
            {
              "$ref": "#/$defs/unitInterval"
            },
            {
              "type": "null"
            }
          ]
        },
        "meanPrecision": {
          "$ref": "#/$defs/unitInterval"
        }
      },
      "additionalProperties": false
    }
  }
}
