{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holi87/holak-teams/argus/schemas/coverage-result.schema.json",
  "title": "Argus surface-derived coverage result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "engagementId",
    "sourceSchemas",
    "discovery",
    "overall",
    "lanes",
    "surfaces",
    "criticalUnexecuted",
    "runnerCaseMapping",
    "scopedOutcomes",
    "defectOutcomes",
    "generatedAt"
  ],
  "properties": {
    "$schema": {
      "const": "argus/coverage-result@2"
    },
    "schemaVersion": {
      "const": 2
    },
    "engagementId": {
      "type": "string",
      "minLength": 1
    },
    "sourceSchemas": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "argus/surface-inventory@1",
          "argus/coverage-observations@2",
          "argus/evidence-reference@3",
          "argus/bug-ledger@2"
        ]
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates",
        "characterized",
        "completeness"
      ],
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 1
        },
        "characterized": {
          "type": "integer",
          "minimum": 0
        },
        "completeness": {
          "$ref": "#/$defs/ratio"
        }
      }
    },
    "overall": {
      "$ref": "#/$defs/metric"
    },
    "lanes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/metric"
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surfaceId",
          "lane",
          "risk",
          "riskWeight",
          "accessibility",
          "executed",
          "asserted",
          "evidenced",
          "automated",
          "defectIds"
        ],
        "properties": {
          "surfaceId": {
            "type": "string",
            "pattern": "^SRF-[A-Z0-9][A-Z0-9-]*$"
          },
          "lane": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "risk": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "riskWeight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "accessibility": {
            "enum": [
              "testable",
              "inaccessible",
              "untestable"
            ]
          },
          "executed": {
            "type": "boolean"
          },
          "asserted": {
            "type": "boolean"
          },
          "evidenced": {
            "type": "boolean"
          },
          "automated": {
            "type": "boolean"
          },
          "defectIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^BUG-[0-9]{4}$"
            }
          }
        }
      }
    },
    "criticalUnexecuted": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SRF-[A-Z0-9][A-Z0-9-]*$"
      }
    },
    "runnerCaseMapping": {
      "enum": [
        "verified",
        "unverified",
        "not-applicable"
      ]
    },
    "scopedOutcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surfaceId",
          "accessibility",
          "reason",
          "evidenceIds"
        ],
        "properties": {
          "surfaceId": {
            "type": "string",
            "pattern": "^SRF-[A-Z0-9][A-Z0-9-]*$"
          },
          "accessibility": {
            "enum": [
              "inaccessible",
              "untestable"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^EVD-[0-9]{4}$"
            }
          }
        }
      }
    },
    "defectOutcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirmed",
        "suspected",
        "needsOracle",
        "duplicate",
        "rejected",
        "headline",
        "linked",
        "unlinked",
        "scoreContribution"
      ],
      "properties": {
        "confirmed": {
          "type": "integer",
          "minimum": 0
        },
        "suspected": {
          "type": "integer",
          "minimum": 0
        },
        "needsOracle": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "headline": {
          "type": "integer",
          "minimum": 0
        },
        "linked": {
          "type": "integer",
          "minimum": 0
        },
        "unlinked": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^BUG-[0-9]{4}$"
          }
        },
        "scoreContribution": {
          "const": 0
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "ratio": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discoveredItems",
        "testableItems",
        "scopedItems",
        "riskWeight",
        "executionCoverage",
        "assertionQuality",
        "evidenceQuality",
        "automatedExecution"
      ],
      "properties": {
        "discoveredItems": {
          "type": "integer",
          "minimum": 0
        },
        "testableItems": {
          "type": "integer",
          "minimum": 0
        },
        "scopedItems": {
          "type": "integer",
          "minimum": 0
        },
        "riskWeight": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "denominator",
            "executed",
            "asserted",
            "evidenced",
            "automated"
          ],
          "properties": {
            "denominator": {
              "type": "integer",
              "minimum": 0
            },
            "executed": {
              "type": "integer",
              "minimum": 0
            },
            "asserted": {
              "type": "integer",
              "minimum": 0
            },
            "evidenced": {
              "type": "integer",
              "minimum": 0
            },
            "automated": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "executionCoverage": {
          "$ref": "#/$defs/ratio"
        },
        "assertionQuality": {
          "$ref": "#/$defs/ratio"
        },
        "evidenceQuality": {
          "$ref": "#/$defs/ratio"
        },
        "automatedExecution": {
          "$ref": "#/$defs/ratio"
        },
        "caseDepth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plannedWeight": {
              "type": "integer",
              "minimum": 0
            },
            "executedWeight": {
              "type": "integer",
              "minimum": 0
            },
            "verifiedWeight": {
              "type": "integer",
              "minimum": 0
            },
            "coverage": {
              "$ref": "#/$defs/ratio"
            },
            "unplannedSurfaces": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "obligationId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "obligationId",
                  "reason"
                ]
              }
            }
          },
          "required": [
            "plannedWeight",
            "executedWeight",
            "verifiedWeight",
            "coverage",
            "unplannedSurfaces",
            "gaps"
          ]
        }
      }
    }
  }
}
