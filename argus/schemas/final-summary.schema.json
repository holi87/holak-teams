{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holi87/holak-teams/argus/schemas/final-summary.schema.json",
  "title": "Argus final engagement summary v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "engagementId",
    "owner",
    "status",
    "statusReasons",
    "counts",
    "unproven",
    "held",
    "automationReview",
    "runner",
    "coverage",
    "sourceSchemas",
    "summary",
    "generatedAt"
  ],
  "properties": {
    "$schema": {
      "const": "argus/final-summary@2"
    },
    "schemaVersion": {
      "const": 2
    },
    "engagementId": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "const": "kleio"
    },
    "status": {
      "enum": [
        "completed",
        "blocked",
        "degraded"
      ]
    },
    "statusReasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9:-]+$"
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bugs",
        "regression",
        "automated",
        "evidence"
      ],
      "properties": {
        "bugs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "confirmed",
            "suspected",
            "needsOracle",
            "bounced",
            "quarantined",
            "duplicate",
            "rejected",
            "headline"
          ],
          "properties": {
            "confirmed": {
              "$ref": "#/$defs/count"
            },
            "suspected": {
              "$ref": "#/$defs/count"
            },
            "needsOracle": {
              "$ref": "#/$defs/count"
            },
            "bounced": {
              "$ref": "#/$defs/count"
            },
            "quarantined": {
              "$ref": "#/$defs/count"
            },
            "duplicate": {
              "$ref": "#/$defs/count"
            },
            "rejected": {
              "$ref": "#/$defs/count"
            },
            "headline": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "regression": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "wired",
            "uncovered"
          ],
          "properties": {
            "wired": {
              "$ref": "#/$defs/count"
            },
            "uncovered": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/bugId"
              }
            }
          }
        },
        "automated": {
          "$ref": "#/$defs/count"
        },
        "evidence": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "unproven": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "severity",
          "status",
          "missing",
          "detail"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/bugId"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "Blocker",
              "Critical",
              "Major",
              "Minor",
              "Trivial"
            ]
          },
          "status": {
            "enum": [
              "suspected",
              "needs-oracle"
            ]
          },
          "missing": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "oracle",
                "reproduction",
                "independent-reproduction",
                "evidence",
                "environment-access",
                "authorization"
              ]
            }
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "held": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "severity",
          "status",
          "reasons"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/bugId"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "Blocker",
              "Critical",
              "Major",
              "Minor",
              "Trivial"
            ]
          },
          "status": {
            "enum": [
              "bounced",
              "quarantined"
            ]
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "automationReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewId",
        "round",
        "blockers",
        "warnings"
      ],
      "properties": {
        "status": {
          "enum": [
            "approved",
            "blocked",
            "stale",
            "absent",
            "not-applicable"
          ]
        },
        "reviewId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^REV-[0-9]{2}$"
        },
        "round": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 99
        },
        "blockers": {
          "$ref": "#/$defs/count"
        },
        "warnings": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "runner": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "mode",
        "status",
        "exitCode",
        "resultPath",
        "categories",
        "deliveryGate"
      ],
      "properties": {
        "mode": {
          "enum": [
            "baseline",
            "defect-evidence",
            "candidate-regression",
            "full-suite"
          ]
        },
        "status": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "exitCode": {
          "enum": [
            0,
            10,
            11,
            12,
            13,
            14,
            15
          ]
        },
        "resultPath": {
          "const": "reports/argus-runner-result.json"
        },
        "categories": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product",
            "automation",
            "infrastructure",
            "skip",
            "policy"
          ],
          "properties": {
            "product": {
              "$ref": "#/$defs/count"
            },
            "automation": {
              "$ref": "#/$defs/count"
            },
            "infrastructure": {
              "$ref": "#/$defs/count"
            },
            "skip": {
              "$ref": "#/$defs/count"
            },
            "policy": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "deliveryGate": {
          "type": "boolean"
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resultPath",
        "discoveryCompleteness",
        "executionCoverage",
        "assertionQuality",
        "evidenceQuality",
        "automatedExecution",
        "scopedOutcomes",
        "criticalUnexecuted"
      ],
      "properties": {
        "resultPath": {
          "const": "solution/coverage-result.json"
        },
        "discoveryCompleteness": {
          "$ref": "#/$defs/ratio"
        },
        "executionCoverage": {
          "$ref": "#/$defs/ratio"
        },
        "assertionQuality": {
          "$ref": "#/$defs/ratio"
        },
        "evidenceQuality": {
          "$ref": "#/$defs/ratio"
        },
        "automatedExecution": {
          "$ref": "#/$defs/ratio"
        },
        "scopedOutcomes": {
          "$ref": "#/$defs/count"
        },
        "criticalUnexecuted": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^SRF-[A-Z0-9][A-Z0-9-]*$"
          }
        },
        "caseDepth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "plannedWeight": {
              "$ref": "#/$defs/count"
            },
            "executedWeight": {
              "$ref": "#/$defs/count"
            },
            "verifiedWeight": {
              "$ref": "#/$defs/count"
            },
            "coverage": {
              "$ref": "#/$defs/ratio"
            },
            "unplannedSurfaces": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "obligationId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "obligationId",
                  "reason"
                ]
              }
            }
          },
          "required": [
            "plannedWeight",
            "executedWeight",
            "verifiedWeight",
            "coverage",
            "unplannedSurfaces",
            "gaps"
          ]
        }
      }
    },
    "sourceSchemas": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^argus/[a-z-]+@[1-9][0-9]*$"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "ratio": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "bugId": {
      "type": "string",
      "pattern": "^BUG-[0-9]{4}$"
    }
  }
}
