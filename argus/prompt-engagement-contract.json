    { "id": "no-direct-canonical-write", "pattern": "\\b(?:Write|Produce) `(?:solution/[A-Z][A-Za-z_-]*\\.md|README\\.md|run-tests\\.sh)`|unless canonically accountable", "flags": "" },
    { "id": "no-working-directory-artifact-input", "pattern": "--(?:input|inventory|observations|evidence|ledger|automation-status|selection|root|destination) (?:solution|reports|bugs|tests|ai_agents_internal)/", "flags": "" }
