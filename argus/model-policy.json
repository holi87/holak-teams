{
  "$schema": "./schemas/model-policy.schema.json",
  "schemaVersion": 1,
  "policyId": "argus/model-policy@1",
  "baseline": {
    "decision": "adopt-27-frontier-0-standard",
    "frontierRoles": 27,
    "standardRoles": 0,
    "mechanicalFullRoles": 0,
    "benchmark": "model-policy.benchmark.json",
    "standardAllowlist": []
  },
  "tiers": {
    "frontier": {
      "rank": 2,
      "qualityCritical": true,
      "claude": {
        "model": "opus",
        "effort": "max"
      },
      "codex": {
        "model": "sol",
        "reasoningEffort": "xhigh"
      }
    },
    "standard": {
      "rank": 1,
      "qualityCritical": false,
      "claude": {
        "model": "sonnet",
        "effort": "medium"
      },
      "codex": {
        "model": "terra",
        "reasoningEffort": "medium"
      }
    },
    "mechanical": {
      "rank": 0,
      "qualityCritical": false,
      "claude": {
        "model": "haiku",
        "effort": "low"
      },
      "codex": {
        "model": "luna",
        "reasoningEffort": "medium"
      },
      "eligibility": [
        "bounded-subrole",
        "no-quality-judgment",
        "deterministic-output-schema",
        "validator-passes-before-merge"
      ]
    }
  },
  "fallbackPolicies": {
    "frontier-fail-closed": {
      "modelUnavailable": "block-and-escalate-operator",
      "turnLimit": "retain-frontier-and-escalate-operator",
      "allowWeakerModel": false
    },
    "upward-only": {
      "modelUnavailable": "escalate-to-frontier",
      "turnLimit": "escalate-to-frontier",
      "allowWeakerModel": false
    }
  },
  "escalationProfiles": {
    "orchestration": [
      "ambiguity",
      "safety",
      "cross-lane",
      "repeated-failure",
      "turn-limit"
    ],
    "judgment": [
      "ambiguity",
      "safety",
      "conflicting-evidence",
      "repeated-failure",
      "turn-limit"
    ],
    "analysis": [
      "ambiguity",
      "safety",
      "cross-lane",
      "repeated-failure",
      "turn-limit"
    ],
    "execution": [
      "oracle-ambiguity",
      "safety",
      "cross-lane",
      "repeated-failure",
      "turn-limit"
    ],
    "schema-bound": [
      "schema-validation-failure",
      "ambiguity",
      "repeated-failure",
      "turn-limit"
    ]
  },
  "mechanicalDowngrade": {
    "fullRoleAllowed": false,
    "requiresBoundedSubrole": true,
    "requiresDeterministicSchema": true,
    "requiresValidatorPass": true,
    "forbiddenWhenQualityJudgment": true
  },
  "routing": {
    "decisionDirectory": "ai_agents_internal/model-decisions",
    "decisionSchema": "argus/model-decision@2",
    "requiredEnforcements": [
      "model",
      "effort",
      "maxTurns"
    ]
  },
  "telemetry": {
    "defaultPath": "ai_agents_internal/model-telemetry.jsonl",
    "schema": "argus/model-telemetry-event@2",
    "allowedFields": [
      "schema",
      "timestamp",
      "eventId",
      "decisionId",
      "decisionIntegritySha256",
      "adapterId",
      "adapterSnapshotSha256",
      "engagementId",
      "dispatchId",
      "attempt",
      "agent",
      "runtime",
      "tier",
      "model",
      "effort",
      "maxTurns",
      "signal",
      "reasonCode",
      "fallbackUsed",
      "success",
      "inputTokens",
      "outputTokens",
      "totalTokens",
      "durationMs",
      "reportedCostUsd"
    ],
    "forbiddenFields": [
      "prompt",
      "completion",
      "target",
      "url",
      "path",
      "account",
      "token",
      "evidence"
    ]
  },
  "controllerBudget": {
    "agent": "odysseus",
    "closeoutReserveTurns": 30
  },
