  init --target <target> --artifact-root <root> --mode <A|B|C|D> [--browser-support <json>] [--accessibility-requirement <json>]
  allocate --manifest <path> --lane <slug>
  allocate --manifest <path> --lanes <slug,slug> --controller-token <odysseus-token>
