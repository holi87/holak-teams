  argus-assets model route --manifest <engagement.json> --agents <slug,slug|dispatchable> --runtime <claude|codex> --signal normal --dispatch-prefix <id> --attempt 1
  argus-assets model telemetry --manifest <engagement.json> --decision <model-decision.json> --token <lane-token> --input-tokens <n> --output-tokens <n> --duration-ms <n> --success <true|false> [options]
  argus-assets launch request --target <url-or-path> --workspace <absolute-path> --artifact-root <absolute-path> --mode <A|B|C|D> --engagement-id <id> --launcher <path> --launcher-pid <pid> --claude-executable <path> --runtime-key-id <id> --trust-store <path> --output <path>
  argus-assets launch verify --request <json> --authorization <json> --receipt <path> --trust-store <path>
  argus-assets browser provision --artifact-root <absolute-path> [--version <x.y.z>] [--package <absolute .tgz>] [--skip-browser-install] [--json]
  argus-assets orchestration plan --mode <A|B|C|D> [--dispatchable <slug,slug>] [--artifact-root <path>] [--output <json|->]
