  argus-assets authorization verify|install --artifact-root <absolute-path> --engagement-id <id> --target <url-or-path> [--manifest <absolute-path>] [--environment <name>]
  argus-assets engagement <init|validate|allocate|start-attempt|status|claim|release|fragment|merge|id|checkpoint|heartbeat|barrier|cleanup|resolve-gates|report-facts|lane-outcomes> [options]
