// Read-only: prints the facts the final-summary merge derives and overwrites, so Kleio builds
// her fragment from them instead of counting by hand. It takes no lease token.
function engagementReportFacts(args) {
  const options = parseNamedOptions(args, new Set(['--manifest', '--output']));
  requireOptions(options, ['manifest'], 'engagement report-facts');
  const { manifest: engagement } = loadEngagement(options);
  const facts = deriveFinalSummaryFacts(engagement, getEngagementStatus(engagement));
  const content = `${JSON.stringify(facts, null, 2)}\n`;
  const output = options.output ?? '-';
  if (output === '-') process.stdout.write(content);
  else {
    const outputPath = resolve(output);
    assertActiveEngagementWrites([outputPath], 'report facts output');
    mkdirSync(dirname(outputPath), { recursive: true });
    atomicPrivateWrite(outputPath, content);
    console.log(`REPORT-FACTS  status-ceiling=${facts.statusCeiling} reasons=${facts.statusReasons.join(',') || 'none'} output=${outputPath}`);
  }
  return 0;
}

// The controller's count-only per-lane outcome report. The argv controller token is checked
// against the active Odysseus allocation here and again, with its live lease marker, by the
// runtime; it is never persisted and never enters the report. Recomputation is idempotent, so
// every call atomically replaces the fixed, non-aliased control artifact.
function engagementLaneOutcomes(args) {
  const options = parseNamedOptions(args, new Set(['--manifest', '--controller-token']));
  requireOptions(options, ['manifest'], 'engagement lane-outcomes');
  const { manifest: engagement } = loadEngagement(options);
  requireEngagementControllerToken(engagement, options.controllerToken, 'engagement lane-outcomes');
  const report = computeLaneOutcomes(engagement, modelPolicy, { controllerToken: options.controllerToken });
  assertSchemaDocument(compileJsonSchema(readJson(LANE_OUTCOMES_SCHEMA_PATH)), report, 'lane outcomes report');
  const content = `${JSON.stringify(report, null, 2)}\n`;
  if (content.includes(options.controllerToken)) fail('lane outcomes report would disclose the controller token');
  const artifactRoot = realpathSync(engagement.artifactRoot);
  const output = join(artifactRoot, 'ai_agents_internal', 'lane-outcomes.json');
  assertPhysicalWithin(artifactRoot, output, 'lane outcomes output');
  atomicPrivateWrite(output, content);
  console.log(`LANE_OUTCOMES  recorded output=${output} lanes=${report.lanes.length}`);
  return 0;
}

