function engagementBarrier(args) {
  const [operation, ...rest] = args;
  if (operation === 'arrive' && rest.includes('--json')) return engagementBarrierArriveBatch(rest);
  const options = parseNamedOptions(rest, new Set(['--manifest', '--lane', '--token', '--phase', '--reason']));
  const { manifest: engagement } = loadEngagement(options);
  if (operation === 'status') {
    console.log(JSON.stringify(getBarrierStatus(engagement, options.phase), null, 2));
    return 0;
  }
  if (operation === 'arrive') {
    requireOptions(options, ['lane', 'phase'], 'engagement barrier arrive');
    console.log(JSON.stringify(arriveBarrier(engagement, options.lane, leaseToken(options), options.phase)));
    return 0;
  }
  if (operation === 'advance') {
    requireOptions(options, ['lane'], 'engagement barrier advance');
    console.log(JSON.stringify(advanceBarrier(engagement, options.lane, leaseToken(options))));
    return 0;
  }
  if (operation === 'skip') {
    requireOptions(options, ['lane', 'reason'], 'engagement barrier skip');
    console.log(JSON.stringify(skipPhases(engagement, options.lane, leaseToken(options), options.reason)));
    return 0;
  }
  fail('usage: argus-assets engagement barrier <arrive|status|advance|skip> [options]');
}

function engagementCleanup(args) {
  if (args.includes('--json')) return engagementCleanupBatch(args);
  const options = parseNamedOptions(args, new Set(['--manifest', '--lane', '--token', '--outcome']));
  requireOptions(options, ['manifest', 'lane', 'outcome'], 'engagement cleanup');
  const { manifest: engagement } = loadEngagement(options);
  console.log(JSON.stringify(cleanupWorker(engagement, options.lane, leaseToken(options), options.outcome)));
  return 0;
}

// Controller batch verbs authenticate the argv controller token against the active Odysseus
// allocation before any entry is parsed or attempted, so a worker token is refused outright
// instead of producing one failure per entry. The runtime re-checks it, with the live lease marker, for
// every entry under the state lock.
function requireEngagementControllerToken(engagement, token, label) {
  if (!nonEmptyString(token)) fail(`${label} requires --controller-token`);
  const controller = getEngagementStatus(engagement).allocations?.odysseus;
  if (controller?.status !== 'active' || createHash('sha256').update(token).digest('hex') !== controller.leaseTokenSha256) {
    fail(`${label} requires the active Odysseus controller token`);
  }
}

// Batch arrival: the controller records up to 32 lanes' arrival at the current phase in one
// call. A worker lane arrives on controller authority with its live lease; Odysseus, whose
// lane token is the controller token, arrives on its own lease. Every lane is attempted
// independently, so one refusal never hides another lane's arrival.
function engagementBarrierArriveBatch(args) {
  const options = parseNamedOptions(args, new Set(['--manifest', '--phase', '--json', '--controller-token', '--lane', '--token', '--reason']));
  for (const forbidden of ['lane', 'token', 'reason']) {
    if (options[forbidden] !== undefined) fail(`batch engagement barrier arrive does not accept --${forbidden}; --json lists the lanes`);
  }
  requireOptions(options, ['manifest', 'phase', 'json'], 'batch engagement barrier arrive');
  const { manifest: engagement } = loadEngagement(options);
  requireEngagementControllerToken(engagement, options.controllerToken, 'batch engagement barrier arrive');
  if (!engagement.phasePlan.some((phase) => phase.id === options.phase)) fail(`batch engagement barrier arrive: unknown phase ${options.phase}`);
  const lanes = uniqueBatchValues(parseBatchJson(options.json, {
    label: 'batch engagement barrier arrive',
    root: 'lanes',
    max: 32,
    validateEntry: batchLane,
  }), 'batch engagement barrier arrive lanes');
  const results = [];
  const failed = [];
  for (const lane of lanes) {
    try {
      const arrival = lane === 'odysseus'
        ? arriveBarrier(engagement, lane, options.controllerToken, options.phase)
        : arriveBarrier(engagement, lane, undefined, options.phase, { controllerToken: options.controllerToken });
      results.push({ lane, authority: arrival.authority, arrived: true });
    } catch (error) {
      failed.push({ lane, error: error.message });
    }
  }
  console.log(JSON.stringify({
    schema: 'argus/engagement-barrier-batch@1',
    phase: options.phase,
    results,
    failed,
    barrier: getBarrierStatus(engagement, options.phase),
  }));
  return failed.length > 0 ? 1 : 0;
}

// Batch cleanup: the controller releases up to 32 worker lanes on controller authority in one
// call. Odysseus is refused because its terminal cleanup needs every worker released first; it
// stays a single-lane call on its own token. Every lane is attempted independently, and an
// already released lane replays idempotently with its recorded outcome.
function engagementCleanupBatch(args) {
  const options = parseNamedOptions(args, new Set(['--manifest', '--json', '--controller-token', '--lane', '--token', '--outcome']));
  for (const forbidden of ['lane', 'token', 'outcome']) {
    if (options[forbidden] !== undefined) fail(`batch engagement cleanup does not accept --${forbidden}; each --json entry names its lane and outcome`);
  }
  requireOptions(options, ['manifest', 'json'], 'batch engagement cleanup');
  const { manifest: engagement } = loadEngagement(options);
  requireEngagementControllerToken(engagement, options.controllerToken, 'batch engagement cleanup');
  const cleanups = parseBatchJson(options.json, {
    label: 'batch engagement cleanup',
    root: 'cleanups',
    max: 32,
    validateEntry: (entry, label) => {
      closedBatchEntry(entry, label, ['lane', 'outcome']);
      const lane = batchLane(entry.lane, `${label}.lane`);
      if (lane === 'odysseus') fail('batch engagement cleanup cannot clean odysseus; clean the controller alone with --lane odysseus --token after every worker is released');
      if (!['success', 'failure', 'interrupted'].includes(entry.outcome)) fail(`${label}.outcome must be success, failure, or interrupted`);
      return { lane, outcome: entry.outcome };
    },
  });
  uniqueBatchValues(cleanups.map((cleanup) => cleanup.lane), 'batch engagement cleanup lanes');
  const results = [];
  const failed = [];
  for (const { lane, outcome } of cleanups) {
    try {
      results.push(cleanupWorker(engagement, lane, undefined, outcome, { controllerToken: options.controllerToken }));
    } catch (error) {
      failed.push({ lane, outcome, error: error.message });
    }
  }
  console.log(JSON.stringify({ schema: 'argus/engagement-cleanup-batch@1', results, failed }));
  return failed.length > 0 ? 1 : 0;
}

// Conditional lanes wait on target or browser gates that recon may prove. The controller
// resolves them once, in discovery after Kalchas arrives. Kalchas's capability evidence is
// recon input, never authority: the runtime re-probes the browser runtime, re-checks source
// and suite paths itself, and matches protocol surfaces against the validated surface
// inventory. The runtime cannot re-verify database credentials or a service topology, so
// recon never releases db-access or multi-service; only an operator --feature at launch
// declares them. Every recorded reason is a fixed string, so no proof value reaches state.
function engagementResolveGates(args) {
  const options = parseNamedOptions(args, new Set(['--manifest', '--controller-token', '--evidence']));
  requireOptions(options, ['manifest'], 'engagement resolve-gates');
  const { manifest: engagement } = loadEngagement(options);
  const state = getEngagementStatus(engagement);
  if (!plainObject(state.conditionalAgents) || Object.keys(state.conditionalAgents).length === 0) {
    console.log('GATES  none');
    return 0;
  }
  const controllerToken = controllerCapabilityToken(options);
  if (!nonEmptyString(controllerToken)) fail('engagement resolve-gates requires --controller-token or ARGUS_ENGAGEMENT_CONTROLLER_TOKEN');
  const request = conditionalGateRequest(engagement, controllerToken);
  const artifactRoot = realpathSync(engagement.artifactRoot);
  const context = { engagement, artifactRoot, evidence: loadCapabilityEvidence(engagement, artifactRoot, options.evidence) };
  // Evidence-backed gates fail closed first, so a refused call never re-probes the browser.
  const ordered = [...request.capabilities.filter((id) => id !== 'browser-runtime'), ...request.capabilities.filter((id) => id === 'browser-runtime')];
  const capabilities = Object.fromEntries(ordered.map((id) => [id, resolveCapabilityGate(id, context)]));
  const gateResolution = resolveConditionalGates(engagement, controllerToken, { evidenceSha256: context.evidence.sha256, capabilities });
  const lanes = Object.keys(gateResolution.lanes);
  console.log(JSON.stringify({
    gateResolution,
    released: lanes.filter((lane) => gateResolution.lanes[lane] === 'released'),
    gateUnmet: lanes.filter((lane) => gateResolution.lanes[lane] === 'gate-unmet'),
  }));
  return 0;
}

// A missing evidence file is a recon result (every evidence-backed gate stays unmet); an
// aliased, malformed, or foreign file is refused without recording anything.
function loadCapabilityEvidence(engagement, artifactRoot, explicit) {
  const discoveryRoot = join(artifactRoot, 'solution', 'discovery');
  const path = resolve(artifactRoot, explicit ?? join('solution', 'discovery', 'capability-evidence.json'));
  if (path === discoveryRoot || !isWithin(discoveryRoot, path) || !safePhysicalPath(artifactRoot, path)) {
    fail('engagement resolve-gates: capability evidence must be a file under <artifactRoot>/solution/discovery without symbolic links');
  }
  if (!lstatSafe(path)) return { document: null, sha256: null };
  const raw = readSecureSingleLink(path, 'capability evidence');
  let document;
  try { document = JSON.parse(raw.toString('utf8')); }
  catch (error) { fail(`engagement resolve-gates: capability evidence is not valid JSON: ${error.message}`); }
  const errors = validateCanonicalDocument('capability-evidence', document);
  if (errors.length) fail(`engagement resolve-gates: capability evidence is invalid: ${errors.join('; ')}`);
  if (document.engagementId !== engagement.engagementId) fail('engagement resolve-gates: capability evidence belongs to another engagement');
  return { document, sha256: createHash('sha256').update(raw).digest('hex') };
}

function resolveCapabilityGate(id, context) {
  if (id === 'browser-runtime') return resolveBrowserRuntimeGate(context);
  if (id === 'source-access') return resolveRootGate(context, id, 'fileRead', { root: 'source root', file: 'read file' });
  if (id === 'existing-suite') return resolveRootGate(context, id, 'testFile', { root: 'suite root', file: 'test file' });
  if (id === 'non-rest-surface') return resolveSurfaceGate(context);
  if (id === 'db-access') {
    return gateVerdict('unmet', 'operator-feature-required',
      'recon cannot release db-access: database credentials are not re-verified by the runtime; the operator declares it with --feature db-access at launch');
  }
  if (id === 'multi-service') {
    return gateVerdict('unmet', 'operator-feature-required',
      'recon cannot release multi-service: the service topology is not re-verified by the runtime; the operator declares it with --feature multi-service at launch');
  }
  return gateVerdict('unmet', 'not-recon-provable', 'not recon-provable');
}

function gateVerdict(status, basis, reason) {
  return { status, basis, reason };
}

// The probe rewrites ai_agents_internal/browser-runtime.json, the record browser lanes read.
function resolveBrowserRuntimeGate({ engagement, artifactRoot }) {
  const probedAt = new Date().toISOString();
  const result = recordBrowserRuntime({
    artifactRootPath: artifactRoot,
    persist: true,
    engagementId: engagement.engagementId,
    probedAt,
    result: resolveBrowserRuntime({ targetPath: engagement.target.root, artifactRootPath: artifactRoot, profile: {}, probeAllowed: true, probedAt }),
  });
  return result.status === 'available'
    ? gateVerdict('proven', 'runtime-probe', 'the runtime probe launched headless Chromium; see ai_agents_internal/browser-runtime.json')
    : gateVerdict('unmet', 'runtime-probe', 'the runtime probe found no functional Playwright runtime; see ai_agents_internal/browser-runtime.json');
}

function provenReconGate({ evidence }, capability, basis) {
  if (!evidence.document) return { unmet: gateVerdict('unmet', basis, 'capability evidence file missing') };
  const gate = evidence.document.gates.find((item) => item.capability === capability);
  if (gate.verdict !== 'proven') return { unmet: gateVerdict('unmet', basis, `recon verdict is ${gate.verdict}`) };
  return { gate };
}

// Both proof paths are resolved physically: the root must be a readable directory disjoint
// from the worker-writable artifact root and inside the engagement target root when one is
// recorded, and the named file a readable regular file inside that root.
function resolveRootGate(context, capability, fileField, labels) {
  const basis = 'kalchas-evidence+path-check';
  const recorded = provenReconGate(context, capability, basis);
  if (recorded.unmet) return recorded.unmet;
  const { proof } = recorded.gate;
  const root = readablePhysicalEntry(proof.path, 'directory');
  if (!root) return gateVerdict('unmet', basis, `${labels.root} is not an existing readable directory`);
  if (isWithin(context.artifactRoot, root) || isWithin(root, context.artifactRoot)) {
    return gateVerdict('unmet', basis, `${labels.root} overlaps the artifact root`);
  }
  const targetRoot = context.engagement.target.root;
  if (targetRoot !== null) {
    const physicalTarget = readablePhysicalEntry(targetRoot, 'directory');
    if (!physicalTarget || !isWithin(physicalTarget, root)) return gateVerdict('unmet', basis, `${labels.root} is outside the engagement target root`);
  }
  const file = readablePhysicalEntry(proof[fileField], 'file');
  if (!file || file === root || !isWithin(root, file)) {
    return gateVerdict('unmet', basis, `${labels.file} is not a readable regular file inside the ${labels.root}`);
  }
  return gateVerdict('proven', basis, `${labels.root} and ${labels.file} re-checked by the runtime`);
}

function readablePhysicalEntry(path, kind) {
  if (typeof path !== 'string' || !path.startsWith('/')) return null;
  try {
    const physical = realpathSync(path);
    const stats = statSync(physical);
    if (kind === 'directory' ? !stats.isDirectory() : !stats.isFile()) return null;
    accessSync(physical, kind === 'directory' ? constants.R_OK | constants.X_OK : constants.R_OK);
    return physical;
  } catch {
    return null;
  }
}

function resolveSurfaceGate(context) {
  const basis = 'kalchas-evidence+inventory';
  const recorded = provenReconGate(context, 'non-rest-surface', basis);
  if (recorded.unmet) return recorded.unmet;
  const inventory = loadResolvedSurfaceInventory(context);
  if (!inventory) return gateVerdict('unmet', basis, 'validated surface inventory is missing');
  const known = new Set(inventory.items.map((item) => item.id));
  if (!recorded.gate.proof.surfaceIds.every((id) => known.has(id))) {
    return gateVerdict('unmet', basis, 'a recon surface id is absent from the validated surface inventory');
  }
  return gateVerdict('proven', basis, 'every recon surface id is present in the validated surface inventory');
}

// The canonical inventory is written only by Kalchas's validated merge, so a present but
// invalid or foreign document means tampering and is refused rather than read as unmet.
function loadResolvedSurfaceInventory({ engagement, artifactRoot }) {
  const path = join(artifactRoot, 'solution', 'surface-inventory.json');
  if (!safePhysicalPath(artifactRoot, path)) fail('engagement resolve-gates: solution/surface-inventory.json escapes the artifact root or crosses a symbolic link');
  if (!lstatSafe(path)) return null;
  const inventory = readSecureJson(path, 'surface inventory');
  const errors = validateCanonicalDocument('surface-inventory', inventory);
  if (errors.length) fail(`engagement resolve-gates: surface inventory is invalid: ${errors.join('; ')}`);
  if (inventory.engagementId !== engagement.engagementId) fail('engagement resolve-gates: surface inventory belongs to another engagement');
  return inventory;
}

function guardCommand(args) {
  if (args.length > 0) fail('usage: argus-assets guard');
  const raw = readFileSync(0, 'utf8');
  let payload;
  try { payload = JSON.parse(raw); }
  catch { return denyHook('GUARD-MANIFEST-INVALID', 'PreToolUse payload is not valid JSON'); }
  const cwd = resolve(payload.cwd ?? process.cwd());
  const manifestPath = locateEngagementManifest(cwd, process.env.ARGUS_ENGAGEMENT_MANIFEST);
  if (!manifestPath) return 0;
  let engagement;
  try { engagement = JSON.parse(readFileSync(manifestPath, 'utf8')); }
  catch { return denyHook('GUARD-MANIFEST-INVALID', 'engagement manifest is not valid JSON'); }
  const errors = validateEngagementManifest(engagement);
  if (errors.length > 0) return denyHook('GUARD-MANIFEST-INVALID', errors.join('; '));
  const decision = evaluateWriteGuard({
    manifest: engagement,
    manifestPath,
    payload,
    cwd,
    bypassToken: process.env.ARGUS_IMMUTABILITY_BYPASS_TOKEN,
  });
  if (decision.decision === 'deny' || decision.ruleId === 'GUARD-EXPLICIT-BYPASS') {
    const patterns = readJson(REDACTION_PATTERNS_PATH);
    const event = redactValue(buildGuardAudit({ manifest: engagement, payload, decision, timestamp: new Date().toISOString() }), patterns).value;
    const auditPath = resolve(engagement.artifactRoot, engagement.writePolicy.auditPath);
    if (!safePhysicalPath(engagement.artifactRoot, auditPath)) return denyHook('GUARD-MANIFEST-INVALID', 'guard audit path escapes its physical artifact root or crosses a symbolic link');
    mkdirSync(dirname(auditPath), { recursive: true });
    atomicPrivateAppend(auditPath, `${JSON.stringify(event)}\n`);
  }
  if (decision.decision === 'deny') return denyHook(decision.ruleId, `${decision.reason}; audit=${engagement.writePolicy.auditPath}`);
  return 0;
}

function denyHook(ruleId, reason) {
  console.log(JSON.stringify({
    hookSpecificOutput: {
      hookEventName: 'PreToolUse',
      permissionDecision: 'deny',
      permissionDecisionReason: `${ruleId}: ${String(reason).replace(/[\r\n]+/g, ' ')}`,
    },
  }));
  return 0;
}

function initializeAuthorization(args) {
  const options = parseNamedOptions(args, new Set(['--target', '--environment', '--output', '--engagement-id']));
  if (!options.target) fail('authorization init requires --target');
  const environment = options.environment ?? 'unknown';
  if (!['unknown', 'development', 'test', 'staging', 'production'].includes(environment)) {
    fail('authorization init --environment must be unknown, development, test, staging, or production');
  }
  const output = resolve(options.output ?? 'ai_agents_internal/authorization.json');
  if (!safePhysicalPath(process.cwd(), output)) fail('authorization manifest path escapes the physical working root or crosses a symbolic link');
  if (existsSync(output)) fail(`refusing to overwrite existing authorization manifest: ${output}`);
  const template = readJson(AUTHORIZATION_TEMPLATE_PATH);
  const targetPath = statSafe(resolve(options.target)) ? resolve(options.target) : null;
  const targetIdentifier = targetPath ?? (/^https?:\/\//i.test(options.target) ? new URL(options.target).toString() : options.target);
  const authorization = createDefaultAuthorization({
    template,
    target: targetIdentifier,
    environment,
    engagementId: options.engagementId,
  });
  const errors = validateAuthorizationManifest(authorization);
  if (errors.length > 0) fail(`generated authorization manifest is invalid: ${errors.join('; ')}`);
  mkdirSync(dirname(output), { recursive: true });
  writeFileSync(output, `${JSON.stringify(authorization, null, 2)}\n`, { mode: 0o600 });
  chmodSync(output, 0o600);
  console.log(`AUTHORIZATION  initialized default-deny manifest=${output} sha256=${manifestSha256(authorization)}`);
  return 0;
}

function checkAuthorization(args) {
  const options = parseNamedOptions(args, new Set([
    '--manifest', '--lane', '--action', '--target', '--source-trust', '--account',
    '--namespace', '--mutation', '--classification', '--rate', '--concurrency',
    '--total-requests', '--duration', '--resource', '--at', '--binary-reviewed',
  ]));
  for (const required of ['manifest', 'lane', 'action', 'target', 'sourceTrust']) {
    if (!options[required]) fail(`authorization check requires --${camelToKebab(required)}`);
  }
  // Binary-evidence reviews bind to the audit timestamp, so an engagement never back-dates it.
  if (options.at && locateEngagementManifest(process.cwd(), process.env.ARGUS_ENGAGEMENT_MANIFEST)) {
    fail('authorization check --at is a test-only clock override and is refused while an engagement is active');
  }
  const manifestPath = resolve(options.manifest);
  if (!statSafe(manifestPath)?.isFile() || lstatSync(manifestPath).isSymbolicLink()) fail('authorization manifest must be a real file');
  const authorization = readSecureJson(manifestPath, 'authorization manifest');
  const patterns = readJson(REDACTION_PATTERNS_PATH);
  const patternErrors = validateRedactionPatterns(patterns);
  if (patternErrors.length > 0) fail(`packaged redaction patterns are invalid: ${patternErrors.join('; ')}`);
  const request = {
    lane: options.lane,
    action: options.action,
    target: options.target,
    sourceTrust: options.sourceTrust,
    account: options.account,
    namespace: options.namespace,
    mutation: options.mutation,
    classification: options.classification,
    binaryReviewed: parseBooleanOption(options.binaryReviewed, '--binary-reviewed'),
    rate: parsePositiveOption(options.rate, '--rate'),
    concurrency: parsePositiveOption(options.concurrency, '--concurrency'),
    totalRequests: parsePositiveOption(options.totalRequests, '--total-requests'),
    duration: parsePositiveOption(options.duration, '--duration'),
    resource: options.resource,
  };
  const timestamp = options.at ?? new Date().toISOString();
  const decision = evaluateAuthorization({ manifest: authorization, request, now: timestamp });
  const auditName = nonEmptyString(authorization.audit?.path) && !authorization.audit.path.includes('/')
    ? authorization.audit.path
    : 'authorization-audit.jsonl';
  const auditPath = resolve(dirname(manifestPath), auditName);
  if (!safePhysicalPath(dirname(manifestPath), auditPath)) fail('authorization audit path crosses a symbolic link');
  const auditManifest = { ...authorization, engagementId: authorization.engagementId ?? 'INVALID-MANIFEST' };
  const event = buildAuditEvent({ manifest: auditManifest, request, decision, timestamp, patterns });
  atomicPrivateAppend(auditPath, `${JSON.stringify(event)}\n`);
  const safeReason = redactText(decision.reason, patterns).text.replace(/[\r\n]+/g, ' ');
  console.log(`AUTHORIZATION  ${decision.decision.toUpperCase()} rule=${decision.ruleId} reason=${safeReason} audit=${auditPath} at=${event.timestamp}`);
  return decision.decision === 'allow' ? 0 : 3;
}

// Host-side operator verbs that argus-launch runs before the OS sandbox starts. Both bind the
// operator's manifest (--manifest) or the default-deny manifest for an operator environment
// (--environment) to one engagement id and launch target. `verify` never writes; `install`
// places the manifest at <artifact-root>/ai_agents_internal/authorization.json with mode 0600,
// where preflight loads it. The PreToolUse guard denies every authorization verb except
// `check` inside an engagement, and the evaluator still decides every action: installing a
// manifest never widens what it denies.
function verifyOperatorAuthorization(args) {
  const prepared = prepareOperatorAuthorization(args, 'verify');
  reportOperatorAuthorization('verified', prepared);
  return 0;
}

function installOperatorAuthorization(args) {
  const prepared = prepareOperatorAuthorization(args, 'install');
  if (prepared.installed) {
    reportOperatorAuthorization('unchanged', prepared);
    return 0;
  }
  mkdirSync(dirname(prepared.destination), { recursive: true, mode: 0o700 });
  if (!safePhysicalPath(prepared.artifactRoot, prepared.destination)) {
    fail('authorization manifest destination escapes the artifact root or crosses a symbolic link');
  }
  try {
    writeFileSync(prepared.destination, prepared.raw, { mode: 0o600, flag: 'wx' });
  } catch (error) {
    if (error.code === 'EEXIST') fail(`an authorization manifest appeared at ${prepared.destination} during installation; refusing to replace it`);
    fail(`cannot install the authorization manifest: ${error.message}`);
  }
  chmodSync(prepared.destination, 0o600);
  reportOperatorAuthorization('installed', prepared);
  return 0;
}

function prepareOperatorAuthorization(args, operation) {
  const command = `authorization ${operation}`;
  const options = parseNamedOptions(args, new Set(['--artifact-root', '--engagement-id', '--target', '--manifest', '--environment']));
  requireOptions(options, ['artifactRoot', 'engagementId', 'target'], command);
  if (!options.manifest && !options.environment) fail(`${command} requires --manifest, --environment, or both`);
  if (options.environment !== undefined && !['unknown', 'development', 'test', 'staging', 'production'].includes(options.environment)) {
    fail(`${command} --environment must be unknown, development, test, staging, or production`);
  }
  requireStableIdentifier(options.engagementId, `${command} --engagement-id`);
  const target = identifyTarget(options.target);
  const artifactRoot = options.artifactRoot;
  if (!artifactRoot.startsWith('/') || resolve(artifactRoot) !== artifactRoot) fail(`${command} --artifact-root must be an absolute normalized path`);
  // verify runs before the launcher creates the artifact root; install requires it.
  const artifactRootExists = lstatPresent(artifactRoot);
  if (artifactRootExists || operation === 'install') existingPhysicalDirectory(artifactRoot, `${command} artifact root`);
  if (target.targetPath && (isWithin(target.targetPath, artifactRoot) || isWithin(artifactRoot, target.targetPath))) {
    fail(`${command} target and artifact root must be physically disjoint`);
  }
  const destination = join(artifactRoot, 'ai_agents_internal', 'authorization.json');
  if (artifactRootExists && !safePhysicalPath(artifactRoot, destination)) {
    fail('authorization manifest destination escapes the artifact root or crosses a symbolic link');
  }
  const binding = { engagementId: options.engagementId, targetIdentity: target.targetIdentity, environment: options.environment };

  let source;
  let raw;
  let authorization;
  if (options.manifest) {
    source = 'operator';
    const manifestPath = existingPhysicalFile(options.manifest, 'operator authorization manifest');
    if (isWithin(artifactRoot, manifestPath) || (target.targetPath && isWithin(target.targetPath, manifestPath))) {
      fail('operator authorization manifest must stay outside the target and artifact roots');
    }
    requireSecureOperatorInput(manifestPath, 'operator authorization manifest');
    raw = readSecureSingleLink(manifestPath, 'operator authorization manifest');
    try { authorization = JSON.parse(raw.toString('utf8')); }
    catch (error) { fail(`operator authorization manifest is not valid JSON: ${error.message}`); }
    const errors = operatorAuthorizationBindingErrors(authorization, binding);
    if (errors.length > 0) fail(`operator authorization manifest ${errors.join('; ')}`);
  } else {
    source = 'environment';
    authorization = createDefaultAuthorization({
      template: readJson(AUTHORIZATION_TEMPLATE_PATH),
      target: target.targetIdentity,
      environment: options.environment,
      engagementId: options.engagementId,
    });
    const errors = operatorAuthorizationBindingErrors(authorization, binding);
    if (errors.length > 0) fail(`generated authorization manifest ${errors.join('; ')}`);
    raw = Buffer.from(`${JSON.stringify(authorization, null, 2)}\n`, 'utf8');
  }

  // An existing manifest is kept only when it is the same manifest (same canonical digest), so
  // a relaunch with the same choice is idempotent. Anything else, including a more permissive
  // manifest from an earlier launch, is refused: the launcher never replaces a manifest.
  let installed = false;
  if (artifactRootExists && lstatPresent(destination)) {
    const current = readSecureSingleLink(destination, 'existing authorization manifest');
    let existing = null;
    try { existing = JSON.parse(current.toString('utf8')); } catch { existing = null; }
    const same = existing !== null && manifestSha256(existing) === manifestSha256(authorization);
    if (!same) {
      fail(`a different authorization manifest already exists at ${destination}; remove it or launch into an empty artifact root`);
    }
    installed = true;
  }
  return { source, raw, authorization, artifactRoot, destination, installed };
}

function operatorAuthorizationBindingErrors(authorization, { engagementId, targetIdentity, environment }) {
  const schemaErrors = compileJsonSchema(readJson(AUTHORIZATION_MANIFEST_SCHEMA_PATH))(authorization);
  if (schemaErrors.length > 0) return [`does not satisfy its schema: ${formatSchemaErrors(schemaErrors)}`];
  const errors = validateAuthorizationManifest(authorization);
  if (errors.length > 0) return [`is invalid: ${errors.join('; ')}`];
  if (authorization.engagementId !== engagementId) return ['engagementId differs from the launch engagement id'];
  if (environment !== undefined && authorization.target.environment !== environment) {
    return [`target.environment ${authorization.target.environment} differs from the requested environment ${environment}`];
  }
  // The same read the preflight boundary probe evaluates: the manifest must cover the target.
  const decision = evaluateAuthorization({
    manifest: authorization,
    request: { lane: 'odysseus', action: 'read', target: targetIdentity, sourceTrust: 'manifest' },
  });
  if (decision.decision !== 'allow') return [`does not allow the preflight boundary read of the launch target (${decision.ruleId}: ${decision.reason})`];
  return [];
}

function reportOperatorAuthorization(status, prepared) {
  console.log(`AUTHORIZATION  ${status} source=${prepared.source} environment=${prepared.authorization.target.environment} sha256=${manifestSha256(prepared.authorization)} manifest=${prepared.destination}`);
}

function lstatPresent(path) {
  try { lstatSync(path); return true; }
  catch { return false; }
}

function redactCommand(args) {
  const options = parseNamedOptions(args, new Set(['--input', '--output']));
  const input = options.input ?? '-';
  const output = options.output ?? '-';
  const buffer = input === '-' ? readFileSync(0) : readFileSync(resolve(input));
  if (isBinaryBuffer(buffer)) {
    console.error('REDACTION  DENY rule=AUTH-REDACTION-REQUIRED reason=binary evidence requires approved masking and independent review');
    return 4;
  }
  const patterns = readJson(REDACTION_PATTERNS_PATH);
  const errors = validateRedactionPatterns(patterns);
  if (errors.length > 0) fail(`packaged redaction patterns are invalid: ${errors.join('; ')}`);
  const source = buffer.toString('utf8');
  let redacted;
  let findings;
  try {
    const parsed = JSON.parse(source);
    const result = redactValue(parsed, patterns);
    redacted = `${JSON.stringify(result.value, null, 2)}\n`;
    findings = result.findings;
  } catch {
    const result = redactText(source, patterns);
    redacted = result.text;
    findings = result.findings;
  }
  if (output === '-') {
    process.stdout.write(redacted);
  } else {
    const outputPath = resolve(output);
    assertActiveEngagementWrites([outputPath], 'redaction output');
    mkdirSync(dirname(outputPath), { recursive: true });
    atomicPrivateWrite(outputPath, redacted);
    console.log(`REDACTION  wrote=${outputPath} findings=${findings.length}`);
  }
  return 0;
}

function printPath(id) {
  const asset = requireAsset(id);
  console.log(assetPath(asset));
}

function verify() {
  try {
    const stats = verifyRuntimeAssets();
    console.log(`PASS  ${stats.assets} assets verified (${stats.assetBytes} bytes); plugin ${stats.pluginBytes} bytes`);
  } catch (error) {
    fail(error.message);
  }
}

function verifyRuntimeAssets() {
  let assetBytes = 0;
  for (const asset of manifest.assets) {
    const path = assetPath(asset);
    if (!existsSync(path)) throw new Error(`missing packaged asset: ${asset.id} (${asset.destination})`);
    const stats = treeStats(path);
    if (stats.files !== asset.files || stats.bytes !== asset.bytes || stats.sha256 !== asset.sha256) {
      throw new Error(`packaged asset hash mismatch: ${asset.id}`);
    }
    assetBytes += stats.bytes;
  }
  if (assetBytes > manifest.budgets.generatedAssetsBytes) {
    throw new Error(`generated asset budget exceeded: ${assetBytes} > ${manifest.budgets.generatedAssetsBytes}`);
  }
  const pluginBytes = treeStats(ROOT).bytes;
  if (pluginBytes > manifest.budgets.installedPluginBytes) {
    throw new Error(`installed plugin budget exceeded: ${pluginBytes} > ${manifest.budgets.installedPluginBytes}`);
  }
  loadVerifiedRuntimeInventory();
  return { assets: manifest.assets.length, assetBytes, pluginBytes };
}

function loadVerifiedRuntimeInventory() {
  if (!existsSync(INVENTORY_PATH)) throw new Error('missing runtime-reference-inventory.json');
  const buffer = readFileSync(INVENTORY_PATH);
  const metadata = manifest.inventory;
  if (!metadata || metadata.path !== 'runtime-reference-inventory.json' || metadata.schemaVersion !== 2) {
    throw new Error('runtime inventory metadata is missing or invalid');
  }
  const digest = createHash('sha256').update(buffer).digest('hex');
  if (metadata.bytes !== buffer.length || metadata.sha256 !== digest) {
    throw new Error('runtime inventory differs from the packaged manifest');
  }
  let inventory;
  try {
    inventory = JSON.parse(buffer.toString('utf8'));
  } catch (error) {
    throw new Error(`cannot parse runtime inventory: ${error.message}`);
  }
  const counts = [
    ['agentsScanned', 27],
    ['skillsScanned', 7],
    ['entrypointsScanned', 1],
  ];
  for (const [field, expected] of counts) {
    if (inventory[field] !== expected) throw new Error(`runtime inventory ${field} is ${inventory[field]}; expected ${expected}`);
  }
  if (inventory.schemaVersion !== 2 || inventory.generatedFrom !== 'all packaged Argus agents, skills, entrypoints, capability declarations, runtime imports, hooks, CLI commands, and template compositions') {
    throw new Error('runtime inventory v2 identity is invalid');
  }
  for (const field of ['runtimeFilesScanned', 'runtimeImportsScanned', 'hooksScanned']) {
    if (!Number.isInteger(inventory[field]) || inventory[field] < 1) {
      throw new Error(`runtime inventory ${field} must be a positive integer`);
    }
  }
  for (const field of [
    'unconsumedAssets',
    'unknownAssetReferences',
    'unknownProfileReferences',
    'unownedPluginReferences',
    'unownedRuntimeReferences',
    'unownedSkills',
  ]) {
    if (!Array.isArray(inventory[field]) || inventory[field].length !== 0) {
      throw new Error(`runtime inventory ${field} must be an empty array`);
    }
  }
  for (const field of ['pluginAssetReferences', 'targetFileReferences', 'commandReferences']) {
    if (!Array.isArray(inventory[field]) || inventory[field].some((record) =>
      !nonEmptyString(record?.value) || !Array.isArray(record.consumers) || record.consumers.length === 0 ||
      record.consumers.some((consumer) => !nonEmptyString(consumer)))) {
      throw new Error(`runtime inventory ${field} is malformed`);
    }
  }
  if (!Array.isArray(inventory.assetConsumers) || inventory.assetConsumers.length !== manifest.assets.length) {
    throw new Error('runtime inventory asset consumer count differs from the manifest');
  }
  const expectedAssets = new Map(manifest.assets.map((asset) => [asset.id, asset.destination]));
  const seenAssets = new Set();
  for (const record of inventory.assetConsumers) {
    if (!expectedAssets.has(record?.assetId) || expectedAssets.get(record.assetId) !== record.destination ||
        seenAssets.has(record.assetId) || !Array.isArray(record.consumers) || record.consumers.length === 0) {
      throw new Error(`runtime inventory has an invalid asset consumer record: ${record?.assetId ?? '(missing)'}`);
    }
    seenAssets.add(record.assetId);
  }
  const coreReference = inventory.pluginAssetReferences.find((record) =>
    record.value === 'skills/orchestration-core/SKILL.md');
  if (!coreReference?.consumers.includes('/argus:run')) {
    throw new Error('runtime inventory does not bind /argus:run to orchestration-core');
  }
  return inventory;
}

function inspectNativeLaunchForPreflight({ options, modelRuntime, mode, targetKind, targetIdentity, artifactRootPath, engagementId }) {
  if (modelRuntime !== 'claude') return { ready: false, evidence: 'native launch authorization is available only for Claude runtime' };
  try {
    if (!options.launchAuthorization || !options.launchReceipt || !options.trustStore) {
      throw new Error('signed launch authorization, verified receipt, and public trust store are required');
    }
    const authorizationPath = strictPhysicalInput(options.launchAuthorization, 'native launch authorization');
    const receiptPath = strictPhysicalInput(options.launchReceipt, 'native launch receipt');
    const trustStorePath = strictPhysicalInput(options.trustStore, 'native launch trust store');
    const expectedReceipt = join(artifactRootPath, 'ai_agents_internal', 'native-launch-receipt.json');
    if (receiptPath !== expectedReceipt || !safePhysicalPath(artifactRootPath, receiptPath)) {
      throw new Error('native launch receipt is outside the exact engagement control path');
    }
    const authorization = JSON.parse(readFileSync(authorizationPath, 'utf8'));
    const receipt = JSON.parse(readFileSync(receiptPath, 'utf8'));
    const trustStoreRaw = readFileSync(trustStorePath);
    const trustStore = JSON.parse(trustStoreRaw.toString('utf8'));
    const authorizationErrors = validateNativeLaunchAuthorizationSchema(authorization);
    if (authorizationErrors.length) throw new Error(`authorization schema: ${formatSchemaErrors(authorizationErrors)}`);
    const receiptErrors = validateNativeLaunchReceiptSchema(receipt);
    if (receiptErrors.length) throw new Error(`receipt schema: ${formatSchemaErrors(receiptErrors)}`);
    const trustErrors = validateModelTrustStoreSchema(trustStore);
    if (trustErrors.length) throw new Error(`trust-store schema: ${formatSchemaErrors(trustErrors)}`);
    if (authorization.maxTurns !== controllerMaxTurns()) {
      throw new Error('native launch authorization turn cap differs from the packaged model-policy controller cap');
    }
    const artifactStats = lstatSync(artifactRootPath);
    const artifactUid = typeof process.getuid === 'function' ? process.getuid() : artifactStats.uid;
    if (!artifactStats.isDirectory() || artifactStats.isSymbolicLink() || realpathSync(artifactRootPath) !== artifactRootPath ||
        artifactStats.uid !== artifactUid || (artifactStats.mode & 0o022) !== 0) {
      throw new Error('artifact root is not a physical current-user-owned directory with safe permissions');
    }
    const trustStats = lstatSync(trustStorePath);
    const trustDirectoryStats = lstatSync(dirname(trustStorePath));
    const uid = typeof process.getuid === 'function' ? process.getuid() : null;
    if (trustStats.isSymbolicLink() || !trustStats.isFile() || trustStats.nlink !== 1 ||
        trustDirectoryStats.isSymbolicLink() || !trustDirectoryStats.isDirectory() ||
        realpathSync(trustStorePath) !== trustStorePath || realpathSync(dirname(trustStorePath)) !== dirname(trustStorePath) ||
        (uid !== null && (trustStats.uid !== uid || trustDirectoryStats.uid !== uid)) ||
        (trustStats.mode & 0o133) !== 0 || (trustDirectoryStats.mode & 0o022) !== 0) {
      throw new Error('native launch trust store path or permissions are unsafe');
    }
    if (isWithin(artifactRootPath, trustStorePath) || (targetKind === 'path' && isWithin(targetIdentity, trustStorePath))) {
      throw new Error('native launch trust store entered the target or artifact boundary');
    }
    const trustRecord = trustStore.keys.find((record) => record.keyId === authorization.authentication.keyId);
    if (!trustRecord || trustRecord.status !== 'active' || trustRecord.purpose !== 'runtime-attestation') {
      throw new Error('native launch runtime-attestation anchor is missing or revoked');
    }
    const runtimeFingerprint = modelPublicKeyFingerprint(trustRecord.publicKeyPem);
    const pinnedRuntimeKey = {
      keyId: trustRecord.keyId,
      purpose: trustRecord.purpose,
      subjectId: trustRecord.subjectId,
      algorithm: 'Ed25519',
      publicKeyPem: trustRecord.publicKeyPem,
      keyFingerprintSha256: runtimeFingerprint,
    };
    const authentication = verifyNativeLaunchAuthorization(authorization, pinnedRuntimeKey);
    const now = Date.now();
    const issuedAt = Date.parse(authorization.issuedAt);
    const expiresAt = Date.parse(authorization.expiresAt);
    if (!Number.isFinite(issuedAt) || !Number.isFinite(expiresAt) || expiresAt <= issuedAt || expiresAt - issuedAt > 300_000 ||
        issuedAt > now + 30_000 || expiresAt <= now) {
      throw new Error('native launch authorization is stale or has an invalid validity window');
    }
    if (authorization.mode !== mode || authorization.targetKind !== targetKind || authorization.target !== targetIdentity ||
        authorization.artifactRoot !== artifactRootPath || authorization.engagementId !== engagementId) {
      throw new Error('native launch authorization differs from the current engagement coordinates');
    }
    const currentWorkspace = realpathSync(process.cwd());
    if (authorization.workspace !== currentWorkspace) throw new Error('native launch workspace differs from the sandbox working directory');
    const authorizationSha256 = modelAuthenticatedDocumentSha256(authorization);
    const trustStoreSha256 = createHash('sha256').update(trustStoreRaw).digest('hex');
    const receiptBindings = {
      launchId: authorization.launchId,
      engagementId: authorization.engagementId,
      launcherPid: authorization.launcherPid,
      launchCapabilitySha256: authorization.launchCapabilitySha256,
      authorizationPath,
      authorizationSha256,
      trustStorePath,
      trustStoreSha256,
      runtimeKeyId: authentication.keyId,
      runtimeKeyFingerprintSha256: authentication.keyFingerprintSha256,
      targetKind,
      target: targetIdentity,
      workspace: authorization.workspace,
      artifactRoot: artifactRootPath,
      mode,
      runtime: authorization.runtime,
      model: authorization.model,
      effort: authorization.effort,
      maxTurns: authorization.maxTurns,
      launcherExecutable: authorization.launcherExecutable,
      launcherSha256: authorization.launcherSha256,
      claudeExecutable: authorization.claudeExecutable,
      claudeExecutableSha256: authorization.claudeExecutableSha256,
      claudeVersion: authorization.claudeVersion,
      sandboxPolicy: authorization.sandboxPolicy,
      sandboxProbePath: authorization.sandboxProbePath,
      sandboxProbeDevice: authorization.sandboxProbeDevice,
      sandboxProbeInode: authorization.sandboxProbeInode,
      sandboxProbeUid: authorization.sandboxProbeUid,
      sandboxProbeMode: authorization.sandboxProbeMode,
      environmentPolicy: authorization.environmentPolicy,
      expiresAt: authorization.expiresAt,
    };
    for (const [field, expected] of Object.entries(receiptBindings)) {
      if (receipt[field] !== expected) throw new Error(`native launch receipt ${field} binding differs from signed authorization`);
    }
    if (Date.parse(receipt.verifiedAt) < issuedAt || Date.parse(receipt.verifiedAt) > now + 30_000) {
      throw new Error('native launch receipt verification time is invalid');
    }
    if (sha256File(strictPhysicalInput(authorization.launcherExecutable, 'authorized launcher executable')) !== authorization.launcherSha256) {
      throw new Error('authorized launcher executable changed after verification');
    }
    const claudeExecutable = strictPhysicalInput(authorization.claudeExecutable, 'authorized Claude executable');
    if (sha256File(claudeExecutable) !== authorization.claudeExecutableSha256 || claudeExecutableVersion(claudeExecutable) !== authorization.claudeVersion) {
      throw new Error('authorized Claude executable or version changed after verification');
    }
    const sandboxProbePath = strictPhysicalDirectoryInput(authorization.sandboxProbePath, 'authorized sandbox probe');
    if (isWithin(artifactRootPath, sandboxProbePath) || (targetKind === 'path' && isWithin(targetIdentity, sandboxProbePath))) {
      throw new Error('authorized sandbox probe entered the target or artifact boundary');
    }
    const sandboxProbeStats = lstatSync(sandboxProbePath);
    const sandboxProbeBindings = {
      sandboxProbeDevice: sandboxProbeStats.dev,
      sandboxProbeInode: sandboxProbeStats.ino,
      sandboxProbeUid: sandboxProbeStats.uid,
      sandboxProbeMode: sandboxProbeStats.mode & 0o777,
    };
    for (const [field, current] of Object.entries(sandboxProbeBindings)) {
      if (authorization[field] !== current) throw new Error(`authorized sandbox probe ${field} identity changed after verification`);
    }
    if ((sandboxProbeStats.mode & 0o777) !== 0o700 || readdirSync(sandboxProbePath).length !== 0) {
      throw new Error('authorized sandbox probe is not an empty mode-0700 directory');
    }
    if (directoryIsWritable(sandboxProbePath)) {
      throw new Error('OS sandbox is not active: signed host-writable probe remains writable');
    }
    if (!directoryIsWritable(artifactRootPath)) {
      throw new Error('OS sandbox does not permit the contracted artifact root');
    }
    const expectedEnvironment = {
      ARGUS_MODEL_TRUST_STORE: trustStorePath,
      ARGUS_NATIVE_LAUNCH_AUTHORIZATION: authorizationPath,
      ARGUS_NATIVE_LAUNCH_RECEIPT: receiptPath,
    };
    for (const [name, expected] of Object.entries(expectedEnvironment)) {
      if (process.env[name] !== expected) throw new Error(`${name} does not match the signed launcher binding`);
    }
    const capability = process.env.ARGUS_NATIVE_LAUNCH_CAPABILITY;
    if (!/^[a-f0-9]{64}$/.test(capability ?? '')) throw new Error('native launch capability is missing or malformed');
    if (createHash('sha256').update(capability).digest('hex') !== authorization.launchCapabilitySha256) {
      throw new Error('native launch capability does not match the signed authorization');
    }
    expectedEnvironment.ARGUS_NATIVE_LAUNCH_CAPABILITY = capability;
    const unexpectedArgus = Object.keys(process.env).filter((name) => name.startsWith('ARGUS_') && !Object.hasOwn(expectedEnvironment, name));
    if (unexpectedArgus.length) throw new Error(`unapproved inherited Argus environment: ${unexpectedArgus.sort().join(',')}`);
    return {
      ready: true,
      evidence: `authenticated launch ${authorization.launchId}; signer=${authorization.issuedBy}; claude=${authorization.claudeVersion}; model=opus effort=max maxTurns=${authorization.maxTurns}; sandbox=${authorization.sandboxPolicy}; environment=${authorization.environmentPolicy}`,
    };
  } catch (error) {
    return { ready: false, evidence: `authenticated native launch unavailable: ${error.message}` };
  }
}

function strictPhysicalInput(value, label) {
  if (typeof value !== 'string' || !value.startsWith('/') || resolve(value) !== value) throw new Error(`${label} path is not absolute and normalized`);
  const stats = lstatSync(value);
  if (!stats.isFile() || stats.isSymbolicLink() || stats.nlink !== 1 || realpathSync(value) !== value) {
    throw new Error(`${label} is not a physical single-link file`);
  }
  return value;
}

function strictPhysicalDirectoryInput(value, label) {
  if (typeof value !== 'string' || !value.startsWith('/') || resolve(value) !== value) throw new Error(`${label} path is not absolute and normalized`);
  const stats = lstatSync(value);
  if (!stats.isDirectory() || stats.isSymbolicLink() || realpathSync(value) !== value) {
    throw new Error(`${label} is not a physical directory`);
  }
  return value;
}

// --unattested-launch is honoured only for a run that provably could not have been
// attested. The decisive check is hostAttestationMaterial(): it reads the host trust
// store and the attested launcher's environment bindings, both outside the engagement
// artifact root and therefore outside the sandbox write grant an in-sandbox controller
// holds, so a controller launched attested cannot reach keyless mode by dropping the
// three signed coordinates from the command it composes. ARGUS_LAUNCH_UNATTESTED=1 is
// additionally required: it is the unattested launcher's own positive signal (exported
// by argus-launch --unattested into an `env -i` child), and an operator running preflight
// by hand on a keyless host sets it explicitly.
function requireUnattestedLaunchPreconditions({ options, modelRuntime, nativeLaunch, artifactRootPath }) {
  if (process.env.ARGUS_LAUNCH_UNATTESTED !== '1') {
    fail('--unattested-launch requires the unattested launcher signal ARGUS_LAUNCH_UNATTESTED=1; it is exported only by argus-launch --unattested, or set explicitly by an operator running preflight on a keyless host');
  }
  if (modelRuntime !== 'claude') {
    fail('--unattested-launch is claude-only: the Codex CLI exposes no native hard turn cap, so its mandatory native-host-execution check can never be waived');
  }
  for (const [key, flag] of [['trustStore', '--trust-store'], ['launchAuthorization', '--launch-authorization'], ['launchReceipt', '--launch-receipt']]) {
    if (options[key]) fail(`--unattested-launch cannot be combined with ${flag}: signed launch coordinates mean attestation is available`);
  }
  if (nativeLaunch.ready) {
    fail('--unattested-launch refused: this launch is authenticated and attestation is available; rerun preflight without the flag');
  }
  const material = hostAttestationMaterial();
  if (material) {
    fail(`--unattested-launch refused: ${material}; keyless mode exists only for a host with no resolvable operator key material — present the signed launch coordinates and run attested instead`);
  }
  const receiptPath = join(artifactRootPath, 'ai_agents_internal', 'native-launch-receipt.json');
  if (lstatSafe(receiptPath)) {
    fail(`--unattested-launch refused: an attested native-launch receipt exists at ${receiptPath}, so this artifact root belongs to an authenticated launch`);
  }
}

// Odysseus's first allocation seals ai_agents_internal/preflight.json by digest, and every
// later allocation and retry re-checks that digest. Rewriting the report would silently
// change the sealed dispatchable and conditional projection, so a sealed engagement refuses
// before any probe or write. A diagnostic report under another output path stays allowed.
// The resolved output mirrors the preflight fallback: an unsafe --output falls back to the
// sealed report, and an existing alias (for example a case variant) is caught by identity.
function refuseSealedPreflightRewrite(artifactRootPath, output) {
  const controlRoot = join(artifactRootPath, 'ai_agents_internal');
  if (!lstatSafe(join(controlRoot, 'model-control-seal.json'))) return;
  const sealedReport = join(controlRoot, 'preflight.json');
  const requested = resolve(artifactRootPath, output ?? 'ai_agents_internal/preflight.json');
  const requestedSafe = isWithin(artifactRootPath, requested) && safePhysicalPath(artifactRootPath, requested);
  const effective = requestedSafe ? requested : sealedReport;
  const effectiveStats = statSafe(effective);
  const sealedStats = statSafe(sealedReport);
  const sameEntry = Boolean(effectiveStats && sealedStats && effectiveStats.dev === sealedStats.dev && effectiveStats.ino === sealedStats.ino);
  if (effective === sealedReport || sameEntry) {
    fail('preflight.json is sealed by the model-control seal; release conditional lanes with `argus-assets engagement resolve-gates`, never by rerunning preflight');
  }
}

async function preflight(argv) {
  assertTrustedModelRoutingAssets();
  const options = parsePreflightOptions(argv);
  let inventory;
  try {
    inventory = loadVerifiedRuntimeInventory();
  } catch (error) {
    fail(error.message);
  }
  const profile = options.profile ? readJson(resolve(options.profile)) : {};
  assertBrowserRuntimeProfile(profile);
  const mode = options.mode ?? 'A';
  const modelRuntime = options.modelRuntime ?? 'claude';
  if (!['A', 'B', 'C', 'D'].includes(mode)) fail('preflight --mode must be A, B, C, or D');
  if (!['claude', 'codex'].includes(modelRuntime)) fail('preflight --model-runtime must be claude or codex');
  if (!options.target) fail('preflight requires --target <url-or-path>');
  const selectedSlugs = new Set(matrix.agents.filter((agent) => agent.modes.includes(mode)).map((agent) => agent.slug));
  for (const feature of options.features) {
    if (!Object.hasOwn(matrix.capabilities, feature)) fail(`unknown preflight feature: ${feature}`);
  }

  const targetDescriptor = identifyTarget(options.target);
  const { kind: targetKind, targetPath, targetIdentity } = targetDescriptor;
  let target = {
    value: targetIdentity,
    kind: targetKind,
    reachable: false,
    evidence: 'target probe deferred until authorization and engagement controls are persisted',
  };
  const artifactRootCandidate = resolve(options.artifactRoot ?? targetPath ?? process.cwd());
  const artifactRootPath = statSafe(artifactRootCandidate)?.isDirectory() ? realpathSync(artifactRootCandidate) : artifactRootCandidate;
  refuseSealedPreflightRewrite(artifactRootPath, options.output);
  const nativeLaunch = inspectNativeLaunchForPreflight({
    options,
    modelRuntime,
    mode,
    targetKind,
    targetIdentity,
    artifactRootPath,
    engagementId: options.engagementId,
  });
  // --unattested-launch is an operator escape hatch for a host that demonstrably has no
  // key material at all — never a downgrade an in-sandbox controller can take by simply
  // omitting the signed coordinates it was handed. Every precondition is a hard refusal
  // with its own named error, not a silent fall-back to attested, and the load-bearing
  // one reads state outside the artifact root. See requireUnattestedLaunchPreconditions.
  const unattestedLaunch = Boolean(options.unattestedLaunch);
  if (unattestedLaunch) {
    requireUnattestedLaunchPreconditions({ options, modelRuntime, nativeLaunch, artifactRootPath });
  }
  if (modelRuntime === 'claude' && !nativeLaunch.ready && !unattestedLaunch) fail(nativeLaunch.evidence);
  const outputRelative = options.output ?? 'ai_agents_internal/preflight.json';
  const requestedOutputPath = resolve(artifactRootPath, outputRelative);
  const fallbackOutputPath = resolve(artifactRootPath, 'ai_agents_internal/preflight.json');
  const requestedOutputSafe = isWithin(artifactRootPath, requestedOutputPath) && safePhysicalPath(artifactRootPath, requestedOutputPath);
  const outputPath = requestedOutputSafe ? requestedOutputPath : fallbackOutputPath;
  const outputPathSafe = isWithin(artifactRootPath, outputPath) && safePhysicalPath(artifactRootPath, outputPath);
  const contractedArtifactPaths = [
    ...matrix.orchestration.artifactPaths,
    ...matrix.agents.flatMap((agent) => agent.artifactPaths),
  ];
  const safePaths = requestedOutputSafe && contractedArtifactPaths.every((path) => {
    const stablePrefix = path.replace(/[*?].*$/, '').replace(/\/$/, '');
    const resolvedPath = resolve(artifactRootPath, stablePrefix);
    return isWithin(artifactRootPath, resolvedPath) && safePhysicalPath(artifactRootPath, resolvedPath);
  });
  const artifactWritable = typeof profile.artifactWritable === 'boolean'
    ? profile.artifactWritable
    : isWritableDirectory(artifactRootPath);

  const authorizationEnvironment = options.environment ?? profile.environment ?? 'unknown';
  if (!['unknown', 'development', 'test', 'staging', 'production'].includes(authorizationEnvironment)) {
    fail('preflight --environment must be unknown, development, test, staging, or production');
  }
  const authorizationCandidate = resolve(artifactRootPath, options.authorization ?? 'ai_agents_internal/authorization.json');
  const requestedAuthorizationPath = existsSync(authorizationCandidate) && !lstatSync(authorizationCandidate).isSymbolicLink()
    ? realpathSync(authorizationCandidate) : authorizationCandidate;
  const authorizationPathSafe = isWithin(artifactRootPath, requestedAuthorizationPath) && safePhysicalPath(artifactRootPath, requestedAuthorizationPath);
  let authorization = null;
  let authorizationCreated = false;
  const authorizationErrors = [];
  if (!authorizationPathSafe) {
    authorizationErrors.push('authorization manifest path escapes the artifact root');
  } else if (existsSync(requestedAuthorizationPath)) {
    try {
      authorization = JSON.parse(readFileSync(requestedAuthorizationPath, 'utf8'));
    } catch (error) {
      authorizationErrors.push(`authorization manifest is not valid JSON: ${error.message}`);
    }
  } else if (options.authorization) {
    authorizationErrors.push(`supplied authorization manifest is missing: ${requestedAuthorizationPath}`);
  } else if (!artifactWritable) {
    authorizationErrors.push('artifact root is not writable; cannot create default authorization manifest');
  } else {
    authorization = createDefaultAuthorization({
      template: readJson(AUTHORIZATION_TEMPLATE_PATH),
      target: targetIdentity,
      environment: authorizationEnvironment,
      engagementId: options.engagementId,
    });
    mkdirSync(dirname(requestedAuthorizationPath), { recursive: true });
    writeFileSync(requestedAuthorizationPath, `${JSON.stringify(authorization, null, 2)}\n`, { mode: 0o600 });
    chmodSync(requestedAuthorizationPath, 0o600);
    authorizationCreated = true;
  }
  if (authorization) {
    authorizationErrors.push(...validateAuthorizationManifest(authorization));
  }
  const authorizationAuditPath = authorization && nonEmptyString(authorization.audit?.path)
    ? resolve(dirname(requestedAuthorizationPath), authorization.audit.path)
    : resolve(dirname(requestedAuthorizationPath), 'authorization-audit.jsonl');
  const authorizationAuditPathSafe = isWithin(artifactRootPath, authorizationAuditPath) && safePhysicalPath(artifactRootPath, authorizationAuditPath);
  if (!authorizationAuditPathSafe) authorizationErrors.push('authorization audit path escapes the artifact root');
  const production = authorization
    ? detectProductionLike(authorization.target, options.target)
    : { productionLike: true, signals: ['invalid-authorization-manifest'] };
  const authorizationSummary = {
    manifestPath: requestedAuthorizationPath,
    auditPath: authorizationAuditPath,
    sha256: authorization ? manifestSha256(authorization) : null,
    created: authorizationCreated,
    environment: authorization?.target?.environment ?? authorizationEnvironment,
    productionLike: production.productionLike,
    productionSignals: production.signals,
    defaultReadOnly: !authorization || Object.values(authorization.actionGrants ?? {}).every((grant) => !grant.enabled),
  };

  const engagementCandidate = resolve(artifactRootPath, options.engagement ?? 'ai_agents_internal/engagement.json');
  const requestedEngagementPath = existsSync(engagementCandidate) && !lstatSync(engagementCandidate).isSymbolicLink()
    ? realpathSync(engagementCandidate) : engagementCandidate;
  const engagementPathSafe = isWithin(artifactRootPath, requestedEngagementPath) && safePhysicalPath(artifactRootPath, requestedEngagementPath);
  let engagement = null;
  let engagementCreated = false;
  let engagementState = null;
  const engagementErrors = [];
  if (!engagementPathSafe) {
    engagementErrors.push('engagement manifest path escapes the artifact root');
  } else if (existsSync(requestedEngagementPath)) {
    try { engagement = JSON.parse(readFileSync(requestedEngagementPath, 'utf8')); }
    catch (error) { engagementErrors.push(`engagement manifest is not valid JSON: ${error.message}`); }
  } else if (options.engagement) {
    engagementErrors.push(`supplied engagement manifest is missing: ${requestedEngagementPath}`);
  } else if (!artifactWritable) {
    engagementErrors.push('artifact root is not writable; cannot create engagement manifest');
  } else if (!authorization || authorizationErrors.length > 0) {
    engagementErrors.push('valid authorization manifest is required before engagement initialization');
  } else {
    engagement = createDefaultEngagement({
      template: readJson(ENGAGEMENT_TEMPLATE_PATH),
      target: targetIdentity,
      targetRoot: targetPath,
      artifactRoot: artifactRootPath,
      mode,
      engagementId: authorization.engagementId,
      selectedAgents: [...selectedSlugs],
      browserSupport: profile.browserSupport,
      accessibilityRequirement: profile.accessibilityRequirement,
      phasePlan: derivePhasePlan(orchestrationPlan, matrix, mode, [...selectedSlugs], raciContract),
    });
    // Record the operator's opt-out durably, before any decision or allocation can exist,
    // so every model decision minted for this engagement is integrity-bound to it through
    // engagementManifestSha256. Attested engagements keep the field absent, byte-for-byte
    // identical to every manifest written before unattested mode existed.
    if (unattestedLaunch) engagement.launchAssurance = 'unattested';
    mkdirSync(dirname(requestedEngagementPath), { recursive: true });
    writeFileSync(requestedEngagementPath, `${JSON.stringify(engagement, null, 2)}\n`, { mode: 0o600 });
    chmodSync(requestedEngagementPath, 0o600);
    engagementCreated = true;
  }
  if (engagement) {
    engagementErrors.push(...validateEngagementManifest(engagement));
    // Assurance is immutable for the life of an engagement: decisions and the model-control
    // seal are bound to the manifest digest, so silently flipping either direction would
    // invalidate them. A mismatch is an error, never a rewrite.
    const recordedAssurance = modelLaunchAssurance(engagement.launchAssurance);
    const requestedAssurance = unattestedLaunch ? 'unattested' : 'attested';
    if (recordedAssurance !== requestedAssurance) {
      engagementErrors.push(
        `engagement launchAssurance ${recordedAssurance} does not match this preflight run (${requestedAssurance}); ` +
        'assurance is immutable once recorded — rerun preflight with the matching --unattested-launch setting, or start a fresh artifact root',
      );
    }
    if (engagement.mode !== mode) engagementErrors.push(`engagement mode ${engagement.mode} does not match preflight mode ${mode}`);
    if (typeof engagement.artifactRoot !== 'string' || !physicalPathsEquivalent(engagement.artifactRoot, artifactRootPath)) engagementErrors.push('engagement artifactRoot does not match preflight artifact root');
    if (!targetIdentitiesEquivalent(engagement.target?.identifier, targetIdentity) || !nullablePhysicalPathsEquivalent(engagement.target?.root, targetPath)) engagementErrors.push('engagement target does not match the inspected target');
    if (engagement.engagementId !== authorization?.engagementId) engagementErrors.push('engagementId does not match authorization manifest');
    if (!Array.isArray(engagement.selectedAgents) || JSON.stringify([...engagement.selectedAgents].sort()) !== JSON.stringify([...selectedSlugs].sort())) engagementErrors.push('engagement selectedAgents do not match the selected mode');
    if (engagementErrors.length === 0) {
      try { engagementState = initializeEngagementState(engagement); }
      catch (error) { engagementErrors.push(`engagement state initialization failed: ${error.message}`); }
    }
  }
  const engagementUsable = engagement && engagementErrors.length === 0;
  const authorizationTargetIdentity = engagementUsable ? engagement.target.identifier : targetIdentity;
  const engagementSummary = {
    manifestPath: requestedEngagementPath,
    statePath: engagementUsable ? resolve(engagement.artifactRoot, engagement.statePath) : resolve(artifactRootPath, 'ai_agents_internal/engagement-state.json'),
    immutabilityAuditPath: engagementUsable ? resolve(engagement.artifactRoot, engagement.writePolicy.auditPath) : resolve(artifactRootPath, 'ai_agents_internal/immutability-audit.jsonl'),
    sha256: engagementUsable ? manifestSha256(engagement) : null,
    created: engagementCreated,
    stateCreated: engagementState?.created ?? false,
    phase: engagementState?.state.currentPhase ?? null,
    selectedAgents: engagementUsable ? engagement.selectedAgents.length : 0,
    accessibilityTarget: engagementUsable ? `${engagement.accessibilityPolicy.standard} ${engagement.accessibilityPolicy.version} ${engagement.accessibilityPolicy.level}` : null,
    browserCoverageEntries: engagementUsable ? engagement.browserPolicy.coverage.matrix.length : 0,
    browserCoverageSource: engagementUsable ? engagement.browserPolicy.coverage.supportSource : null,
    hookPath: HOOKS_PATH,
    hookPackaged: existsSync(HOOKS_PATH),
  };

  let preflightHeartbeatError = null;
  let preflightHeartbeatEvidence = null;
  if (engagementUsable) {
    try {
      const heartbeat = ensurePreflightHeartbeat(engagement, profile.generatedAt ?? new Date().toISOString());
      preflightHeartbeatEvidence = heartbeat.disposition === 'created'
        ? 'initial controller heartbeat persisted before target probe'
        : heartbeat.disposition === 'existing'
          ? `validated existing controller heartbeat; engagement state revision=${engagementState.state.revision}`
          : heartbeat.disposition === 'legacy-migrated-existing'
            ? `validated migrated v1 controller heartbeat beginning at ${heartbeat.record.phase}; engagement state revision=${engagementState.state.revision}`
            : `resumed migrated v1 engagement without a historical heartbeat; engagement state revision=${engagementState.state.revision}`;
    } catch (error) { preflightHeartbeatError = error.message; }
  } else {
    preflightHeartbeatError = 'engagement controls are unavailable';
  }

  const probeTimestamp = profile.generatedAt ?? new Date().toISOString();
  const probeRequest = { lane: 'odysseus', action: 'read', target: authorizationTargetIdentity, sourceTrust: 'manifest' };
  const boundaryDecision = authorization && authorizationErrors.length === 0
    ? evaluateAuthorization({ manifest: authorization, request: probeRequest, now: probeTimestamp })
    : null;
  let boundaryAuditError = null;
  if (boundaryDecision && authorizationAuditPathSafe) {
    try {
      const patterns = readJson(REDACTION_PATTERNS_PATH);
      const patternErrors = validateRedactionPatterns(patterns);
      if (patternErrors.length > 0) throw new Error(patternErrors.join('; '));
      const event = buildAuditEvent({ manifest: authorization, request: probeRequest, decision: boundaryDecision, timestamp: probeTimestamp, patterns });
      atomicPrivateAppend(authorizationAuditPath, `${JSON.stringify(event)}\n`);
    } catch (error) {
      boundaryAuditError = `authorization probe audit failed: ${error.message}`;
    }
  } else if (boundaryDecision) {
    boundaryAuditError = 'authorization probe audit path is unsafe';
  }
  const probeAllowed = boundaryDecision?.decision === 'allow' && boundaryAuditError === null && engagementErrors.length === 0 && preflightHeartbeatError === null;
  if (probeAllowed) {
    target = await inspectTarget(options.target, profile);
    target.value = targetIdentity;
  } else {
    const reason = boundaryAuditError ?? (boundaryDecision
      ? `${boundaryDecision.ruleId}: ${boundaryDecision.reason}`
      : 'authorization or engagement controls are unavailable');
    target.evidence = `target probe skipped: ${reason}`;
  }
  const browserRuntime = recordBrowserRuntime({
    artifactRootPath,
    persist: Boolean(artifactWritable && engagementUsable),
    engagementId: engagementUsable ? engagement.engagementId : null,
    probedAt: probeTimestamp,
    result: resolveBrowserRuntime({ targetPath, artifactRootPath, profile, probeAllowed, probedAt: probeTimestamp }),
  });

  const availableTools = new Set(profile.availableTools ?? matrix.supportedBuiltinTools);
  const commandAvailability = detectCommands(inventory, profile);
  const mcpServers = profile.mcpServers ?? detectMcpServers();
  const detectedFeatures = new Set([
    ...(Array.isArray(profile.features)
      ? profile.features
      : (probeAllowed ? [...detectTargetFeatures(targetPath), ...detectEnvironmentFeatures()] : [])),
    ...options.features,
  ]);

  const capabilityState = {};
  for (const [id, definition] of Object.entries(matrix.capabilities)) {
    let available = detectedFeatures.has(id);
    let evidence = available ? `target/profile feature confirmed: ${id}` : `target/profile feature not detected: ${id}`;
    if (definition.kind === 'mcp') {
      const match = mcpServers.find((server) => definition.serverPatterns.some((pattern) => server.includes(pattern)));
      available = Boolean(match);
      evidence = match ? `connected MCP server: ${match}` : `no connected MCP server matched ${definition.serverPatterns.join(', ')}`;
    }
    if (id === 'browser-runtime') {
      if (browserRuntime.status === 'available') {
        available = true;
        evidence = `functional Playwright runtime: ${browserRuntime.evidence}`;
      } else if (!available) {
        evidence = `no functional Playwright runtime (${browserRuntime.status}): ${browserRuntime.evidence}`;
      }
    }
    capabilityState[id] = { available, evidence };
  }

  const checks = [];
  const nativeLaunchReady = nativeLaunch.ready;
  addCheck(
    checks,
    'native-host-execution',
    !unattestedLaunch,
    nativeLaunchReady,
    nativeLaunchReady
      ? nativeLaunch.evidence
      : unattestedLaunch
        ? `UNATTESTED: operator explicitly opted out of native-launch attestation via --unattested-launch (${nativeLaunch.evidence}); no cryptographic proof of sandbox/turn-cap/model-dispatch integrity exists for this run — treat as a named residual risk in every downstream report`
        : modelRuntime === 'codex'
          ? 'Codex dispatch is disabled because the installed CLI exposes no native hard turn cap'
          : nativeLaunch.evidence,
  );
  addCheck(checks, 'target-reachable', true, target.reachable, target.evidence);
  addCheck(checks, 'artifact-root-writable', true, artifactWritable, artifactWritable ? `writable: ${artifactRootPath}` : `not writable: ${artifactRootPath}`);
  addCheck(checks, 'artifact-paths-safe', true, safePaths, safePaths ? 'all contracted paths remain under the artifact root' : 'a contracted or output path escapes the artifact root');
  addCheck(
    checks,
    'authorization-manifest',
    true,
    authorizationErrors.length === 0,
    authorizationErrors.length === 0
      ? `${authorizationCreated ? 'created default-deny' : 'loaded'} manifest sha256=${authorizationSummary.sha256}`
      : authorizationErrors.join('; '),
  );
  addCheck(
    checks,
    'engagement-manifest',
    true,
    engagementErrors.length === 0,
    engagementErrors.length === 0
      ? `${engagementCreated ? 'created' : 'loaded'} manifest sha256=${engagementSummary.sha256}; phase=${engagementSummary.phase}`
      : engagementErrors.join('; '),
  );
  addCheck(
    checks,
    'path-immutability-hook',
    true,
    engagementSummary.hookPackaged,
    engagementSummary.hookPackaged ? `packaged PreToolUse hook: ${HOOKS_PATH}` : 'plugin hooks/hooks.json is missing',
  );
  addCheck(
    checks,
    'controller-heartbeat',
    true,
    preflightHeartbeatError === null,
    preflightHeartbeatError ?? preflightHeartbeatEvidence,
  );
  if (boundaryDecision) {
    const passed = boundaryDecision.decision === 'allow' && boundaryAuditError === null;
    const evidence = boundaryAuditError ?? `${boundaryDecision.ruleId}: ${boundaryDecision.reason}; audit=${authorizationAuditPath}`;
    addCheck(checks, 'authorization-target-boundary', true, passed, evidence);
  } else {
    addCheck(checks, 'authorization-target-boundary', true, false, 'authorization manifest unavailable or invalid');
  }
  try {
    const assetStats = verifyRuntimeAssets();
    addCheck(checks, 'packaged-assets', true, true, `${assetStats.assets} assets and hashes verified`);
  } catch (error) {
    addCheck(checks, 'packaged-assets', true, false, error.message);
  }
  for (const tool of matrix.orchestration.requiredTools) {
    addCheck(checks, `tool:${tool}`, true, availableTools.has(tool), availableTools.has(tool) ? 'available' : 'unavailable');
  }
  for (const [id, state] of Object.entries(capabilityState)) {
    addCheck(checks, `capability:${id}`, false, state.available, state.evidence);
  }
  for (const [command, state] of Object.entries(commandAvailability)) {
    const consumers = inventory.commandReferences.find((item) => item.value === command)?.consumers ?? [];
    if (consumers.some((consumer) => selectedSlugs.has(consumer))) {
      addCheck(checks, `command:${command}`, false, state.available, state.evidence);
    }
  }

  const commandConsumers = new Map(inventory.commandReferences.map((item) => [item.value, new Set(item.consumers)]));
  const prerequisiteFailure = checks.some((check) => check.mandatory && check.status === 'fail');
  const authorizationByAgent = new Map(matrix.agents.map((contract) => [
    contract.slug,
    evaluateRiskAuthorizations(contract, authorization, authorizationTargetIdentity, profile.generatedAt ?? new Date().toISOString()),
  ]));
  let agents = matrix.agents.map((contract) => evaluateAgent({
    contract,
    mode,
    availableTools,
    capabilityState,
    commandAvailability,
    commandConsumers,
    matrix,
    modelRuntime,
    mandatoryFailure: prerequisiteFailure,
    authorizationDecisions: authorizationByAgent.get(contract.slug),
  }));
  // Only a blocked controller, essential lane, or mandatory lane stops the engagement; other
  // blocked lanes become named residuals. Failed prerequisites keep every selected lane blocked.
  if (!prerequisiteFailure) agents = applyEssentialLanePolicy(agents, orchestrationPlan, mode);
  let orchestration = { path: join(artifactRootPath, 'ai_agents_internal', 'orchestration-plan.json'), sha256: null, specialists: 0 };
  let orchestrationError = null;
  try {
    if (prerequisiteFailure) throw new Error('preflight prerequisites failed; projection was not persisted');
    const dispatchable = agents.filter((agent) => agent.slug !== 'odysseus' && agent.selected && agent.dispatchAllowed).map((agent) => agent.slug);
    orchestration = persistPreflightOrchestrationPlan(artifactRootPath, mode, dispatchable);
  } catch (error) {
    orchestrationError = error.message;
  }
  addCheck(
    checks,
    'orchestration-plan',
    true,
    orchestrationError === null,
    orchestrationError ?? `persisted ${orchestration.specialists} dispatchable specialists sha256=${orchestration.sha256}`,
  );
  if (orchestrationError !== null) {
    agents = agents.map((agent) => agent.selected
      ? { ...withoutDowngrade(agent), status: 'blocked', dispatchAllowed: false, stopsEngagement: true, pendingGates: [], actions: [...agent.actions, `Orchestration projection failed: ${orchestrationError}`] }
      : agent);
  }
  const selectedAgents = agents.filter((agent) => agent.selected);
  const summary = {
    selected: selectedAgents.length,
    ready: selectedAgents.filter((agent) => agent.status === 'ready').length,
    degraded: selectedAgents.filter((agent) => agent.status === 'degraded').length,
    deferred: selectedAgents.filter((agent) => agent.status === 'deferred').length,
    skipped: selectedAgents.filter((agent) => agent.status === 'skipped').length,
    conditional: selectedAgents.filter((agent) => agent.status === 'conditional').length,
    blocked: selectedAgents.filter((agent) => agent.status === 'blocked').length,
    downgraded: selectedAgents.filter((agent) => agent.downgradedFrom === 'blocked').length,
    dispatchable: selectedAgents.filter((agent) => agent.dispatchAllowed).length,
  };
  const mandatoryFailure = checks.some((check) => check.mandatory && check.status === 'fail');
  const status = mandatoryFailure || selectedAgents.some((agent) => agent.status === 'blocked' && agent.stopsEngagement)
    ? 'blocked'
    : summary.degraded + summary.deferred + summary.skipped + summary.conditional > 0
      ? 'degraded'
      : 'ready';

  const report = {
    $schema: 'https://raw.githubusercontent.com/holi87/holak-teams/master/argus/schemas/preflight-report.schema.json',
    schemaVersion: 3,
    generatedAt: profile.generatedAt ?? new Date().toISOString(),
    mode,
    modelRuntime,
    status,
    target,
    artifactRoot: { path: artifactRootPath, writable: artifactWritable, safePaths },
    authorization: authorizationSummary,
    engagement: engagementSummary,
    orchestration,
    browserRuntime,
    checks,
    capabilities: Object.entries(capabilityState).map(([id, state]) => ({ id, ...state })),
    agents,
    summary,
    residualRisks: preflightResidualRisks(selectedAgents),
  };

  let persisted = false;
  if (artifactWritable && outputPathSafe) {
    mkdirSync(dirname(outputPath), { recursive: true });
    atomicPrivateWrite(outputPath, `${JSON.stringify(report, null, 2)}\n`);
    persisted = true;
  }
  if (options.json) {
    process.stdout.write(`${JSON.stringify(report, null, 2)}\n`);
  } else {
    console.log(
      `PREFLIGHT  ${status} mode=${mode} selected=${summary.selected} dispatchable=${summary.dispatchable} ` +
      `degraded=${summary.degraded} deferred=${summary.deferred} skipped=${summary.skipped} conditional=${summary.conditional} blocked=${summary.blocked} ` +
      `downgraded=${summary.downgraded} report=${persisted ? outputPath : 'NOT_PERSISTED'}` +
      (unattestedLaunch ? ' attestation=UNATTESTED' : ''),
    );
  }
  return status === 'blocked' ? 2 : 0;
}

function evaluateAgent({ contract, mode, availableTools, capabilityState, commandAvailability, commandConsumers, matrix, modelRuntime, mandatoryFailure, authorizationDecisions }) {
  const selected = contract.modes.includes(mode);
  if (!selected) return agentResult(contract, false, 'not-selected', false, [], [], [], contract.artifactPaths, authorizationDecisions, modelRuntime);
  if (mandatoryFailure) {
    return agentResult(contract, true, 'blocked', false, [], [], ['Orchestration preflight failed; no specialist may be dispatched.'], contract.artifactPaths, authorizationDecisions, modelRuntime);
  }
  const modelPreview = buildModelRoutingPreview(modelPolicy, runtimeAdapters, { slug: contract.slug, runtime: modelRuntime });
  if (modelPreview.status !== 'ready') {
    return agentResult(contract, true, 'blocked', false, [], [`model:${modelPreview.missingCapabilities.join(',')}`], [modelPreview.reason], contract.artifactPaths, authorizationDecisions, modelRuntime);
  }

  const missingTools = contract.requiredTools.filter((tool) => !availableTools.has(tool));
  const missingRequired = (contract.requiredCapabilities ?? []).filter((id) => !capabilityState[id]?.available);
  const missingOptional = (contract.optionalCapabilities ?? []).filter((id) => !capabilityState[id]?.available);
  const missingCommands = Object.entries(commandAvailability)
    .filter(([command, state]) => !state.available && commandConsumers.get(command)?.has(contract.slug))
    .map(([command]) => `command:${command}`);
  const actions = [];

  if (missingTools.length > 0) {
    actions.push(`Mandatory tools unavailable: ${missingTools.join(', ')}. Stop before dispatch.`);
    return agentResult(contract, true, 'blocked', false, missingTools, [...missingRequired, ...missingOptional, ...missingCommands], actions, contract.artifactPaths, authorizationDecisions, modelRuntime);
  }

  let status = 'ready';
  const requiredFallbacks = [];
  for (const id of missingRequired) {
    const capability = matrix.capabilities[id];
    requiredFallbacks.push(`${id}: ${capability.fallback}`);
    if (capability.missingDisposition === 'skipped') status = 'skipped';
    else if (status !== 'skipped') status = 'deferred';
  }
  const pendingGates = conditionalPendingGates(status, missingRequired, matrix);
  if (pendingGates.length > 0) {
    status = 'conditional';
    actions.push(conditionalLaneAction(pendingGates, requiredFallbacks));
  } else {
    actions.push(...requiredFallbacks);
  }
  for (const id of missingOptional) {
    actions.push(contract.slug === 'perseus' && id === 'browser-runtime'
      ? 'browser-runtime: Run authorized CLI request-level security checks. Do not invoke the browser driver; record DOM-dependent checks as unavailable with residual risk.'
      : `${id}: ${matrix.capabilities[id].fallback}`);
    if (status === 'ready') status = 'degraded';
  }
  if (missingCommands.length > 0) {
    actions.push(`Optional host commands unavailable: ${missingCommands.map((item) => item.slice(8)).join(', ')}; use an available equivalent or record the probe as skipped.`);
    if (status === 'ready') status = 'degraded';
  }
  const deniedAuthorizations = authorizationDecisions.filter((decision) => decision.decision === 'deny');
  if (deniedAuthorizations.length > 0) {
    actions.push(...deniedAuthorizations.map((decision) => (
      `Authorization denied ${decision.action}: ${decision.ruleId} — ${decision.reason}. Restrict the lane to its allowed read-only actions.`
    )));
    if (status === 'ready') status = 'degraded';
  }
  return agentResult(
    contract,
    true,
    status,
    status === 'ready' || status === 'degraded' || status === 'conditional',
    [],
    [...missingRequired, ...missingOptional, ...missingCommands],
    actions,
    contract.artifactPaths,
    authorizationDecisions,
    modelRuntime,
    pendingGates,
  );
}

// A lane whose only unmet requirements are target or browser capabilities is recon-provable:
// it becomes `conditional` instead of deferred/skipped, is sealed with its model decision,
// and allocates only after `engagement resolve-gates` proves every pending gate.
function conditionalPendingGates(status, missingRequired, matrix) {
  if (status !== 'deferred' && status !== 'skipped') return [];
  if (!missingRequired.every((id) => ['target', 'browser'].includes(matrix.capabilities[id]?.kind))) return [];
  return [...missingRequired].sort();
}

function conditionalLaneAction(pendingGates, requiredFallbacks) {
  return `Conditional on ${pendingGates.join(', ')}: sealed with a model decision now; allocate only after ` +
    '`argus-assets engagement resolve-gates` releases the lane; if a gate stays unmet the lane is omitted and its ' +
    `fallback is recorded as residual risk: ${requiredFallbacks.join(' ')}`;
}

function agentResult(contract, selected, status, dispatchAllowed, missingTools, missingCapabilities, actions, artifactPaths, authorization, modelRuntime, pendingGates = []) {
  const model = buildModelRoutingPreview(modelPolicy, runtimeAdapters, { slug: contract.slug, runtime: modelRuntime });
  return { slug: contract.slug, lane: contract.lane, selected, status, dispatchAllowed: contract.slug === 'odysseus' ? false : dispatchAllowed, stopsEngagement: status === 'blocked', pendingGates: [...pendingGates], model, missingTools, missingCapabilities, actions, artifactPaths, authorization };
}

// Every selected lane that will not run, or runs only once its gates are released, is a named
// residual risk, so the controller and the final report can list uncovered surfaces without
// re-deriving them from agent records.
function preflightResidualRisks(selectedAgents) {
  const RESIDUAL_RISK_REASON_LIMIT = 600;
  return selectedAgents
    .filter((agent) => agent.status !== 'ready' && agent.status !== 'degraded')
    .map((agent) => {
      const detail = agent.actions.join(' ') || `${agent.slug} is ${agent.status}`;
      // A conditional lane is sealed but not yet dispatchable: it stays a named risk until
      // resolve-gates releases it or omits it with its fallback.
      const reason = agent.status === 'conditional' ? `pending gate resolution: ${detail}` : detail;
      return {
        slug: agent.slug,
        status: agent.status,
        ...(agent.downgradedFrom ? { downgradedFrom: agent.downgradedFrom } : {}),
        missingTools: [...agent.missingTools],
        missingCapabilities: [...agent.missingCapabilities],
        reason: reason.length > RESIDUAL_RISK_REASON_LIMIT ? `${reason.slice(0, RESIDUAL_RISK_REASON_LIMIT - 3)}...` : reason,
      };
    });
}

// A lane re-blocked after a failed orchestration projection is blocked outright, not downgraded.
function withoutDowngrade(agent) {
  const record = { ...agent };
  delete record.downgradedFrom;
  return record;
}

function evaluateRiskAuthorizations(contract, authorization, target, now) {
  if (!authorization) {
    return (contract.riskActions ?? []).map((action) => ({
      action,
      decision: 'deny',
      ruleId: 'AUTH-MANIFEST-INVALID',
      reason: 'authorization manifest is unavailable',
    }));
  }
  const account = authorization.accounts?.allowedAliases?.[0];
  const namespace = authorization.dataBoundaries?.allowedNamespaces?.[0];
  const mutation = authorization.allowedMutations?.[0];
  return (contract.riskActions ?? []).map((action) => {
    const decision = evaluateAuthorization({
      manifest: authorization,
      request: {
        lane: contract.slug,
        action,
        target,
        sourceTrust: 'manifest',
        account,
        namespace,
        mutation,
        rate: authorization.rateLimits?.requestsPerSecond,
        concurrency: authorization.rateLimits?.maxConcurrent,
        totalRequests: authorization.rateLimits?.maxTotalRequests,
        duration: authorization.rateLimits?.maxDurationSeconds,
        binaryReviewed: action === 'binary-evidence' ? true : undefined,
      },
      now,
    });
    return { action, decision: decision.decision, ruleId: decision.ruleId, reason: decision.reason };
  });
}

function parsePreflightOptions(args) {
  const options = { features: [], json: false, unattestedLaunch: false };
  for (let index = 0; index < args.length; index += 1) {
    const name = args[index];
    if (name === '--json') {
      options.json = true;
      continue;
    }
    if (name === '--unattested-launch') {
      options.unattestedLaunch = true;
      continue;
    }
    const value = args[index + 1];
    if (!value || value.startsWith('--')) fail(`preflight ${name} requires a value`);
    index += 1;
    if (name === '--target') options.target = value;
    else if (name === '--mode') options.mode = value.toUpperCase();
    else if (name === '--artifact-root') options.artifactRoot = value;
    else if (name === '--output') options.output = value;
    else if (name === '--authorization') options.authorization = value;
    else if (name === '--engagement') options.engagement = value;
    else if (name === '--environment') options.environment = value;
    else if (name === '--engagement-id') options.engagementId = value;
    else if (name === '--model-runtime') options.modelRuntime = value.toLowerCase();
    else if (name === '--launch-authorization') options.launchAuthorization = value;
    else if (name === '--launch-receipt') options.launchReceipt = value;
    else if (name === '--trust-store') options.trustStore = value;
    else if (name === '--profile') options.profile = value;
    else if (name === '--feature') options.features.push(value);
    else fail(`unknown preflight option: ${name}`);
  }
  return options;
}

async function inspectTarget(value, profile) {
  if (/^https?:\/\//i.test(value)) {
    if (typeof profile.targetReachable === 'boolean') {
      return { value, kind: 'url', reachable: profile.targetReachable, evidence: `profile override: reachable=${profile.targetReachable}` };
    }
    try {
      const response = await fetch(value, { method: 'HEAD', redirect: 'manual', signal: AbortSignal.timeout(5000) });
      return { value, kind: 'url', reachable: true, evidence: `HTTP HEAD responded with ${response.status}` };
    } catch (error) {
      return { value, kind: 'url', reachable: false, evidence: `HTTP HEAD failed: ${error.message}` };
    }
  }
  const path = resolve(value);
  let reachable = typeof profile.targetReachable === 'boolean' ? profile.targetReachable : existsSync(path);
  if (reachable && typeof profile.targetReachable !== 'boolean') {
    try {
      accessSync(path, constants.R_OK);
    } catch {
      reachable = false;
    }
  }
  return {
    value: path,
    kind: 'path',
    reachable,
    evidence: typeof profile.targetReachable === 'boolean'
      ? `profile override: reachable=${profile.targetReachable}`
      : reachable ? `local path exists and is readable: ${path}` : `local path is missing or unreadable: ${path}`,
  };
}

function identifyTarget(value) {
  if (/^https?:\/\//i.test(value)) {
    let url;
    try { url = new URL(value); }
    catch (error) { fail(`preflight target URL is invalid: ${error.message}`); }
    if (!['http:', 'https:'].includes(url.protocol)) fail('preflight target URL must use HTTP or HTTPS');
    return { kind: 'url', targetPath: null, targetIdentity: url.toString() };
  }
  const candidate = resolve(value);
  const targetPath = statSafe(candidate) ? realpathSync(candidate) : candidate;
  return { kind: 'path', targetPath, targetIdentity: targetPath };
}

function targetIdentitiesEquivalent(stored, inspected) {
  if (stored === inspected) return true;
  if (!nonEmptyString(stored) || !nonEmptyString(inspected)) return false;
  if (!/^https?:\/\//i.test(stored) && !/^https?:\/\//i.test(inspected)) return physicalPathsEquivalent(stored, inspected);
  if (!/^https?:\/\//i.test(stored) || !/^https?:\/\//i.test(inspected)) return false;
  try {
    const storedUrl = new URL(stored);
    const inspectedUrl = new URL(inspected);
    if (!['http:', 'https:'].includes(storedUrl.protocol) || !['http:', 'https:'].includes(inspectedUrl.protocol)) return false;
    return storedUrl.toString() === inspectedUrl.toString();
  } catch {
    return false;
  }
}

function detectCommands(inventory, profile) {
  const override = Array.isArray(profile.commands) ? new Set(profile.commands) : null;
  const result = {};
  for (const { value } of inventory.commandReferences) {
    const available = override ? override.has(value) : commandExists(value);
    result[value] = { available, evidence: override ? `profile command ${available ? 'available' : 'missing'}` : `PATH command ${available ? 'found' : 'missing'}` };
  }
  return result;
}

function commandExists(command) {
  try {
    execFileSync('sh', ['-c', 'command -v "$1" >/dev/null 2>&1', 'argus-preflight', command]);
    return true;
  } catch {
    return false;
  }
}

function detectMcpServers() {
  try {
    return execFileSync('claude', ['mcp', 'list'], { encoding: 'utf8', timeout: 15000 })
      .split('\n')
      .filter((line) => /Connected/.test(line))
      .map((line) => line.split(': ').at(0).trim());
  } catch {
    return [];
  }
}

function detectTargetFeatures(targetPath) {
  if (!targetPath || !existsSync(targetPath)) return [];
  const features = [];
  const has = (...paths) => paths.some((path) => existsSync(join(targetPath, path)));
  if (has('src', 'app', 'lib', 'package.json', 'pyproject.toml', 'pom.xml', 'build.gradle')) features.push('source-access');
  if (has('tests', 'test', 'spec', 'playwright.config.ts', 'pytest.ini', 'vitest.config.ts', 'jest.config.js')) features.push('existing-suite');
  if (has('docker-compose.yml', 'docker-compose.yaml', 'compose.yml', 'compose.yaml')) features.push('multi-service');
  const manifests = ['package.json', 'pyproject.toml', 'pom.xml'].filter((path) => existsSync(join(targetPath, path)));
  if (manifests.some((path) => /graphql|grpc|websocket|socket\.io|kafka|rabbitmq|nats/i.test(readFileSync(join(targetPath, path), 'utf8')))) {
    features.push('non-rest-surface');
  }
  return features;
}

// Database coordinates exported to preflight are evidence for db-access for URL and path
// targets alike. Only the variable names are consulted; values never enter the report.
function detectEnvironmentFeatures() {
  return process.env.DATABASE_URL || process.env.PGHOST || process.env.MYSQL_HOST ? ['db-access'] : [];
}

// Browser runtime resolution never installs anything. It inspects candidate Playwright
// packages read-only, then proves at most three of them by launching headless Chromium from
// a throwaway profile under the artifact root's private tmp directory. The winner is bound
// by a digest over its whole module tree so a later consumer can detect any change.
// The policy is a hoisted function because preflight runs before later top-level
// constants in this file are initialized.
function browserRuntimePolicy() {
  return {
    probeTimeoutMs: 45000,
    maxProbes: 3,
    cacheCandidateLimit: 5,
    evidenceLimit: 600,
    treeRootLimit: 16,
    treeEntryLimit: 20000,
    systemRoots: ['/opt/homebrew/lib/node_modules', '/usr/local/lib/node_modules', '/usr/lib/node_modules'],
  };
}

// Runs as an ES module through `node -e`, so its arguments start at argv[1]. The watchdog
// fires before the parent's 45 s kill so a hung launch still reports a readable reason; a
// close that Chromium ignores is bounded, and Playwright's exit handler kills the browser.
function browserRuntimeProbeScript() {
  return String.raw`import { join } from "node:path";
import { pathToFileURL } from "node:url";
const [moduleDir, profileDir] = process.argv.slice(1);
const watchdog = setTimeout(() => {
  process.stderr.write("browser runtime probe watchdog expired after 40 s\n");
  process.exit(1);
}, 40000);
let context;
let executablePath = null;
try {
  const { chromium } = await import(pathToFileURL(join(moduleDir, "index.mjs")).href);
  context = await chromium.launchPersistentContext(profileDir, { headless: true });
  const page = context.pages()[0] ?? await context.newPage();
  await page.setContent("<p>argus</p>");
  executablePath = String(chromium.executablePath());
} catch (error) {
  process.stderr.write(String(error?.message ?? error) + "\n");
  process.exitCode = 1;
}
if (context) await Promise.race([context.close().catch(() => {}), new Promise((resolve) => setTimeout(resolve, 5000))]);
clearTimeout(watchdog);
if (!process.exitCode) process.stdout.write(JSON.stringify({ ok: true, executablePath }) + "\n");
process.exit(process.exitCode ?? 0);`;
}

function assertBrowserRuntimeProfile(profile) {
  const value = profile.browserRuntime;
  if (value === undefined || value === false) return;
  if (!plainObject(value) || Object.keys(value).some((key) => key !== 'modulePath') ||
      typeof value.modulePath !== 'string' || !value.modulePath.startsWith('/')) {
    fail('preflight profile browserRuntime must be false or {"modulePath": "<absolute Playwright package directory>"}');
  }
}

function resolveBrowserRuntime({ targetPath, artifactRootPath, profile = {}, probeAllowed, probedAt = new Date().toISOString() }) {
  if (!probeAllowed) return browserRuntimeResult('not-probed', 'target probe skipped: browser runtime resolution needs an allowed, audited target probe');
  if (profile.browserRuntime === false) return browserRuntimeResult('not-probed', 'profile disabled browser runtime resolution');
  if (profile.browserRuntime === undefined && Array.isArray(profile.features)) {
    return browserRuntimeResult('not-probed', 'profile features are authoritative');
  }
  const { maxProbes } = browserRuntimePolicy();
  const candidates = [];
  const inspected = new Set();
  let scratchRoot = null;
  let scratchError = null;
  let attempts = 0;
  let winner = null;
  let firstFailure = null;
  for (const location of browserRuntimeCandidateLocations({ targetPath, artifactRootPath, profile })) {
    const candidate = inspectBrowserRuntimeCandidate(location);
    if (!candidate || inspected.has(candidate.modulePath)) continue;
    inspected.add(candidate.modulePath);
    const record = { source: candidate.source, modulePath: candidate.modulePath };
    if (candidate.invalid) {
      candidates.push({ ...record, result: 'invalid', evidence: limitBrowserRuntimeEvidence(candidate.invalid) });
      continue;
    }
    if (!winner && attempts < maxProbes && scratchRoot === null && scratchError === null) {
      try { scratchRoot = ensureBrowserProbeScratch(artifactRootPath); }
      catch (error) { scratchError = error.message; }
    }
    if (winner || attempts >= maxProbes || scratchRoot === null) {
      const reason = winner
        ? `${winner.source} launched first`
        : attempts >= maxProbes
          ? `the ${maxProbes}-probe limit was reached`
          : `the probe scratch directory is unavailable: ${scratchError}`;
      candidates.push({ ...record, result: 'not-attempted', evidence: limitBrowserRuntimeEvidence(`not attempted: ${reason}`) });
      continue;
    }
    attempts += 1;
    const probe = probeBrowserRuntime(candidate.modulePath, scratchRoot);
    let failure = probe.launched ? null : probe.evidence;
    let tree = null;
    if (!failure) {
      try { tree = digestBrowserRuntimeTree(candidate.modulePath); }
      catch (error) { failure = `launched, but the module tree cannot be bound: ${error.message}`; }
    }
    if (failure) {
      candidates.push({ ...record, result: 'failed', evidence: limitBrowserRuntimeEvidence(failure) });
      firstFailure ??= `${candidate.source} ${candidate.modulePath}: ${failure}`;
      continue;
    }
    candidates.push({ ...record, result: 'launched', evidence: limitBrowserRuntimeEvidence(`launched headless Chromium: ${probe.executablePath}`) });
    winner = { ...candidate, executablePath: probe.executablePath, tree };
  }
  if (winner) {
    return {
      status: 'available',
      source: winner.source,
      modulePath: winner.modulePath,
      moduleVersion: winner.moduleVersion,
      packageJsonSha256: winner.packageJsonSha256,
      moduleTreeSha256: winner.tree.sha256,
      moduleTreeRoots: winner.tree.roots,
      executablePath: winner.executablePath,
      probedAt,
      evidence: limitBrowserRuntimeEvidence(
        `Playwright ${winner.moduleVersion} from ${winner.source} (${winner.modulePath}) launched headless Chromium (${winner.executablePath})`,
      ),
      candidates,
    };
  }
  const evidence = firstFailure
    ?? (scratchError ? `the probe scratch directory is unavailable: ${scratchError}` : null)
    ?? (candidates.length > 0
      ? `no valid Playwright package among ${candidates.length} inspected candidate location(s)`
      : 'no Playwright package found in any candidate location');
  return { ...browserRuntimeResult('unavailable', evidence), probedAt, candidates };
}

function browserRuntimeResult(status, evidence) {
  return {
    status,
    source: null,
    modulePath: null,
    moduleVersion: null,
    packageJsonSha256: null,
    moduleTreeSha256: null,
    moduleTreeRoots: [],
    executablePath: null,
    probedAt: null,
    evidence: limitBrowserRuntimeEvidence(evidence),
    candidates: [],
  };
}

function limitBrowserRuntimeEvidence(text) {
  const { evidenceLimit } = browserRuntimePolicy();
  const value = String(text);
  return value.length > evidenceLimit ? `${value.slice(0, evidenceLimit - 3)}...` : value;
}

// Candidate order is part of the contract: an explicit profile module is probed alone;
// otherwise host-provisioned runtimes (argus-launch --provision-browser installs them
// outside the artifact root) come first and user-wide installs last.
function browserRuntimeCandidateLocations({ targetPath, artifactRootPath, profile }) {
  if (plainObject(profile.browserRuntime)) {
    return [{ source: 'profile', path: resolve(profile.browserRuntime.modulePath), explicit: true }];
  }
  const { cacheCandidateLimit, systemRoots } = browserRuntimePolicy();
  const home = process.env.HOME || userInfo().homedir;
  const locations = [];
  const provisionedRoot = join(home, '.cache', 'argus', 'browser-runtime');
  for (const version of listDirectorySafe(provisionedRoot)
    .filter((name) => /^\d+\.\d+\.\d+$/.test(name))
    .sort((left, right) => compareVersionsDescending(left, right))
    .slice(0, cacheCandidateLimit)) {
    locations.push({ source: 'host-provisioned', path: join(provisionedRoot, version, 'node_modules', 'playwright') });
  }
  locations.push({ source: 'artifact-root', path: join(artifactRootPath, 'node_modules', 'playwright') });
  if (targetPath) locations.push({ source: 'target', path: join(targetPath, 'node_modules', 'playwright') });
  locations.push({ source: 'workspace', path: join(process.cwd(), 'node_modules', 'playwright') });
  const npmRoot = npmGlobalRoot();
  if (npmRoot) locations.push({ source: 'npm-global', path: join(npmRoot, 'playwright') });
  for (const root of systemRoots) locations.push({ source: 'system-global', path: join(root, 'playwright') });
  const npxRoot = join(home, '.npm', '_npx');
  locations.push(...listDirectorySafe(npxRoot)
    .map((name) => join(npxRoot, name, 'node_modules', 'playwright'))
    .map((path) => ({ path, modified: statSafe(path)?.mtimeMs }))
    .filter((entry) => entry.modified !== undefined)
    .sort((left, right) => right.modified - left.modified || (left.path < right.path ? -1 : 1))
    .slice(0, cacheCandidateLimit)
    .map((entry) => ({ source: 'npx-cache', path: entry.path })));
  return locations;
}

function listDirectorySafe(path) {
  try { return statSafe(path)?.isDirectory() ? readdirSync(path) : []; }
  catch { return []; }
}

function compareVersionsDescending(left, right) {
  const leftParts = left.split('.').map(Number);
  const rightParts = right.split('.').map(Number);
  for (let index = 0; index < 3; index += 1) {
    if (leftParts[index] !== rightParts[index]) return rightParts[index] - leftParts[index];
  }
  return 0;
}

function browserRuntimeChildEnvironment(extra = {}) {
  const environment = { PATH: process.env.PATH || '/usr/bin:/bin' };
  if (process.env.HOME) environment.HOME = process.env.HOME;
  return { ...environment, ...extra };
}

function npmGlobalRoot() {
  try {
    const output = execFileSync('npm', ['root', '-g'], {
      encoding: 'utf8',
      timeout: 10000,
      stdio: ['ignore', 'pipe', 'ignore'],
      env: browserRuntimeChildEnvironment({ npm_config_update_notifier: 'false' }),
    }).trim();
    return output.startsWith('/') && !output.includes('\n') ? output : null;
  } catch {
    return null;
  }
}

// A location that does not exist is skipped unless the profile named it explicitly. Anything
// that exists but is not a Playwright package with an ESM entry point is recorded as invalid.
function inspectBrowserRuntimeCandidate({ source, path, explicit = false }) {
  if (!lstatSafe(path)) return explicit ? { source, modulePath: path, invalid: 'module directory does not exist' } : null;
  let modulePath;
  try { modulePath = realpathSync(path); }
  catch (error) { return { source, modulePath: path, invalid: `module path cannot be resolved: ${error.message}` }; }
  if (!statSafe(modulePath)?.isDirectory()) return { source, modulePath, invalid: 'module path is not a directory' };
  let manifestBytes;
  let manifest;
  try {
    manifestBytes = readFileSync(join(modulePath, 'package.json'));
    manifest = JSON.parse(manifestBytes.toString('utf8'));
  } catch {
    return { source, modulePath, invalid: 'package.json is missing, unreadable, or not JSON' };
  }
  if (!plainObject(manifest) || manifest.name !== 'playwright') {
    return { source, modulePath, invalid: limitBrowserRuntimeEvidence(`package.json names ${JSON.stringify(plainObject(manifest) ? manifest.name ?? null : null)}, not playwright`) };
  }
  if (!statSafe(join(modulePath, 'index.mjs'))?.isFile()) return { source, modulePath, invalid: 'index.mjs entry point is missing' };
  return {
    source,
    modulePath,
    moduleVersion: nonEmptyString(manifest.version) ? manifest.version : 'unknown',
    packageJsonSha256: createHash('sha256').update(manifestBytes).digest('hex'),
  };
}

function ensureBrowserProbeScratch(artifactRootPath) {
  const scratch = join(artifactRootPath, 'ai_agents_internal', 'tmp');
  if (!safePhysicalPath(artifactRootPath, scratch)) throw new Error('ai_agents_internal/tmp escapes the physical artifact root or crosses a symbolic link');
  mkdirSync(scratch, { recursive: true, mode: 0o700 });
  if (lstatSync(scratch).isSymbolicLink() || !statSafe(scratch)?.isDirectory()) throw new Error('ai_agents_internal/tmp is not a real directory');
  return scratch;
}

// Chromium's profile and Playwright's temporary artifacts both live under the artifact root's
// private tmp directory; each probe gets its own pair so a crashed launch leaves nothing behind.
function probeBrowserRuntime(modulePath, scratchRoot) {
  const { probeTimeoutMs } = browserRuntimePolicy();
  const profileDir = join(scratchRoot, `browser-probe-${randomBytes(8).toString('hex')}`);
  const temporaryDir = `${profileDir}-tmp`;
  try {
    mkdirSync(temporaryDir, { mode: 0o700 });
    const stdout = execFileSync(process.execPath, ['--input-type=module', '-e', browserRuntimeProbeScript(), modulePath, profileDir], {
      encoding: 'utf8',
      timeout: probeTimeoutMs,
      stdio: ['ignore', 'pipe', 'pipe'],
      maxBuffer: 1024 * 1024,
      env: browserRuntimeChildEnvironment({ TMPDIR: temporaryDir }),
    });
    const line = stdout.split('\n').map((item) => item.trim()).filter((item) => item.startsWith('{')).at(-1);
    let confirmation = null;
    try { confirmation = line ? JSON.parse(line) : null; }
    catch { confirmation = null; }
    if (confirmation?.ok !== true || !nonEmptyString(confirmation.executablePath)) {
      return { launched: false, evidence: 'probe exited without a launch confirmation' };
    }
    return { launched: true, executablePath: confirmation.executablePath };
  } catch (error) {
    return { launched: false, evidence: browserProbeFailure(error) };
  } finally {
    rmSync(profileDir, { recursive: true, force: true, maxRetries: 3, retryDelay: 100 });
    rmSync(temporaryDir, { recursive: true, force: true, maxRetries: 3, retryDelay: 100 });
  }
}

// Evidence keeps Playwright's headline plus the first fatal browser line (a crash signal or a
// Chromium FATAL/Check failure), never the full launch command line.
function browserProbeFailure(error) {
  if (error?.code === 'ETIMEDOUT') return `probe was killed after ${browserRuntimePolicy().probeTimeoutMs / 1000} s`;
  const lines = String(error?.stderr ?? '')
    .split('\n')
    .map((line) => line.trim())
    .filter((line) => /[A-Za-z0-9]/.test(line));
  const cause = lines.slice(1).find((line) => /Received signal|FATAL|Check failed/i.test(line));
  const parts = [lines[0], cause?.replace(/^(?:-\s*)?\[pid=\d+\]\[err\]\s*/, '')].filter(Boolean);
  if (parts.length > 0) return `launch failed: ${parts.join('; ')}`;
  return error?.status != null ? `probe exited with status ${error.status}` : `probe could not run: ${error?.message ?? error}`;
}

// moduleTreeSha256 binds the package and every runtime dependency it resolves (Node's
// node_modules lookup from each package directory) that lies outside an already covered
// root. Entries are labelled by their path relative to the directory holding modulePath
// with "/" separators, sorted by code unit, and hashed as
// `${label}\0${kind}\0${kind === 'file' ? sha256(bytes) : linkTarget}\n`; symbolic links
// are recorded, never followed, and directories contribute only through their entries.
function digestBrowserRuntimeTree(modulePath) {
  const { treeRootLimit, treeEntryLimit } = browserRuntimePolicy();
  const roots = [modulePath];
  const scanned = new Set();
  const queue = [modulePath];
  while (queue.length > 0) {
    const packageRoot = queue.shift();
    if (scanned.has(packageRoot)) continue;
    scanned.add(packageRoot);
    let manifest;
    try { manifest = JSON.parse(readFileSync(join(packageRoot, 'package.json'), 'utf8')); }
    catch { manifest = null; }
    const names = Object.keys({
      ...(plainObject(manifest?.dependencies) ? manifest.dependencies : {}),
      ...(plainObject(manifest?.optionalDependencies) ? manifest.optionalDependencies : {}),
    }).sort();
    for (const name of names) {
      const dependency = resolveNodePackageDirectory(packageRoot, name);
      if (!dependency) continue;
      if (!roots.some((root) => isWithin(root, dependency))) roots.push(dependency);
      if (roots.length > treeRootLimit) throw new Error(`module tree spans more than ${treeRootLimit} package roots`);
      queue.push(dependency);
    }
  }
  const base = dirname(modulePath);
  const entries = [];
  for (const root of roots) {
    const pending = [root];
    while (pending.length > 0) {
      const directory = pending.pop();
      for (const name of readdirSync(directory)) {
        const path = join(directory, name);
        const entry = lstatSync(path);
        const label = relative(base, path).split(sep).join('/');
        if (entry.isSymbolicLink()) entries.push([label, 'symlink', readlinkSync(path)]);
        else if (entry.isDirectory()) pending.push(path);
        else if (entry.isFile()) entries.push([label, 'file', sha256File(path)]);
        else throw new Error(`module tree holds an unsupported filesystem entry: ${label}`);
        if (entries.length > treeEntryLimit) throw new Error(`module tree holds more than ${treeEntryLimit} entries`);
      }
    }
  }
  entries.sort((left, right) => (left[0] < right[0] ? -1 : left[0] > right[0] ? 1 : 0));
  const digest = createHash('sha256');
  for (const [label, kind, payload] of entries) digest.update(`${label}\0${kind}\0${payload}\n`);
  return { sha256: digest.digest('hex'), roots };
}

function resolveNodePackageDirectory(fromDirectory, name) {
  let cursor = fromDirectory;
  for (;;) {
    if (basename(cursor) !== 'node_modules') {
      const candidate = join(cursor, 'node_modules', name);
      if (statSafe(join(candidate, 'package.json'))?.isFile()) {
        try { return realpathSync(candidate); }
        catch { return null; }
      }
    }
    const parent = dirname(cursor);
    if (parent === cursor) return null;
    cursor = parent;
  }
}

// browser-runtime.json is written only when the artifact root is writable and the engagement
// is usable; otherwise the result is returned unchanged (preflight then fails its mandatory
// artifact-root or engagement checks and nothing is dispatched). When persistence is due but
// the write fails, consumers could not verify the record, so the runtime is reported
// unavailable instead of silently trusted.
function recordBrowserRuntime({ artifactRootPath, persist, engagementId, probedAt = new Date().toISOString(), result }) {
  if (!persist) return result;
  try {
    const path = join(artifactRootPath, 'ai_agents_internal', 'browser-runtime.json');
    if (!safePhysicalPath(artifactRootPath, path)) throw new Error('ai_agents_internal/browser-runtime.json escapes the physical artifact root or crosses a symbolic link');
    const record = { $schema: 'argus/browser-runtime@1', schemaVersion: 1, engagementId, ...result };
    const errors = validateBrowserRuntimeSchema(record);
    if (errors.length > 0) throw new Error(`record violates argus/browser-runtime@1: ${formatSchemaErrors(errors)}`);
    atomicPrivateWrite(path, `${JSON.stringify(record, null, 2)}\n`);
    return result;
  } catch (error) {
    return {
      ...browserRuntimeResult('unavailable', `browser runtime record could not be persisted: ${error.message}`),
      probedAt: result.probedAt ?? probedAt,
      candidates: result.candidates,
    };
  }
}

// `browser provision` is host preparation that runs before the launch sandbox exists (from
// argus-launch --provision-browser or an operator shell); it is not part of the signed launch
// request because preflight re-probes the runtime inside the sandbox. It reuses a host runtime
// outside the artifact root that already launches headless Chromium, or installs the pinned
// Playwright release into ~/.cache/argus/browser-runtime/<x.y.z>, the first preflight candidate
// location. That directory lies outside the artifact root, so sandboxed lanes can read the
// module but never modify it. Chromium goes to Playwright's host default cache. The launch and
// lease variables refuse it here and the PreToolUse guard denies it inside every engagement.
function browserCommand(args) {
  const usage = 'usage: argus-assets browser provision --artifact-root <absolute-path> [--version <x.y.z>] [--package <absolute .tgz>] [--skip-browser-install] [--json]';
  const [operation, ...rest] = args;
  if (operation !== 'provision') fail(usage);
  const engagementSignals = Object.keys(process.env)
    .filter((name) => /^ARGUS_(NATIVE_LAUNCH_|LAUNCH_UNATTESTED$|ENGAGEMENT_(LEASE|CONTROLLER)_TOKEN$)/.test(name))
    .sort();
  if (engagementSignals.length > 0) {
    console.error(`FAIL  browser provisioning is host/operator-only; run it before the launch sandbox (argus-launch --provision-browser); set: ${engagementSignals.join(', ')}`);
    return 2;
  }
  return provisionBrowserRuntime(parseBrowserProvisionOptions(rest, usage));
}

function parseBrowserProvisionOptions(args, usage) {
  const options = { json: false, skipBrowserInstall: false };
  const valued = new Set(['--artifact-root', '--version', '--package']);
  for (let index = 0; index < args.length; index += 1) {
    const name = args[index];
    const key = kebabToCamel(String(name).replace(/^--/, ''));
    if (name === '--json' || name === '--skip-browser-install') {
      if (options[key]) fail(`duplicate option: ${name}`);
      options[key] = true;
      continue;
    }
    if (!valued.has(name)) fail(`unknown browser provision option: ${name}; ${usage}`);
    const value = args[index + 1];
    if (value == null || value.startsWith('--')) fail(`${name} requires a value`);
    if (Object.hasOwn(options, key)) fail(`duplicate option: ${name}`);
    options[key] = value;
    index += 1;
  }
  if (!options.artifactRoot) fail(`browser provision requires --artifact-root; ${usage}`);
  if (options.version !== undefined && !/^\d+\.\d+\.\d+$/.test(options.version)) fail('browser provision --version must be a plain x.y.z release');
  if (options.version !== undefined && options.package !== undefined) {
    fail('browser provision --version and --package are mutually exclusive: a package archive carries its own version');
  }
  if (options.package !== undefined &&
      (!options.package.startsWith('/') || resolve(options.package) !== options.package || !options.package.endsWith('.tgz'))) {
    fail('browser provision --package must be an absolute, normalized path to a .tgz archive');
  }
  return options;
}

function provisionBrowserRuntime(options) {
  const artifactRoot = secureBrowserProvisionArtifactRoot(options.artifactRoot);
  const runtimeRoot = hostBrowserRuntimeRoot(artifactRoot);
  if (options.package !== undefined) {
    const archive = lstatSafe(options.package);
    if (!archive || archive.isSymbolicLink() || !archive.isFile()) fail(`browser provision --package must be an existing regular file: ${options.package}`);
  }
  assertBrowserProvisionAliasFree(artifactRoot);

  if (options.version === undefined && options.package === undefined) {
    const existing = resolveBrowserRuntime({ targetPath: null, artifactRootPath: artifactRoot, profile: {}, probeAllowed: true });
    if (existing.status === 'available' && !isWithin(artifactRoot, existing.modulePath)) {
      assertBrowserProvisionAliasFree(artifactRoot);
      return reportBrowserProvision(options.json, {
        action: 'reused',
        installDirectory: null,
        browserInstall: 'not-needed',
        runtime: existing,
      }, `BROWSER_PROVISION  reused ${existing.source} ${existing.modulePath} ${existing.moduleVersion}`);
    }
  }

  const requestedVersion = options.version ?? (options.package === undefined ? pinnedPlaywrightVersion() : null);
  const staging = mkdtempSync(join(runtimeRoot, '.staging-'));
  let outcome;
  let failure = null;
  try {
    chmodSync(staging, 0o700);
    outcome = installBrowserRuntime({ options, artifactRoot, runtimeRoot, staging, requestedVersion });
  } catch (error) {
    failure = error;
  } finally {
    rmSync(staging, { recursive: true, force: true, maxRetries: 3, retryDelay: 100 });
  }
  if (failure) fail(`browser provisioning failed: ${failure.message}`);
  return reportBrowserProvision(options.json, outcome,
    `BROWSER_PROVISION  installed host-provisioned ${outcome.runtime.modulePath} ${outcome.runtime.moduleVersion} chromium=${outcome.browserInstall}`);
}

// Nothing is committed until the staged package is verified, alias-free, and has launched
// headless Chromium, so a failed run never replaces a working runtime of the same version.
function installBrowserRuntime({ options, artifactRoot, runtimeRoot, staging, requestedVersion }) {
  const prefix = join(staging, 'install');
  mkdirSync(prefix, { mode: 0o700 });
  runBrowserProvisionChild('npm', [
    'install', '--prefix', prefix, '--no-save', '--no-package-lock', '--no-bin-links', '--ignore-scripts', '--no-audit', '--no-fund',
    options.package ?? `playwright@${requestedVersion}`,
  ], { npm_config_cache: join(staging, 'npm-cache'), npm_config_update_notifier: 'false' }, 600000, 'npm install');

  const stagedModule = join(prefix, 'node_modules', 'playwright');
  const staged = inspectBrowserRuntimeCandidate({ source: 'host-provisioned', path: stagedModule, explicit: true });
  if (staged.invalid) throw new Error(`the installed package is not a usable Playwright module: ${staged.invalid}`);
  if (requestedVersion !== null && staged.moduleVersion !== requestedVersion) {
    throw new Error(`npm installed Playwright ${staged.moduleVersion} instead of the requested ${requestedVersion}`);
  }
  if (!/^\d+\.\d+\.\d+$/.test(staged.moduleVersion)) {
    throw new Error(`the package archive version ${staged.moduleVersion} is not a plain x.y.z release that preflight can discover`);
  }
  assertAliasFreeTree(prefix, 'the installed browser runtime');

  let browserInstall = 'skipped';
  if (!options.skipBrowserInstall) {
    const cli = join(stagedModule, 'cli.js');
    if (!statSafe(cli)?.isFile()) throw new Error('the installed Playwright package has no cli.js to install Chromium; pass --skip-browser-install when Chromium is already cached');
    runBrowserProvisionChild(process.execPath, [cli, 'install', 'chromium'], {}, 1200000, 'Playwright Chromium install');
    browserInstall = 'installed';
  }

  const probedAt = new Date().toISOString();
  const probe = probeBrowserRuntime(staged.modulePath, ensureBrowserProbeScratch(artifactRoot));
  if (!probe.launched) {
    const hint = options.skipBrowserInstall ? '; rerun without --skip-browser-install to download Chromium' : '';
    throw new Error(`Playwright ${staged.moduleVersion} did not launch headless Chromium: ${probe.evidence}${hint}`);
  }
  assertAliasFreeTree(artifactRoot, 'the artifact root');

  const installDirectory = join(runtimeRoot, staged.moduleVersion);
  commitBrowserRuntime(prefix, installDirectory);
  const installed = inspectBrowserRuntimeCandidate({ source: 'host-provisioned', path: join(installDirectory, 'node_modules', 'playwright'), explicit: true });
  if (installed.invalid) throw new Error(`the committed runtime is not a usable Playwright module: ${installed.invalid}`);
  const tree = digestBrowserRuntimeTree(installed.modulePath);
  const launched = `launched headless Chromium: ${probe.executablePath}`;
  return {
    action: 'installed',
    installDirectory,
    browserInstall,
    runtime: {
      status: 'available',
      source: 'host-provisioned',
      modulePath: installed.modulePath,
      moduleVersion: installed.moduleVersion,
      packageJsonSha256: installed.packageJsonSha256,
      moduleTreeSha256: tree.sha256,
      moduleTreeRoots: tree.roots,
      executablePath: probe.executablePath,
      probedAt,
      evidence: limitBrowserRuntimeEvidence(`Playwright ${installed.moduleVersion} provisioned into ${installed.modulePath} ${launched}`),
      candidates: [{ source: 'host-provisioned', modulePath: installed.modulePath, result: 'launched', evidence: limitBrowserRuntimeEvidence(launched) }],
    },
  };
}

function secureBrowserProvisionArtifactRoot(value) {
  if (!value.startsWith('/') || resolve(value) !== value) fail('browser provision --artifact-root must be an absolute, normalized path');
  const entry = lstatSafe(value);
  if (!entry || entry.isSymbolicLink() || !entry.isDirectory()) fail(`browser provision --artifact-root must be an existing directory, not a symbolic link: ${value}`);
  const physical = realpathSync(value);
  if (physical !== value) fail(`browser provision --artifact-root must use its physical path: ${physical}`);
  if (entry.uid !== process.getuid()) fail(`browser provision --artifact-root must be owned by the current user: ${value}`);
  if ((entry.mode & 0o022) !== 0) fail(`browser provision --artifact-root must not be group/world writable: ${value}`);
  return physical;
}

// The host runtime root must stay physically disjoint from the artifact root: the launch
// sandbox confines writes to the artifact root, which is what keeps the module read-only.
function hostBrowserRuntimeRoot(artifactRoot) {
  const home = process.env.HOME || userInfo().homedir;
  if (!nonEmptyString(home) || !home.startsWith('/')) fail('browser provision needs an absolute HOME for the host browser runtime directory');
  const lexical = join(home, '.cache', 'argus', 'browser-runtime');
  try { mkdirSync(lexical, { recursive: true, mode: 0o700 }); }
  catch (error) { fail(`cannot create the host browser runtime directory ${lexical}: ${error.message}`); }
  const entry = lstatSync(lexical);
  if (entry.isSymbolicLink() || !entry.isDirectory()) fail(`the host browser runtime directory must be a real directory: ${lexical}`);
  if (entry.uid !== process.getuid() || (entry.mode & 0o022) !== 0) {
    fail(`the host browser runtime directory must be owned by the current user and not group/world writable: ${lexical}`);
  }
  const physical = realpathSync(lexical);
  if (isWithin(artifactRoot, physical) || isWithin(physical, artifactRoot)) {
    fail(`the host browser runtime directory ${physical} must be physically disjoint from the artifact root ${artifactRoot}`);
  }
  return physical;
}

function pinnedPlaywrightVersion() {
  const lock = readJson(assetPath(requireAsset('typescript-template'), 'package-lock.json'));
  const version = lock?.packages?.['node_modules/playwright']?.version;
  if (typeof version !== 'string' || !/^\d+\.\d+\.\d+$/.test(version)) fail('the packaged TypeScript template lockfile does not pin a plain Playwright x.y.z release');
  return version;
}

// npm and Playwright's installer get HOME, PATH, and only the proxy, CA, registry, and
// download-mirror settings they need to reach the network. PLAYWRIGHT_BROWSERS_PATH is never
// passed, so Chromium lands in the host default cache, outside the artifact root. The running
// Node's own bin directory leads PATH so npm is the one shipped with it, not a version shim.
function runBrowserProvisionChild(file, args, extraEnvironment, timeout, label) {
  const forwarded = {};
  for (const name of ['HTTPS_PROXY', 'HTTP_PROXY', 'NO_PROXY', 'https_proxy', 'http_proxy', 'no_proxy', 'SSL_CERT_FILE', 'SSL_CERT_DIR',
    'NODE_EXTRA_CA_CERTS', 'npm_config_registry', 'NPM_CONFIG_REGISTRY', 'PLAYWRIGHT_DOWNLOAD_HOST']) {
    if (process.env[name]) forwarded[name] = process.env[name];
  }
  const environment = browserRuntimeChildEnvironment({ ...forwarded, ...extraEnvironment });
  environment.PATH = `${dirname(process.execPath)}:${environment.PATH}`;
  try {
    execFileSync(file, args, { stdio: ['ignore', 2, 2], timeout, env: environment });
  } catch (error) {
    if (error?.code === 'ETIMEDOUT') throw new Error(`${label} was killed after ${timeout / 1000} s`);
    if (error?.code === 'ENOENT') throw new Error(`${label} could not start: ${file} was not found`);
    throw new Error(`${label} exited with status ${error?.status ?? error?.signal ?? 'unknown'}`);
  }
}

// Mirrors argus-launch verify_artifact_tree: the launch refuses an artifact root holding any
// symbolic link or multiply linked file, so provisioning must never leave one behind.
function assertBrowserProvisionAliasFree(artifactRoot) {
  try { assertAliasFreeTree(artifactRoot, 'the artifact root'); }
  catch (error) { fail(`browser provisioning failed: ${error.message}`); }
}

function assertAliasFreeTree(root, label) {
  const pending = [root];
  while (pending.length > 0) {
    const directory = pending.pop();
    for (const name of readdirSync(directory)) {
      const path = join(directory, name);
      const entry = lstatSync(path);
      if (entry.isSymbolicLink()) throw new Error(`${label} contains a symbolic link alias: ${path}`);
      if (entry.isDirectory()) pending.push(path);
      else if (entry.isFile() && entry.nlink > 1) throw new Error(`${label} contains a hard-link alias: ${path}`);
    }
  }
}

// Swaps the verified staging prefix into <runtimeRoot>/<version>. A previous install of the
// same version is renamed aside first and restored if the final rename fails.
function commitBrowserRuntime(prefix, installDirectory) {
  let retired = null;
  if (lstatSafe(installDirectory)) {
    retired = join(dirname(installDirectory), `.retired-${basename(installDirectory)}-${randomBytes(6).toString('hex')}`);
    renameSync(installDirectory, retired);
  }
  try {
    renameSync(prefix, installDirectory);
  } catch (error) {
    if (retired) renameSync(retired, installDirectory);
    throw error;
  }
  if (retired) rmSync(retired, { recursive: true, force: true, maxRetries: 3, retryDelay: 100 });
}

function reportBrowserProvision(json, result, line) {
  if (json) {
    console.error(line);
    process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
  } else {
    console.log(line);
  }
  return 0;
}

function isWritableDirectory(path) {
  try {
    if (!statSync(path).isDirectory()) return false;
    accessSync(path, constants.W_OK);
    return true;
  } catch {
    return false;
  }
}

function statSafe(path) {
  try {
    return statSync(path);
  } catch {
    return null;
  }
}

function isWithin(root, path) {
  return path === root || path.startsWith(`${root}${sep}`);
}

function addCheck(checks, id, mandatory, passed, evidence) {
  checks.push({ id, mandatory, status: passed ? 'pass' : mandatory ? 'fail' : 'degraded', evidence });
}

function parseNamedOptions(args, allowed) {
  const options = {};
  for (let index = 0; index < args.length; index += 1) {
    const name = args[index];
    if (!allowed.has(name)) fail(`unknown option: ${name}`);
    const value = args[index + 1];
    if (value == null || value.startsWith('--')) fail(`${name} requires a value`);
    index += 1;
    const key = kebabToCamel(name.slice(2));
    if (Object.hasOwn(options, key)) fail(`duplicate option: ${name}`);
    options[key] = value;
  }
  return options;
}

function loadEngagement(options) {
  const candidate = resolve(options.manifest ?? process.env.ARGUS_ENGAGEMENT_MANIFEST ?? 'ai_agents_internal/engagement.json');
  if (!statSafe(candidate)?.isFile() || lstatSync(candidate).isSymbolicLink()) throw new Error(`engagement manifest must be a real file: ${candidate}`);
  const path = realpathSync(candidate);
  const engagement = readSecureJson(path, 'engagement manifest');
  const errors = validateEngagementManifest(engagement);
  if (errors.length > 0) throw new Error(`invalid manifest ${path}: ${errors.join('; ')}`);
  if (!statSafe(engagement.artifactRoot)?.isDirectory()) throw new Error(`engagement artifactRoot must be an existing directory: ${engagement.artifactRoot}`);
  const physicalArtifactRoot = realpathSync(engagement.artifactRoot);
  if (!safePhysicalPath(physicalArtifactRoot, path)) throw new Error(`engagement manifest escapes its physical artifact root: ${path}`);
  return { manifest: engagement, path };
}

function physicalPathsEquivalent(left, right) {
  try { return realpathSync(resolve(left)) === realpathSync(resolve(right)); }
  catch { return resolve(left) === resolve(right); }
}

function nullablePhysicalPathsEquivalent(left, right) {
  if (left === null || left === undefined || right === null || right === undefined) return left == null && right == null;
  return physicalPathsEquivalent(left, right);
}

function requireOptions(options, required, command) {
  for (const key of required) if (!options[key]) fail(`${command} requires --${camelToKebab(key)}`);
}

function leaseToken(options) {
  const token = options.token ?? process.env.ARGUS_ENGAGEMENT_LEASE_TOKEN;
  if (!token) fail('engagement operation requires --token or ARGUS_ENGAGEMENT_LEASE_TOKEN');
  return token;
}

function readTextInput(input) {
  return input === '-' ? readFileSync(0, 'utf8') : readFileSync(resolve(input), 'utf8');
}

function parsePositiveOption(value, label) {
  if (value == null) return undefined;
  const number = Number(value);
  if (!Number.isFinite(number) || number <= 0) fail(`${label} must be a positive number`);
  return number;
}

function parseBooleanOption(value, label) {
  if (value == null) return undefined;
  if (value === 'true') return true;
  if (value === 'false') return false;
  fail(`${label} must be true or false`);
}

function kebabToCamel(value) {
  return value.replace(/-([a-z])/g, (_, letter) => letter.toUpperCase());
}

function camelToKebab(value) {
  return value.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`);
}

function nonEmptyString(value) {
  return typeof value === 'string' && value.trim().length > 0;
}

function plainObject(value) {
  return value !== null && typeof value === 'object' && !Array.isArray(value);
}

function validDateTime(value) {
  return typeof value === 'string' && Number.isFinite(Date.parse(value));
}

function stableCanonicalJson(value) {
  if (Array.isArray(value)) return `[${value.map(stableCanonicalJson).join(',')}]`;
  if (value && typeof value === 'object') {
    return `{${Object.keys(value).sort().map((key) => `${JSON.stringify(key)}:${stableCanonicalJson(value[key])}`).join(',')}}`;
  }
  return JSON.stringify(value);
}

function copyTemplate(runtime, destination) {
  const entries = prepareTemplateComposition(runtime);
  if (!destination) fail('copy-template requires an empty destination path');
  const target = resolve(destination);
  try {
    assertActiveEngagementWrites([target], 'copy-template');
    inspectEmptyDestination(target);
    writeTemplateEntries(entries, target);
  } catch (error) {
    fail(error.message);
  }
  console.log(`COPIED  ${runtime} template -> ${target}`);
}

// ADAPT path: copies only the runner kit that the shared template contract names for the
// runtime, byte- and mode-exact from the validated composition, so the kit can be ported
// into an existing suite. Every kit entry must match before the destination is touched.
function copyRunnerKit(runtime, destination) {
  const runnerKit = Object.hasOwn(templateContract.templates, String(runtime)) ? templateContract.templates[runtime].runnerKit : null;
  if (!runnerKit) fail('copy-runner-kit runtime must be typescript, java, or python');
  const composition = prepareTemplateComposition(runtime);
  if (!destination) fail('copy-runner-kit requires an empty destination path');
  let selection;
  try {
    selection = selectRunnerKitEntries(composition, runnerKit);
  } catch (error) {
    fail(error.message);
  }
  if (selection.missing.length) fail(`runner kit entry missing: ${selection.missing.join(', ')}`);
  const target = resolve(destination);
  try {
    assertActiveEngagementWrites([target], 'copy-runner-kit');
    inspectEmptyDestination(target);
    writeTemplateEntries(selection.entries, target);
  } catch (error) {
    fail(error.message);
  }
  console.log(`COPIED  ${runtime} runner kit -> ${target}`);
  console.log('Integrate into the existing suite; the kit is not a runnable framework.');
}

function prepareTemplateComposition(runtime) {
  const composition = manifest.templateCompositions?.[runtime];
  if (!composition) fail('copy-template runtime must be typescript, java, or python');
  const layers = [requireAsset(composition.commonAsset), requireAsset(composition.runtimeAsset)];
  const entries = validateTemplateLayers(runtime, layers);
  for (const asset of layers) assertPackagedAsset(asset, `template layer ${asset.id}`);
  return entries;
}

function writeTemplateEntries(entries, target) {
  mkdirSync(target, { recursive: true });
  if (lstatSync(target).isSymbolicLink() || !lstatSync(target).isDirectory()) {
    throw new Error(`template destination must be a real directory: ${target}`);
  }
  for (const entry of entries.filter((item) => item.type === 'directory')) {
    const output = resolve(target, entry.relativePath);
    if (!isWithin(target, output)) throw new Error(`template output escapes destination: ${entry.relativePath}`);
    if (!existsSync(output)) mkdirSync(output);
    if (lstatSync(output).isSymbolicLink() || !lstatSync(output).isDirectory()) {
      throw new Error(`template output directory is unsafe: ${entry.relativePath}`);
    }
    chmodSync(output, entry.mode);
  }
  for (const entry of entries.filter((item) => item.type === 'file')) {
    const output = resolve(target, entry.relativePath);
    if (!isWithin(target, output)) throw new Error(`template output escapes destination: ${entry.relativePath}`);
    if (existsSync(output)) throw new Error(`refusing to overwrite composed template file: ${entry.relativePath}`);
    const parent = dirname(output);
    if (lstatSync(parent).isSymbolicLink() || !lstatSync(parent).isDirectory()) {
      throw new Error(`template output parent is unsafe: ${entry.relativePath}`);
    }
    copyFileSync(entry.source, output, constants.COPYFILE_EXCL);
    chmodSync(output, entry.mode);
  }
}

function scaffoldTemplateAtomically(selection, destination, entries) {
  const target = resolve(destination);
  const initial = inspectEmptyDestination(target);
  const parent = dirname(target);
  mkdirSync(parent, { recursive: true });
  const temporary = mkdtempSync(join(parent, `.${basename(target)}.argus-scaffold-`));
  let published = false;
  try {
    chmodSync(temporary, 0o700);
    writeTemplateEntries(entries, temporary);
    materializeTemplateLayout(temporary, selection);
    const record = resolve(temporary, 'ai_agents_internal', 'template-selection.json');
    mkdirSync(dirname(record), { recursive: true });
    writeFileSync(record, stableTemplateJson(selection), { mode: 0o600, flag: 'wx' });
    chmodSync(record, 0o600);
    publishScaffold(temporary, target, initial);
    published = true;
  } finally {
    if (!published) rmSync(temporary, { recursive: true, force: true });
  }
}

function publishScaffold(temporary, target, initial) {
  const current = inspectEmptyDestination(target);
  if (current.existed !== initial.existed) throw new Error('template destination changed while scaffold was prepared');
  if (initial.existed && current.mode !== initial.mode) throw new Error('template destination mode changed while scaffold was prepared');
  const finalMode = initial.existed ? initial.mode : (0o777 & ~process.umask());
  chmodSync(temporary, finalMode);
  if (!initial.existed) {
    renameSync(temporary, target);
    return;
  }
  rmdirSync(target);
  try {
    renameSync(temporary, target);
  } catch (error) {
    if (!existsSync(target)) {
      mkdirSync(target, { mode: initial.mode });
      chmodSync(target, initial.mode);
    }
    throw error;
  }
}

function validateTemplateLayers(runtime, layers) {
  if (layers.length !== 2 || layers[0].id !== 'common-template' || layers[1].id !== `${runtime}-template`) {
    fail(`${runtime} template composition is invalid`);
  }
  const declarations = [];
  for (const asset of layers) declarations.push(...scanTemplateLayer(asset));
  const exact = new Map();
  const folded = new Map();
  for (const entry of declarations) {
    const priorCase = folded.get(entry.relativePath.toLocaleLowerCase('en-US'));
    if (priorCase && priorCase !== entry.relativePath) {
      fail(`template composition has a case-insensitive collision: ${priorCase} vs ${entry.relativePath}`);
    }
    folded.set(entry.relativePath.toLocaleLowerCase('en-US'), entry.relativePath);
    const prior = exact.get(entry.relativePath);
    if (prior) {
      if (prior.type !== 'directory' || entry.type !== 'directory') {
        fail(`template composition file collision: ${entry.relativePath}`);
      }
      if (prior.mode !== entry.mode) {
        fail(`template composition directory mode collision: ${entry.relativePath}`);
      }
      continue;
    }
    exact.set(entry.relativePath, entry);
  }
  for (const entry of exact.values()) {
    const parts = entry.relativePath.split('/');
    for (let index = 1; index < parts.length; index += 1) {
      const ancestor = exact.get(parts.slice(0, index).join('/'));
      if (ancestor?.type === 'file') {
        fail(`template composition file/ancestor collision: ${ancestor.relativePath} vs ${entry.relativePath}`);
      }
    }
  }
  return [...exact.values()].sort((left, right) => {
    if (left.type !== right.type) return left.type === 'directory' ? -1 : 1;
    const depth = left.relativePath.split('/').length - right.relativePath.split('/').length;
    return depth || left.relativePath.localeCompare(right.relativePath);
  });
}

function scanTemplateLayer(asset) {
  const root = assetPath(asset);
  if (!existsSync(root) || lstatSync(root).isSymbolicLink() || !lstatSync(root).isDirectory()) {
    fail(`template layer ${asset.id} must be a real directory`);
  }
  const entries = [];
  const visit = (directory, prefix = '') => {
    for (const name of readdirSync(directory).sort()) {
      const source = join(directory, name);
      const relativePath = prefix ? `${prefix}/${name}` : name;
      validateTemplateRelativePath(relativePath);
      const info = lstatSync(source);
      if (info.isSymbolicLink()) fail(`template layer ${asset.id} contains a symbolic link: ${relativePath}`);
      if (info.isDirectory()) {
        entries.push({ type: 'directory', relativePath, source, mode: info.mode & 0o777 });
        visit(source, relativePath);
      } else if (info.isFile()) {
        entries.push({ type: 'file', relativePath, source, mode: info.mode & 0o777 });
      } else {
        fail(`template layer ${asset.id} contains an unsupported entry: ${relativePath}`);
      }
    }
  };
  visit(root);
  return entries;
}

function validateTemplateRelativePath(relativePath) {
  if (!relativePath || relativePath.includes('\\') || relativePath.includes('\0')) {
    fail(`template composition contains an unsafe path: ${relativePath || '(empty)'}`);
  }
  const parts = relativePath.split('/');
  if (parts.some((part) =>
    !part || part === '.' || part === '..' ||
    /[\u0000-\u001f\u007f<>:"|?*]/.test(part) ||
    /[. ]$/.test(part) ||
    /^(?:con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\.|$)/i.test(part)
  )) {
    fail(`template composition contains an unsafe path: ${relativePath}`);
  }
}

function assertPackagedAsset(asset, label) {
  const path = assetPath(asset);
  const stats = treeStats(path);
  if (stats.files !== asset.files || stats.bytes !== asset.bytes || stats.sha256 !== asset.sha256) {
    fail(`${label} differs from the packaged asset manifest`);
  }
}

function copyBrowserDriver(destination) {
  if (!destination) fail('copy-browser-driver requires a target repo path');
  const targetRoot = resolve(destination);
  if (!existsSync(targetRoot) || !statSync(targetRoot).isDirectory()) fail(`target repo directory does not exist: ${targetRoot}`);
  const sourceRoot = assetPath(requireAsset('typescript-template'));
  const scriptsDir = join(targetRoot, 'scripts');
  mkdirSync(scriptsDir, { recursive: true });
  const files = [
    ['scripts/hunt-driver.mjs', 'hunt-driver.mjs'],
    ['scripts/driver.config.example.json', 'driver.config.example.json'],
  ];
  const outputs = [
    ...files.map(([, targetName]) => join(scriptsDir, targetName)),
    join(scriptsDir, 'driver-config.schema.json'),
  ];
  assertActiveEngagementWrites(outputs, 'copy-browser-driver');
  for (const [sourceRelative, targetName] of files) {
    const target = join(scriptsDir, targetName);
    if (existsSync(target)) fail(`refusing to overwrite existing file: ${target}`);
    copyFileSync(join(sourceRoot, sourceRelative), target);
    chmodSync(target, statSync(join(sourceRoot, sourceRelative)).mode & 0o777);
  }
  const schemaTarget = join(scriptsDir, 'driver-config.schema.json');
  if (existsSync(schemaTarget)) fail(`refusing to overwrite existing file: ${schemaTarget}`);
  copyFileSync(assetPath(requireAsset('runtime-schemas'), 'driver-config.schema.json'), schemaTarget);
  console.log(`COPIED  isolated browser driver -> ${scriptsDir}`);
}

function requireAsset(id) {
  if (!id) fail('asset id is required; run argus-assets list');
  const asset = manifest.assets.find((item) => item.id === id);
  if (!asset) fail(`unknown asset id: ${id}; run argus-assets list`);
  return asset;
}

function assetPath(asset, child = '') {
  const path = resolve(ROOT, asset.destination, child);
  if (path !== ROOT && !path.startsWith(`${ROOT}${sep}`)) fail(`asset path escapes plugin root: ${asset.destination}`);
  return path;
}

function atomicPrivateWrite(path, content) {
  mkdirSync(dirname(path), { recursive: true });
  if (existsSync(path)) {
    const existing = lstatSync(path);
    if (existing.isSymbolicLink() || !existing.isFile() || existing.nlink !== 1) {
      throw new Error(`private output must be a single-link regular file: ${path}`);
    }
  }
  const temporary = join(dirname(path), `.${basename(path)}.${process.pid}.${randomBytes(6).toString('hex')}.tmp`);
  try {
    writeFileSync(temporary, content, { mode: 0o600, flag: 'wx' });
    if (existsSync(path)) {
      const current = lstatSync(path);
      if (current.isSymbolicLink() || !current.isFile() || current.nlink !== 1) {
        throw new Error(`private output changed to an unsafe filesystem entry: ${path}`);
      }
    }
    renameSync(temporary, path);
  } finally {
    rmSync(temporary, { force: true });
  }
}

function atomicPrivateAppend(path, content, validateCurrent = undefined) {
  mkdirSync(dirname(path), { recursive: true });
  const lockPath = `${path}.append-lock`;
  let acquired = false;
  for (let attempt = 0; attempt < 6000; attempt += 1) {
    try {
      mkdirSync(lockPath, { mode: 0o700 });
      writeFileSync(join(lockPath, 'owner.json'), `${JSON.stringify({ pid: process.pid, acquiredAt: new Date().toISOString() })}\n`, { flag: 'wx', mode: 0o600 });
      acquired = true;
      break;
    } catch (error) {
      if (error.code !== 'EEXIST') {
        rmSync(lockPath, { recursive: true, force: true });
        throw new Error(`cannot acquire private append lock for ${path}: ${error.message}`);
      }
      const lock = lstatSync(lockPath);
      if (lock.isSymbolicLink() || !lock.isDirectory()) throw new Error(`private append lock is unsafe: ${lockPath}`);
      reclaimAbandonedModelControlLock(lockPath);
      Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 10);
    }
  }
  if (!acquired) throw new Error(`timed out acquiring private append lock for ${path}`);
  try {
    let current = '';
    if (existsSync(path)) {
      let descriptor;
      try {
        descriptor = openSync(path, constants.O_RDONLY | (constants.O_NOFOLLOW ?? 0));
        const info = fstatSync(descriptor);
        if (!info.isFile() || info.nlink !== 1) throw new Error(`private append target must be a single-link regular file: ${path}`);
        current = readFileSync(descriptor, 'utf8');
      } finally {
        if (descriptor !== undefined) closeSync(descriptor);
      }
    }
    if (validateCurrent) validateCurrent(current);
    atomicPrivateWrite(path, `${current}${content}`);
  } finally {
    rmSync(lockPath, { recursive: true, force: true });
  }
}

function assertActiveEngagementWrites(paths, label) {
  const discovered = locateEngagementManifest(process.cwd());
  const explicit = process.env.ARGUS_ENGAGEMENT_MANIFEST
    ? locateEngagementManifest(process.cwd(), process.env.ARGUS_ENGAGEMENT_MANIFEST)
    : null;
  if (process.env.ARGUS_ENGAGEMENT_MANIFEST && !explicit) fail(`${label} denied because ARGUS_ENGAGEMENT_MANIFEST does not name an existing manifest`);
  if (discovered && explicit && discovered !== explicit) fail(`${label} denied because the explicit engagement differs from the active working-tree engagement`);
  const manifestPath = explicit ?? discovered;
  if (!manifestPath) return;
  const engagement = readSecureJson(manifestPath, 'active engagement manifest');
  const errors = validateEngagementManifest(engagement);
  if (errors.length > 0) fail(`${label} denied because the active engagement manifest is invalid: ${errors.join('; ')}`);
  for (const candidate of paths) {
    const payload = { tool_name: 'Write', tool_input: { file_path: resolve(candidate) } };
    const decision = evaluateWriteGuard({ manifest: engagement, manifestPath, payload, cwd: process.cwd() });
    if (decision.decision !== 'deny') continue;
    const patterns = readJson(REDACTION_PATTERNS_PATH);
    const patternErrors = validateRedactionPatterns(patterns);
    if (patternErrors.length > 0) fail(`${label} denied and guard audit patterns are invalid: ${patternErrors.join('; ')}`);
    const event = redactValue(buildGuardAudit({ manifest: engagement, payload, decision, timestamp: new Date().toISOString() }), patterns).value;
    const auditPath = resolve(engagement.artifactRoot, engagement.writePolicy.auditPath);
    if (!safePhysicalPath(engagement.artifactRoot, auditPath)) fail(`${label} denied and the guard audit path is unsafe`);
    try {
      atomicPrivateAppend(auditPath, `${JSON.stringify(event)}\n`);
    } catch (error) {
      fail(`${label} denied and guard audit failed closed: ${error.message}`);
    }
    fail(`${label} denied by active engagement rule ${decision.ruleId}: ${decision.reason}`);
  }
}

function inspectEmptyDestination(path) {
  if (!existsSync(path)) return { existed: false, mode: null };
  const info = lstatSync(path);
  if (info.isSymbolicLink()) throw new Error(`destination cannot be a symbolic link: ${path}`);
  if (!info.isDirectory()) throw new Error(`destination is not a directory: ${path}`);
  if (readdirSync(path).length > 0) throw new Error(`refusing to copy into non-empty destination: ${path}`);
  return { existed: true, mode: info.mode & 0o777 };
}

function treeStats(path) {
  const isFile = statSync(path).isFile();
  const files = isFile ? [path] : walkFiles(path);
  const hash = createHash('sha256');
  let bytes = 0;
  for (const file of files.sort()) {
    const rel = isFile ? file.split(sep).at(-1) : relative(path, file).split(sep).join('/');
    const content = readFileSync(file);
    bytes += content.length;
    hash.update('file\0');
    hash.update(rel);
    hash.update('\0');
    hash.update(statSync(file).mode & 0o111 ? 'x' : '-');
    hash.update('\0');
    hash.update(content);
  }
  return { files: files.length, bytes, sha256: hash.digest('hex') };
}

function walkFiles(dir) {
  const out = [];
  for (const name of readdirSync(dir).sort()) {
    const path = join(dir, name);
    const stat = lstatSync(path);
    if (stat.isSymbolicLink()) fail(`unsupported symbolic link in plugin: ${path}`);
    if (stat.isDirectory()) out.push(...walkFiles(path));
    else if (stat.isFile()) out.push(path);
    else fail(`unsupported filesystem entry in plugin: ${path}`);
  }
  return out;
}

function resolveExistingPhysicalInput(input, base = process.cwd()) {
  const candidate = resolve(base, input);
  if (!existsSync(candidate) || lstatSync(candidate).isSymbolicLink()) return candidate;
  return realpathSync(candidate);
}

function readJson(path) {
  try {
    return JSON.parse(readFileSync(path, 'utf8'));
  } catch (error) {
    fail(`cannot parse ${path}: ${error.message}`);
  }
}

function readSecureSingleLink(path, label) {
  let before;
  try { before = lstatSync(path); }
  catch (error) { fail(`${label} is unavailable: ${error.message}`); }
  if (!before.isFile() || before.isSymbolicLink() || before.nlink !== 1) fail(`${label} must be a non-aliased regular file`);
  let descriptor;
  try {
    descriptor = openSync(path, constants.O_RDONLY | (constants.O_NOFOLLOW ?? 0));
    const opened = fstatSync(descriptor);
    if (!opened.isFile() || opened.nlink !== 1 || opened.dev !== before.dev || opened.ino !== before.ino) fail(`${label} changed during secure open`);
    const raw = readFileSync(descriptor);
    const after = fstatSync(descriptor);
    const linked = lstatSync(path);
    if (!linked.isFile() || linked.isSymbolicLink() || linked.nlink !== 1 || linked.dev !== opened.dev || linked.ino !== opened.ino ||
        after.dev !== opened.dev || after.ino !== opened.ino || after.size !== opened.size || after.mtimeMs !== opened.mtimeMs || after.ctimeMs !== opened.ctimeMs) {
      fail(`${label} changed during secure read`);
    }
    return raw;
  } finally {
    if (descriptor !== undefined) closeSync(descriptor);
  }
}

function readSecureJson(path, label) {
  const raw = readSecureSingleLink(path, label);
  try { return JSON.parse(raw.toString('utf8')); }
  catch (error) { fail(`${label} is not valid JSON: ${error.message}`); }
}

function fail(message) {
  console.error(`FAIL  ${message}`);
  process.exit(1);
}
