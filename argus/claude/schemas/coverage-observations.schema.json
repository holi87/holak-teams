{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holi87/holak-teams/argus/schemas/coverage-observations.schema.json",
  "title": "Argus coverage observation collection v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "engagementId",
    "observations"
  ],
  "properties": {
    "$schema": {
      "const": "argus/coverage-observations@2"
    },
    "schemaVersion": {
      "const": 2
    },
    "engagementId": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    }
  },
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^EVD-[0-9]{4}$"
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "pattern": "^EVD-[0-9]{4}$"
        },
        "caseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observationId",
        "lane",
        "surfaceId",
        "executions",
        "assertions",
        "evidenceIds",
        "defectRefs"
      ],
      "properties": {
        "observationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:SRF-[A-Z0-9][A-Z0-9-]*$"
        },
        "lane": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "surfaceId": {
          "type": "string",
          "pattern": "^SRF-[A-Z0-9][A-Z0-9-]*$"
        },
        "executions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/execution"
          }
        },
        "assertions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "oracleId",
              "evidenceIds",
              "controlEvidenceIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "oracleId": {
                "type": "string",
                "minLength": 1
              },
              "evidenceIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^EVD-[0-9]{4}$"
                }
              },
              "controlEvidenceIds": {
                "$ref": "#/$defs/evidenceIds"
              }
            }
          }
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        },
        "defectRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:BUG-[0-9]{4}|[A-Z]{3}-[0-9]{3,4})$"
          }
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "obligationId",
              "oracleId",
              "outcome",
              "evidenceIds",
              "controlEvidenceIds"
            ],
            "properties": {
              "obligationId": {
                "type": "string",
                "pattern": "^CASE-[A-Z0-9-]+$"
              },
              "oracleId": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "enum": [
                  "passed",
                  "failed",
                  "blocked"
                ]
              },
              "evidenceIds": {
                "$ref": "#/$defs/evidenceIds"
              },
              "controlEvidenceIds": {
                "$ref": "#/$defs/evidenceIds"
              },
              "execution": {
                "$ref": "#/$defs/execution"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
