{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holi87/holak-teams/argus/schemas/evidence-reference.schema.json",
  "title": "Argus redacted evidence reference collection v3",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "engagementId", "references"],
  "properties": {
    "$schema": { "const": "argus/evidence-reference@3" }, "schemaVersion": { "const": 3 }, "engagementId": { "type": "string", "minLength": 1 },
    "references": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/reference" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "textualRedaction": { "properties": { "redaction": { "enum": ["redacted", "synthetic", "public"] } } },
    "binaryRedaction": { "required": ["review"], "properties": { "redaction": { "enum": ["masked", "synthetic"] } } },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer", "reviewedAt", "method", "auditTimestamp"],
      "properties": {
        "reviewer": { "$ref": "#/$defs/slug" }, "reviewedAt": { "type": "string", "format": "date-time" },
        "method": { "enum": ["region-mask", "synthetic-content"] }, "auditTimestamp": { "type": "string", "format": "date-time" }
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "mediaType", "source", "collectedBy", "capturedAt", "redaction", "sha256", "relatedBugIds", "relatedSurfaceIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^EVD-[0-9]{4}$" },
        "kind": { "enum": ["text", "http", "har", "trace", "metric", "log", "screenshot", "video", "dom-snapshot", "runner-result"] },
        "mediaType": { "type": "string", "pattern": "^[a-z]+/[a-z0-9.+-]+$" }, "source": { "type": "string", "minLength": 1 },
        "collectedBy": { "$ref": "#/$defs/slug" }, "capturedAt": { "type": "string", "format": "date-time" },
        "redaction": { "enum": ["redacted", "synthetic", "public", "masked"] },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "relatedBugIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^BUG-[0-9]{4}$" } },
        "relatedSurfaceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^SRF-[A-Z0-9][A-Z0-9-]*$" } },
        "review": { "$ref": "#/$defs/review" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "screenshot" } } }, "then": { "allOf": [{ "$ref": "#/$defs/binaryRedaction" }], "properties": { "mediaType": { "enum": ["image/png", "image/jpeg", "image/webp"] } } } },
        { "if": { "properties": { "kind": { "const": "video" } } }, "then": { "allOf": [{ "$ref": "#/$defs/binaryRedaction" }], "properties": { "mediaType": { "enum": ["video/webm", "video/mp4"] } } } },
        { "if": { "properties": { "kind": { "const": "trace" } } }, "then": { "properties": { "mediaType": { "enum": ["application/zip", "application/json", "text/plain"] } } } },
        { "if": { "required": ["kind", "mediaType"], "properties": { "kind": { "const": "trace" }, "mediaType": { "const": "application/zip" } } }, "then": { "$ref": "#/$defs/binaryRedaction" } },
        { "if": { "required": ["kind", "mediaType"], "properties": { "kind": { "const": "trace" }, "mediaType": { "enum": ["application/json", "text/plain"] } } }, "then": { "$ref": "#/$defs/textualRedaction" } },
        { "if": { "properties": { "kind": { "enum": ["text", "http", "har", "metric", "log", "dom-snapshot", "runner-result"] } } }, "then": { "$ref": "#/$defs/textualRedaction" } },
        { "if": { "properties": { "kind": { "const": "har" } } }, "then": { "properties": { "mediaType": { "const": "application/json" } } } },
        { "if": { "properties": { "kind": { "const": "runner-result" } } }, "then": { "properties": { "mediaType": { "const": "application/json" } } } },
        { "if": { "properties": { "kind": { "const": "dom-snapshot" } } }, "then": { "properties": { "mediaType": { "enum": ["text/html", "application/xhtml+xml", "text/yaml"] } } } },
        { "if": { "properties": { "kind": { "const": "text" } } }, "then": { "properties": { "mediaType": { "enum": ["text/plain", "text/markdown"] } } } },
        { "if": { "properties": { "kind": { "const": "http" } } }, "then": { "properties": { "mediaType": { "enum": ["text/plain", "application/json", "message/http"] } } } },
        { "if": { "properties": { "kind": { "const": "metric" } } }, "then": { "properties": { "mediaType": { "enum": ["text/plain", "application/json", "text/csv"] } } } },
        { "if": { "properties": { "kind": { "const": "log" } } }, "then": { "properties": { "mediaType": { "enum": ["text/plain", "application/json", "application/x-ndjson"] } } } }
      ]
    }
  }
}
