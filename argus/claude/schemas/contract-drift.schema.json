{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holi87/holak-teams/argus/schemas/contract-drift.schema.json",
  "title": "Argus contract drift diff",
  "description": "Kalchas-owned machine-readable diff of the on-disk specification, the live specification, the requirements prose, and observed runtime. An empty rows array is the legitimate shape of a run whose sources agree. Every row is a candidate with a default owner, never a note; the owning lane closes it as filed, refuted, or residual in its RESULT envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "engagementId", "rows"],
  "properties": {
    "$schema": { "const": "argus/contract-drift@1" },
    "schemaVersion": { "const": 1 },
    "engagementId": { "type": "string", "minLength": 1 },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject", "kind", "sides", "owner"],
      "properties": {
        "id": { "type": "string", "pattern": "^DRIFT-[0-9]{3}$" },
        "subject": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["operation-present-in-one-source", "field-definition-differs", "documented-entity-without-implementation", "documented-limit-without-implementation"]
        },
        "sides": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["disk-spec", "live-spec", "prose", "runtime"] }
        },
        "statements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["side", "wording"],
            "properties": {
              "side": { "enum": ["disk-spec", "live-spec", "prose", "runtime"] },
              "wording": { "type": "string", "minLength": 1 }
            }
          }
        },
        "owner": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "disposition": { "enum": ["open", "filed", "refuted", "residual"] },
        "dispositionRef": { "type": "string", "minLength": 1 }
      }
    }
  }
}
