{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holi87/holak-teams/argus/schemas/counterfactual-fixture.schema.json",
  "title": "Argus counterfactual fixture",
  "description": "solution/counterfactual/BUG-NNNN.json (TEMPLATE-CONTRACT.md SD-10): either a fixture that serves the regression the correct subject response and each tamper through the in-worker stub, or a justified exemption. The template loaders additionally require bugId to equal the file name, unique exchange and tamper ids, a subject that names an exchange, and, with contract, a correct subject response that has contract.status and passes the strict schema oracle for contract.operationId.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "bugId"],
  "properties": {
    "$schema": { "const": "argus/counterfactual-fixture@1" },
    "schemaVersion": { "const": 1 },
    "bugId": { "type": "string", "pattern": "^BUG-[0-9]{4}$" },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceRef"],
      "properties": {
        "kind": { "enum": ["requirement", "contract", "justified-invariant"] },
        "sourceRef": { "$ref": "#/$defs/text" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "status"],
      "properties": {
        "operationId": { "$ref": "#/$defs/text" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "exchanges": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/exchange" }
    },
    "subject": { "$ref": "#/$defs/variantId" },
    "tampers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/tamper" },
      "contains": {
        "type": "object",
        "required": ["id"],
        "properties": { "id": { "const": "observed-defect" } }
      }
    },
    "exemption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "justification"],
      "properties": {
        "reason": { "enum": ["front-end-logic", "timing-or-load", "data-layer", "fault-injection", "non-http-protocol"] },
        "justification": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" }
      }
    }
  },
  "oneOf": [
    {
      "required": ["oracle", "exchanges", "subject", "tampers"],
      "not": { "required": ["exemption"] }
    },
    {
      "required": ["exemption"],
      "not": {
        "anyOf": [
          { "required": ["oracle"] },
          { "required": ["contract"] },
          { "required": ["exchanges"] },
          { "required": ["subject"] },
          { "required": ["tampers"] }
        ]
      }
    }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "status": { "type": "integer", "minimum": 100, "maximum": 599 },
    "variantId": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "headers": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9!#$%&'*+.^_`|~-]+$" },
          "additionalProperties": { "type": "string" }
        },
        "body": true
      }
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "request", "response"],
      "properties": {
        "id": { "$ref": "#/$defs/variantId" },
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path"],
          "properties": {
            "method": { "type": "string", "pattern": "^[A-Z]+$" },
            "path": { "type": "string", "pattern": "^/[^?#]*$" },
            "query": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          }
        },
        "response": { "$ref": "#/$defs/response" }
      }
    },
    "tamper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "response"],
      "properties": {
        "id": { "allOf": [{ "$ref": "#/$defs/variantId" }, { "not": { "const": "correct" } }] },
        "response": { "$ref": "#/$defs/response" }
      }
    }
  }
}
