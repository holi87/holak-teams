      "claude": {
        "model": "claude-haiku-4-5-20251001"
      },
      "codex": {
        "model": "gpt-6-luna",
        "reasoningEffort": "medium"
      },
      "eligibility": [
        "bounded-subrole",
        "no-quality-judgment",
        "deterministic-output-schema",
        "validator-passes-before-merge"
      ]
    }
  },
  "executionProfiles": {
