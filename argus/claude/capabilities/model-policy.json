        "model": "claude-opus-5-5",
        "effort": "max"
      },
      "codex": {
        "model": "gpt-6-astra",
        "reasoningEffort": "high"
      }
    }
  },
  "fallbackPolicies": {
    "frontier-fail-closed": {
      "modelUnavailable": "backoff-retry-frontier-then-escalate-operator",
      "turnLimit": "auto-continue-frontier-then-escalate-operator",
      "allowWeakerModel": false,
      "autoContinue": {
        "enabled": true,
        "workerSignals": [
          "turn-limit",
          "repeated-failure"
        ],
        "outcomeSignals": [
          "no-artifact",
          "zero-candidates"
        ],
        "checkpointlessSignals": [
          "turn-limit",
          "no-artifact",
          "zero-candidates"
        ],
        "zeroCandidatesRoles": [
          "ariadne",
          "perseus",
          "tiresias",
          "tyche"
        ],
        "maxAutoContinuations": 3,
        "maxCheckpointlessRetries": 1,
        "unavailableBackoffSeconds": [
          60,
          180,
          300
        ],
        "excludedAgents": [
          "odysseus"
        ]
      }
    },
    "upward-only": {
      "modelUnavailable": "escalate-to-frontier",
      "turnLimit": "escalate-to-frontier",
      "allowWeakerModel": false,
      "maxEscalations": 1
    }
  },
  "escalationProfiles": {
    "orchestration": [
      "ambiguity",
      "safety",
      "cross-lane",
      "repeated-failure",
      "turn-limit"
    ],
    "judgment": [
      "ambiguity",
      "safety",
      "conflicting-evidence",
      "repeated-failure",
      "turn-limit"
    ],
    "analysis": [
