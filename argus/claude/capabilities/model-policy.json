      "repeated-failure",
      "turn-limit"
    ],
    "schema-bound": [
      "schema-validation-failure",
      "ambiguity",
      "repeated-failure",
      "turn-limit"
    ]
  },
  "mechanicalDowngrade": {
    "fullRoleAllowed": false,
    "requiresBoundedSubrole": true,
    "requiresDeterministicSchema": true,
    "requiresValidatorPass": true,
    "forbiddenWhenQualityJudgment": true
  },
  "routing": {
    "decisionDirectory": "ai_agents_internal/model-decisions",
    "decisionSchema": "argus/model-decision@3",
    "requiredEnforcements": [
      "model",
      "effort",
      "maxTurns"
    ],
    "codexReasoningEscalation": {
      "executionProfile": "astra-reasoning",
      "signals": [
        "ambiguity",
        "cross-lane",
        "conflicting-evidence",
        "oracle-ambiguity"
      ],
      "maxTurns": 80
    }
  },
  "telemetry": {
    "defaultPath": "ai_agents_internal/model-telemetry.jsonl",
    "schema": "argus/model-telemetry-event@3",
    "allowedFields": [
      "schema",
      "timestamp",
      "eventId",
      "decisionId",
      "decisionIntegritySha256",
      "adapterId",
      "adapterSnapshotSha256",
      "engagementId",
      "dispatchId",
      "attempt",
      "agent",
      "runtime",
      "tier",
      "model",
      "effort",
      "maxTurns",
      "signal",
      "reasonCode",
      "fallbackUsed",
      "success",
      "inputTokens",
      "outputTokens",
      "totalTokens",
      "durationMs",
      "reportedCostUsd"
    ],
    "forbiddenFields": [
      "prompt",
      "completion",
      "target",
      "url",
      "path",
      "account",
      "token",
      "evidence"
    ]
  },
  "controllerBudget": {
    "agent": "odysseus",
    "closeoutReserveTurns": 30
