{
  "$schema": "./schemas/model-policy.schema.json",
  "schemaVersion": 2,
  "policyId": "argus/model-policy@2",
  "baseline": {
    "decision": "adopt-11-frontier-16-standard",
    "frontierRoles": 11,
    "standardRoles": 16,
    "mechanicalFullRoles": 0,
    "benchmark": "model-policy.benchmark.json",
    "standardAllowlist": [
      {
        "slug": "aegis",
        "justification": "Implements established API baselines and confirmed defects against validated shared harness contracts."
      },
      {
        "slug": "antigone",
        "justification": "Executes accessibility probes against explicit WCAG oracles; Minos retains final defect adjudication."
      },
      {
        "slug": "asklepios",
        "justification": "Diagnoses suite flakiness using recorded runs; independent review retains final automation acceptance."
      },
      {
        "slug": "atalanta",
        "justification": "Executes API hunting with explicit protocol and state oracles; ambiguous evidence requires upward escalation."
      },
      {
        "slug": "charon",
        "justification": "Executes scoped database probes against declared invariants; complex isolation disputes require upward escalation."
      },
      {
        "slug": "daidalos",
        "justification": "Implements established UI baselines and confirmed defects in the shared harness with independent review."
      },
      {
        "slug": "hermes",
        "justification": "Measures scoped performance behavior against declared budgets; ambiguous attribution requires upward escalation."
      },
      {
        "slug": "lynceus",
        "justification": "Examines visual behavior against explicit references; disputed evidence remains subject to canonical adjudication."
      },
      {
        "slug": "mnemosyne",
        "justification": "Implements database regression cases from established baselines and confirmed defects under validated contracts."
      },
      {
        "slug": "nike",
        "justification": "Executes scoped fault injection and verified restoration; uncertain safety or oracles require upward escalation."
      },
      {
        "slug": "orion",
        "justification": "Executes functional UI hunting against declared journeys and oracles; Minos retains defect confirmation."
      },
      {
        "slug": "penelope",
        "justification": "Builds schema-bound baseline path inventories; ambiguous behavior requires upward escalation."
      },
      {
        "slug": "pistis",
        "justification": "Builds consumer contract coverage against declared schemas; uncertain compatibility requires upward escalation."
      },
      {
        "slug": "proteus",
        "justification": "Executes protocol hunting against explicit state and message oracles; ambiguous concurrency requires upward escalation."
      },
      {
        "slug": "talos",
        "justification": "Implements established protocol regressions in the shared harness with independent review."
      },
      {
        "slug": "theseus",
        "justification": "Builds schema-bound path inventories from discovered operations and states with validator checks."
      }
    ]
  },
  "tiers": {
    "frontier": {
      "rank": 2,
      "qualityCritical": true,
      "claude": {
        "model": "claude-opus-5-5",
        "effort": "max"
      },
      "codex": {
        "model": "gpt-6-sol",
        "reasoningEffort": "xhigh"
      }
    },
    "standard": {
      "rank": 1,
      "qualityCritical": false,
      "claude": {
        "model": "claude-sonnet-5-5",
        "effort": "medium"
      },
      "codex": {
        "model": "gpt-6-sol",
        "reasoningEffort": "medium"
      }
    },
    "mechanical": {
      "rank": 0,
