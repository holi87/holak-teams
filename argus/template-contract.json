{
  "$schema": "./schemas/template-contract.schema.json",
  "schemaVersion": 2,
  "contractId": "argus/template-contract@2",
  "runner": {
    "modes": ["baseline", "defect-evidence", "candidate-regression", "full-suite"],
    "result": "reports/argus-runner-result.json",
    "resultSchema": "argus/runner-result@1",
    "events": "reports/outcomes.raw.tsv",
    "evidenceRoot": "reports/evidence",
    "categories": ["product", "automation", "infrastructure", "skip", "policy"],
    "exitCodes": [0, 10, 11, 12, 13, 14, 15],
    "library": "scripts/runner-lib.sh",
    "inventory": "reports/test-inventory.tsv",
    "expectedBugs": "reports/expected-bugs.txt",
    "counterfactualPlan": "reports/counterfactual-plan.tsv",
    "adapterStatus": "reports/argus-adapter-status.txt",
    "passArtifacts": "reports/evidence/passes",
    "evidencePasses": ["live", "repeat", "cf-correct", "cf-tamper"],
    "activation": "ARGUS_RUNNER_MODE"
  },
  "tags": {
    "lanes": ["api", "ui", "perf", "security", "db", "resilience"],
    "harnessLanes": ["contract-smoke", "setup"],
    "bugLinked": "regression",
    "bugProvenance": "@bug:<canonical-or-origin>",
    "quarantine": "quarantine",
    "contractSmoke": "contract-smoke"
  },
  "retryPolicy": {
    "maximumAttempts": 1,
    "automaticRetries": false,
    "rule": "Fix nondeterminism at its source; never hide it with retry or rerun configuration."
  },
  "quarantine": {
    "ledger": "solution/quarantine.tsv",
    "columns": ["case_id", "owner", "reason", "expires_on", "issue"],
    "selection": "Excluded from native execution in every mode and emitted as an approved skip only while the ledger entry is valid.",
    "missingOrExpired": "Policy failure; never a silent omission.",
    "forbiddenFor": ["regression"]
  },
  "lanePlan": {
    "file": "solution/test-lanes.tsv",
    "columns": ["lane", "state", "owner", "prerequisites", "reason"],
    "states": ["enabled", "disabled"],
    "undecided": "not-yet-planned"
  },
  "environment": {
    "file": "solution/environment.tsv",
    "columns": ["kind", "command", "note"],
    "kinds": ["reset", "verify"],
    "resetOptIn": "ARGUS_ENVIRONMENT_RESET=execute",
    "resetAuthorizationAction": "destructive",
    "undecided": "not-yet-planned"
  },
  "counterfactual": {
    "directory": "solution/counterfactual",
    "fixtureSchema": "argus/counterfactual-fixture@1",
    "requiredTamper": "observed-defect",
    "exemptions": ["front-end-logic", "timing-or-load", "data-layer", "fault-injection", "non-http-protocol"]
  },
  "templates": {
    "typescript": {
      "framework": "playwright",
      "runner": "playwright-test",
      "packageManagers": ["npm"],
      "extensionPoints": ["package-manager-adapter", "test-root", "harness-root", "ci-command"],
      "adapter": "scripts/argus-playwright-reporter.mjs",
      "provenanceMarker": "@bug:<canonical-or-origin>",
      "laneMarker": "playwright-project",
      "runnerKit": [
        "scripts/runner-lib.sh",
        "scripts/runner-contract.sh",
        "scripts/outcome-event.sh",
        "scripts/quarantine-contract.sh",
        "scripts/lane-plan.sh",
        "scripts/environment-gate.sh",
        "scripts/inventory-gate.sh",
        "scripts/evidence-gate.sh",
        "solution/test-lanes.tsv",
        "solution/environment.tsv",
        "solution/quarantine.tsv",
        "solution/counterfactual/",
        "scripts/argus-playwright-reporter.mjs",
        "src/argus/",
        "src/oracles/",
        "tests/contract/oracles-contract.selftest.spec.ts",
        "tests/contract/oracles-data.selftest.spec.ts",
        "tests/contract/oracles-behavior.selftest.spec.ts",
        "tests/contract/fixtures/"
      ]
    },
    "java": {
      "framework": "junit-playwright-restassured",
      "runner": "junit5",
      "packageManagers": ["maven"],
      "extensionPoints": ["build-tool-adapter", "test-root", "harness-root", "ci-command"],
      "adapter": "qa.support.argus.ArgusOutcomeListener",
      "provenanceMarker": "@Tag(\"bug:<canonical-or-origin>\")",
      "laneMarker": "@Tag(\"<lane>\")",
      "runnerKit": [
        "scripts/runner-lib.sh",
        "scripts/runner-contract.sh",
        "scripts/outcome-event.sh",
        "scripts/quarantine-contract.sh",
        "scripts/lane-plan.sh",
        "scripts/environment-gate.sh",
        "scripts/inventory-gate.sh",
        "scripts/evidence-gate.sh",
        "solution/test-lanes.tsv",
        "solution/environment.tsv",
        "solution/quarantine.tsv",
        "solution/counterfactual/",
        "src/test/java/qa/support/argus/",
        "src/test/java/qa/support/oracles/",
        "src/test/java/qa/support/CreatedResources.java",
        "src/test/java/qa/contract/OraclesContractSelfTest.java",
        "src/test/java/qa/contract/OraclesDataSelfTest.java",
        "src/test/java/qa/contract/OraclesBehaviorSelfTest.java",
        "src/test/resources/openapi.selftest.json",
        "src/test/resources/META-INF/services/",
        "src/test/resources/junit-platform.properties"
      ]
    },
    "python": {
      "framework": "pytest-playwright-httpx",
      "runner": "pytest",
      "packageManagers": ["pip"],
      "extensionPoints": ["environment-manager-adapter", "test-root", "harness-root", "ci-command"],
      "adapter": "qa.argus_plugin",
      "provenanceMarker": "@pytest.mark.bug(\"<canonical-or-origin>\")",
      "laneMarker": "pytest.mark.<lane>",
      "runnerKit": [
        "scripts/runner-lib.sh",
        "scripts/runner-contract.sh",
        "scripts/outcome-event.sh",
        "scripts/quarantine-contract.sh",
        "scripts/lane-plan.sh",
        "scripts/environment-gate.sh",
        "scripts/inventory-gate.sh",
        "scripts/evidence-gate.sh",
        "solution/test-lanes.tsv",
        "solution/environment.tsv",
        "solution/quarantine.tsv",
        "solution/counterfactual/",
        "src/qa/argus_plugin.py",
        "src/qa/argus/",
        "src/qa/oracles/",
        "tests/contract/test_oracles_contract_selftest.py",
        "tests/contract/test_oracles_data_selftest.py",
        "tests/contract/test_oracles_behavior_selftest.py",
        "tests/contract/fixtures/"
      ]
    }
  }
}
