{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holi87/holak-teams/scripts/eval/discovery/schemas/comparison-config.schema.json",
  "title": "Argus discovery evaluation comparison configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "variants", "repeats"],
  "properties": {
    "schema": { "const": "argus-eval/comparison-config@2" },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/variant" }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["A", "B"] }
    },
    "builds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["faulty", "corrected"] }
    },
    "repeats": { "type": "integer", "minimum": 2, "maximum": 20 },
    "seeds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": { "type": "integer", "minimum": 1, "maximum": 999999 }
    },
    "secondsByMode": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "A": { "type": "integer", "minimum": 1, "maximum": 86400 },
        "B": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "tokens": { "type": ["integer", "null"], "minimum": 1 },
    "workRoot": { "type": "string", "pattern": "^/" },
    "adapterEnv": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?!(?:PATH|HOME|TMPDIR)$)[A-Z][A-Z0-9_]{0,63}$" }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "repeats": { "type": "integer", "minimum": 1, "maximum": 5 },
        "perSeedMatrix": { "type": "boolean" },
        "secondsPerRunner": { "type": "integer", "minimum": 1, "maximum": 7200 }
      }
    },
    "corpusModule": { "type": "string", "minLength": 1 },
    "testMode": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "testMode": { "const": false } } },
      "then": {
        "properties": {
          "secondsByMode": {
            "properties": {
              "A": { "minimum": 1800 },
              "B": { "minimum": 1800 }
            }
          },
          "replay": {
            "properties": {
              "secondsPerRunner": { "minimum": 60 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision", "command"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
