{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/holi87/holak-teams/scripts/eval/discovery/schemas/discovery-baseline.schema.json",
  "title": "Argus discovery recorded baseline v1 (the model-quality release gate's reference: not recorded, or one scored discovery summary's gated metrics bound to its plugin digest)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "thresholds", "waivers"],
  "properties": {
    "schema": { "const": "argus-eval/discovery-baseline@1" },
    "status": { "enum": ["not-recorded", "recorded"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "recordedAt": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argusVersion", "pluginDigest", "revision"],
      "properties": {
        "argusVersion": { "type": "string", "pattern": "^[0-9A-Za-z.+-]+$" },
        "pluginDigest": { "$ref": "#/$defs/sha256" },
        "revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "protocol": { "$ref": "#/$defs/protocol" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["perMode"],
      "properties": {
        "perMode": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "A": { "$ref": "#/$defs/modeAMetrics" },
            "B": { "$ref": "#/$defs/modeMetrics" }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^evaluations/argus-[0-9A-Za-z.+-]+-[a-f0-9]{12}\\.json$" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared"],
      "properties": {
        "declared": { "enum": ["same-user", "separate-user"] }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxMeanDetectedSeedDrop", "maxPrecisionDrop", "maxRegressionFailToPassDrop"],
      "properties": {
        "maxMeanDetectedSeedDrop": { "type": "number", "minimum": 0 },
        "maxPrecisionDrop": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxRegressionFailToPassDrop": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "waivers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pluginDigest", "reason", "approvedBy", "createdAt"],
        "properties": {
          "pluginDigest": { "$ref": "#/$defs/sha256" },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "approvedBy": { "type": "string", "minLength": 1, "maxLength": 200 },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "not-recorded" } } },
      "then": {
        "required": ["reason"],
        "additionalProperties": false,
        "properties": { "schema": {}, "status": {}, "reason": {}, "thresholds": {}, "waivers": {} }
      }
    },
    {
      "if": { "properties": { "status": { "const": "recorded" } } },
      "then": {
        "required": ["recordedAt", "subject", "corpus", "protocol", "metrics", "summary", "isolation"],
        "additionalProperties": false,
        "properties": { "schema": {}, "status": {}, "recordedAt": {}, "subject": {}, "corpus": {}, "protocol": {}, "metrics": {}, "summary": {}, "isolation": {}, "thresholds": {}, "waivers": {} }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modes", "builds", "repeats", "seeds", "secondsByMode", "tokens", "replay", "testMode", "judge", "spotCheck"],
      "properties": {
        "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["A", "B"] } },
        "builds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["faulty", "corrected"] } },
        "repeats": { "type": "integer", "minimum": 3, "maximum": 20 },
        "seeds": { "type": "array", "minItems": 3, "maxItems": 20, "items": { "type": "integer", "minimum": 1, "maximum": 999999 } },
        "secondsByMode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["A", "B"],
          "properties": {
            "A": { "type": "integer", "minimum": 1, "maximum": 86400 },
            "B": { "type": "integer", "minimum": 1, "maximum": 86400 }
          }
        },
        "tokens": { "type": ["integer", "null"], "minimum": 1 },
        "replay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "repeats": { "type": "integer", "minimum": 1, "maximum": 5 },
            "perSeedMatrix": { "type": "boolean" },
            "secondsPerRunner": { "type": "integer", "minimum": 1, "maximum": 7200 }
          }
        },
        "testMode": { "const": false },
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["model", "effort", "passes", "systemPromptSha256", "claudeVersion", "includeSuspected"],
          "properties": {
            "model": { "const": "opus" },
            "effort": { "const": "max" },
            "passes": { "type": "integer", "minimum": 1, "maximum": 5 },
            "systemPromptSha256": { "$ref": "#/$defs/sha256" },
            "claudeVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
            "includeSuspected": { "type": "boolean" }
          }
        },
        "spotCheck": {
          "type": "object",
          "additionalProperties": false,
          "required": ["all", "rate", "minimum", "items", "reviewed", "pending"],
          "properties": {
            "all": { "type": "boolean" },
            "rate": { "type": ["number", "null"], "minimum": 0.000001, "maximum": 1 },
            "minimum": { "type": ["integer", "null"], "minimum": 0, "maximum": 999999 },
            "items": { "type": "integer", "minimum": 0 },
            "reviewed": { "type": "integer", "minimum": 0 },
            "pending": { "const": 0 }
          }
        }
      }
    },
    "perSurfaceRecall": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["seeded", "detected", "recall"],
        "properties": {
          "seeded": { "type": "integer", "minimum": 0 },
          "detected": { "type": "integer", "minimum": 0 },
          "recall": { "$ref": "#/$defs/rate" }
        }
      }
    },
    "modeMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faultyRuns", "seedsPerFaultyRun", "meanDetectedSeeds", "meanRecall", "meanCriticalRecall", "pooledPrecision", "perSurfaceRecall"],
      "properties": {
        "faultyRuns": { "type": "integer", "minimum": 1 },
        "seedsPerFaultyRun": { "type": "number", "minimum": 0 },
        "meanDetectedSeeds": { "type": "number", "minimum": 0 },
        "meanRecall": { "$ref": "#/$defs/rate" },
        "meanCriticalRecall": { "$ref": "#/$defs/rate" },
        "pooledPrecision": { "$ref": "#/$defs/rate" },
        "perSurfaceRecall": { "$ref": "#/$defs/perSurfaceRecall" }
      }
    },
    "modeAMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faultyRuns", "seedsPerFaultyRun", "meanDetectedSeeds", "meanRecall", "meanCriticalRecall", "pooledPrecision", "perSurfaceRecall", "regression"],
      "properties": {
        "faultyRuns": { "type": "integer", "minimum": 1 },
        "seedsPerFaultyRun": { "type": "number", "minimum": 0 },
        "meanDetectedSeeds": { "type": "number", "minimum": 0 },
        "meanRecall": { "$ref": "#/$defs/rate" },
        "meanCriticalRecall": { "$ref": "#/$defs/rate" },
        "pooledPrecision": { "$ref": "#/$defs/rate" },
        "perSurfaceRecall": { "$ref": "#/$defs/perSurfaceRecall" },
        "regression": {
          "type": "object",
          "additionalProperties": false,
          "required": ["failToPassRate", "specificRate", "flakyRate"],
          "properties": {
            "failToPassRate": { "$ref": "#/$defs/rate" },
            "specificRate": { "$ref": "#/$defs/rate" },
            "flakyRate": { "$ref": "#/$defs/rate" }
          }
        }
      }
    }
  }
}
